+    prof = store.parse_profile((out / ps.PROFILE_FILE).read_bytes())
+    assert prof["vat_stagger"] == 2 and prof["directors"][0] in (out / ps.STATEMENT_FILE).read_text()
+    assert "SUMUP" in (out / ps.STATEMENT_FILE).read_text()
