from datetime import date

from cma import synth


def test_generation_is_deterministic():
    a, ta = synth.generate("cafe", "stretched", seed=3, end=date(2026, 9, 30))
    b, tb = synth.generate("cafe", "stretched", seed=3, end=date(2026, 9, 30))
    assert a == b
    assert ta.total_revenue == tb.total_revenue


def test_profiles_order_risk():
    _, good = synth.generate("trades", "good", end=date(2026, 9, 30))
    _, poor = synth.generate("trades", "poor", end=date(2026, 9, 30))
    assert good.total_revenue > poor.total_revenue
    assert good.returned_dd_count < poor.returned_dd_count
    assert good.lowest_balance > poor.lowest_balance


def test_balance_walk_is_consistent():
    rows, truth = synth.generate("ecommerce", "stretched", end=date(2026, 9, 30))
    bal = synth.PROFILES["stretched"]["opening_balance"]
    for r in rows:
        bal = round(bal + float(r["amount"]), 2)
        assert abs(bal - float(r["balance"])) < 0.01
    assert len(truth.months) == 12
def _decide(graph, cfg, decision: dict) -> dict:
    """Resume with this decision, and make sure it is the one that was recorded.

    Two people can open the same pending review from a shared --checkpoint-db. If
    someone else decided first, resuming is a no-op that returns *their* decision; say
    so instead of reporting it as ours.
    """
    if not graph.get_state(cfg).interrupts:
        _decided_elsewhere(graph.get_state(cfg).values)
    final = graph.invoke(Command(resume=decision), cfg)
    review = final.get("review")
    if "__interrupt__" not in final and (
        review is None or review.reviewer != (decision.get("reviewer") or "").strip()
        or review.approved != decision.get("approved")
    ):
        _decided_elsewhere(final)
    return final


def _decided_elsewhere(values: dict) -> None:
    r = values.get("review")
    who = f"{r.reviewer} at {r.decided_at:%Y-%m-%d %H:%M UTC}" if r else "someone else"
        "guard": {**s["guard"].model_dump(), "grounded": s["guard"].grounded},
        "redrafts": s.get("redrafts", 0),
        "review": s["review"].model_dump(mode="json") if s.get("review") else None,
        "memo": s.get("memo"),
    }


def build(llm: LLM | None = None, checkpointer=None):
    llm = llm or get_llm()

    def load(s: MemoState) -> MemoState:
        path = Path(s["statement_path"])
        statement = ingest.load_csv(path)
        return {
            "statement": statement,
            "statement_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            "model": f"{llm.name}:{getattr(llm, 'model', '-')}",
            # A run starts clean, even on a thread that has run before.
            "redrafts": 0,
            "guard_feedback": "",
            "review": None,
            "final_memo": None,
        }

    def categorise(s: MemoState) -> MemoState:
        rules = cat.active_ruleset()
        return {"statement": cat.categorise(s["statement"], rules),
                "ruleset": {"id": rules.id, "sha256": rules.sha256}}

    def metrics(s: MemoState) -> MemoState:
