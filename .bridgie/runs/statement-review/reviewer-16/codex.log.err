diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 0000000..f5bec7f
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,4 @@
+# The packaged rule tables are pinned by the SHA-256 of their bytes (FROZEN_SHA256 in
+# src/cma/categorise.py). Keep them LF on every checkout, including Windows with
+# core.autocrlf=true, or the pin refuses an unmodified table.
+src/cma/rules/*.yaml text eol=lf
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 2100f92..1cf96da 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -17,6 +17,8 @@ jobs:
         python: ["3.11", "3.12", "3.13"]
     steps:
       - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0  # tests/test_p7_history.py rebuilds the P7 golden from fd7b64c
       - uses: actions/setup-python@v5
         with:
           python-version: ${{ matrix.python }}
@@ -34,3 +36,7 @@ jobs:
           python -m venv /tmp/wheelcheck
           /tmp/wheelcheck/bin/pip install /tmp/dist/*.whl
           cd /tmp && /tmp/wheelcheck/bin/python -c "from cma import policy; print(policy.load_policy()['name'])"
+          cd /tmp && /tmp/wheelcheck/bin/python -c "import cma; from cma import categorise as c; r = c.load_ruleset('v1'); print(cma.__file__, r.id, r.sha256)"
+          # The installed table must be the source table, byte for byte.
+          want=$(sha256sum "$GITHUB_WORKSPACE/src/cma/rules/v1.yaml" | cut -d' ' -f1)
+          cd /tmp && /tmp/wheelcheck/bin/python -c "import sys; from cma import categorise as c; sys.exit(c.load_ruleset('v1').sha256 != sys.argv[1])" "$want"
diff --git a/README.md b/README.md
index 6c46894..dfe5756 100644
--- a/README.md
+++ b/README.md
