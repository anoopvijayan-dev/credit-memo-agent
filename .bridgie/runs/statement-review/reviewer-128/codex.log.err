  1383	def link_reversals(statement: Statement) -> Statement:
  1384	    """Point each returned DD credit at the most recent unreversed debit it undoes.
  1385	
  1386	    Same amount, same payee, on or before the reversal date. A returned DD with no
  1387	    amount (some banks print a zero-value notice) or no matching debit stays unlinked:
  1388	    it still counts in M7 but changes no sum.
  1389	    """
  1390	    taken: set[str] = set()
  1391	    txns = statement.transactions
  1392	    # Debits by (amount in pence, payee), in statement order: each returned DD looks only
  1393	    # at the debits it could undo, latest first, not back through the whole statement.
  1394	    debits: dict[tuple[int, str], list[int]] = {}
  1395	    for j, o in enumerate(txns):
  1396	        if o.amount < 0 and o.category not in (Category.RETURNED_DD, None):
  1397	            debits.setdefault((round(-o.amount * 100), counterparty(o.description)), []).append(j)
  1398	    for i, r in enumerate(txns):
