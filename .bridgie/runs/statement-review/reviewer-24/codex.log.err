rules:
  # --- stage 1, line type (protected) -------------------------------------------------
  - id: returned_dd
    pattern: '^UNPAID DD\b'
    direction: any
    category: returned_dd
    protected: true
  # An explicit move to or from the applicant's own pot, space or savings, either way,
  # whatever the pot or account is called: "TFR TO POT RENT", "TO POT HMRC VAT", "TFR FROM
  # SAVINGS CAPITAL RESERVE" and "FROM POT IWOCA" are own-account transfers.
  - id: own_pots_savings
    names:
      - POT TRANSFER
      - TO POT
      - FROM POT
      - VAT POT
      - TAX POT
      - TO SPACE
      - FROM SPACE
      - SAVINGS TRANSFER
      - SAVINGS TFR
      - TFR SAVINGS
      - TRANSFER SAVINGS
      - TO SAVINGS
      - FROM SAVINGS
      - TO SAVER
      - FROM SAVER
      - TO BUSINESS SAVER
      - FROM BUSINESS SAVER
      - TO INSTANT ACCESS
      - FROM INSTANT ACCESS
    direction: any
    category: own_account_transfer
    protected: true
  - id: hmrc_vat
    pattern: 'HMRC VAT'
    direction: out
    category: hmrc_vat
    protected: true
  - id: hmrc_paye
    pattern: 'HMRC PAYE'
    direction: out
    category: hmrc_paye
    protected: true
  # HMRC paying money back (VAT repayment, tax refund, R&D credit). Before the refund
  # wording: an HMRC refund is an HMRC repayment, its own bucket.
  - id: hmrc_repayment
    names: [HMRC, HM REVENUE]
    direction: in
    category: hmrc_repayment
    protected: true
  # Money given back: a refund, reversal, returned payment or chargeback, from anyone,
  # a named lender or a payer called CAPITAL or DIRECTOR included. Money out with the same
  # wording is left to the name lists: a payment to a lender stays debt service.
  - id: refunds
    names: [REFUND, REFUNDED, REVERSAL, REVERSED, RETURNED PAYMENT, PAYMENT RETURNED, CHARGEBACK]
    direction: in
    category: refund_in
    protected: true
  # --- stage 2, name lists (protected) ------------------------------------------------
  # UK business lenders and merchant cash advance providers, named. Before the director
  # and capital wording, so "STRIPE CAPITAL" and "BOOST CAPITAL" are lenders.
  - id: lender_repayment
    names: &lenders
      - FUNDING CIRCLE
      - IWOCA
      - YOULEND
  - id: lender_drawdown
    names: *lenders
    direction: in
    category: loan_drawdown
    protected: true
  - id: loan_repayment
    pattern: '\bLOAN\b|FINANCE\b'
    direction: out
    category: loan_repayment
    protected: true
  # Money from a director, shareholder or owner, or capital introduced. Before the
  # generic loan wording, so a director's loan to the business is director funding.
  - id: director_funding
    names: [DIRECTOR, DIRECTORS, OWNER, CAPITAL, SHAREHOLDER, SHAREHOLDERS]
    direction: in
    category: director_funding
    protected: true
  - id: loan_drawdown
    pattern: '\bLOAN\b|FINANCE\b'
    direction: in
    category: loan_drawdown
    protected: true
  - id: owner_drawings
    pattern: 'OWNER DRAWINGS|DIRECTOR DRAWINGS|DIVIDEND'
    direction: out
    category: owner_drawings
    protected: true
  # --- not protected: a profile name or a firm rule is tried before these ---------------
  # Savings wording with no move ("FPS CREDIT SAVINGS ACCOUNT"): the applicant's own
  # savings, after the director wording, so "DIRECTOR SAVINGS" stays director funding.
  - id: savings_wording
    names: [SAVINGS, SAVER, BUSINESS SAVER, INSTANT ACCESS]
    direction: any
    category: own_account_transfer
  - id: bank_fees
    pattern: 'UNPAID ITEM FEE|ACCOUNT FEES|BANK CHARGES'
    direction: out
    category: bank_fees
  - id: payroll
    pattern: 'PAYROLL|SALARIES'
    direction: out
    category: payroll
  - id: rent
    pattern: '\bRENT\b'
    direction: out
    category: rent
  # Explained, but not trading: grants, insurance claims, interest, cashback.
  - id: explained_non_trading
    names: [INTEREST, GRANT, INSURANCE CLAIM, INSURANCE PAYOUT, INSURANCE SETTLEMENT, CASHBACK, COMPENSATION]
    direction: in
    category: other_explained_in
  # Cash paid in at a counter or a machine, at a bank, a Post Office or a PayPoint. A
  # cheque is not cash. Post Office and PayPoint count only with cash, deposit or counter
  # wording: both also pay by transfer, and their name alone is not cash. An electronic
  # payment (Faster Payment, including the FP and FPI codes, BACS, CHAPS, a bank giro
  # credit (BGC), a transfer, a standing order, a direct credit) is never cash, wherever in the line the rail is named and whatever its payer-written
  # reference says; it stays unexplained for a person.
  - id: cash_paid_in
    names:
      - CASH PAID IN
      - CASH DEPOSIT
      - CASH DEP
      - CASH CREDIT
      - CASH IN BRANCH
      - PAID IN AT
      - COUNTER CREDIT
      - COUNTER DEPOSIT
      - DEPOSIT MACHINE
      - ATM DEPOSIT
      - CDM DEPOSIT
      - POST OFFICE CASH
      - POST OFFICE DEPOSIT
      - POST OFFICE COUNTER CREDIT
      - POST OFFICE COUNTER DEPOSIT
      - PAYPOINT CASH
      - PAYPOINT DEPOSIT
    unless: '(?<![A-Z0-9])(?:CHEQUES?|CHQ|FPS|FPI|FP|BGC|FASTER\s+PAYMENTS?|BACS|CHAPS|TFR|TRANSFER|SO|STO|STANDING\s+ORDER|DIRECT\s+CREDIT)(?![A-Z0-9])'
    direction: in
    category: cash_deposit
  # Trading receipts. The first three patterns are v1's synthetic acquirer wording.
  - id: card_settlement
    pattern: 'ACQUIRER SETTLEMENT|PAYGATE PAYOUT|CARD SETTLEMENT'
    direction: in
    category: revenue_card_settlement
  - id: card_acquirers
  - id: invoice_transfer
    pattern: '\bINV(?:OICE)?\s*[-#:]?\s*\d+'
    direction: in
    category: revenue_transfer
  # Cash taken out. The category is what an unmatched debit gets anyway (supplier); the
  # rule is here so the line records cash_withdrawal as its rule, which the cash round-trip
  # indicator reads. Last, so it never takes a debit from another rule.
  - id: cash_withdrawal
    names:
      - CASH WITHDRAWAL
      - CASH WDL
      - CASH WITHDRAWN
      - ATM
      - CASH MACHINE
      - CASHPOINT
      - POST OFFICE CASH
      - COUNTER WITHDRAWAL
    direction: out
    category: supplier
