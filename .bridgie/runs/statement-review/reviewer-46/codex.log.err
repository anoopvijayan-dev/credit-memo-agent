diff --git a/README.md b/README.md
index ffb31b7..5352308 100644
--- a/README.md
+++ b/README.md
@@ -51,6 +51,10 @@ cma resume case-7 --checkpoint-db private/reviews.sqlite
 # (git-ignored, as are *.csv, memo files, evidence files and databases anywhere).
 cma import monzo "private/Monzo Data Export.csv" --opening-balance 123.45 --out private/mine.csv
 
+# Check a case's hash-chained log (log.jsonl) against its head file. Exit 3 names the
+# first entry that was changed, removed, reordered or left half written.
+cma case check private/cma/cases/<id>
+
 # Use a real model instead of the offline one.
 export ANTHROPIC_API_KEY=...   # or OPENAI_API_KEY
 cma run examples/cafe_stretched.csv --llm anthropic
diff --git a/src/cma/case.py b/src/cma/case.py
new file mode 100644
index 0000000..e0409a2
--- /dev/null
+++ b/src/cma/case.py
@@ -0,0 +1,853 @@
+"""The case log: an append-only, hash-chained record of everything done to a case (R42, R43).
+
+One JSON object per line, written in a single write that ends with its newline:
+
+    {"seq": 3, "prev": "<hash of entry 2>", "at": "2026-11-16T10:04:01.123456Z",
+     "event": "override", "data": {...}, "hash": "<sha256 of the other five fields>"}
+
+The first entry's `prev` is GENESIS. Each entry carries the hash of the entry before it
+and its own hash, so a changed, removed, inserted or reordered entry anywhere before the
+head breaks the chain on the next load, and `verify` names the first entry that does not
+hold. A line is read strictly: it must be exactly the canonical bytes the writer
+produces, so a repeated member, a number no float can hold, or reformatting is named as
+a bad entry rather than reinterpreted or raised.
+
+The chain alone cannot see a history rewritten from some entry onwards with every hash
+recomputed, nor the head entry removed. So each append, after its line is on disk, also
+replaces a head file beside the log (`log.jsonl.head`: {"count": n, "hash": h,
+"hashes": [the hash of every entry, in order]}), and every load compares the chain with
+it entry by entry: the first entry whose hash is not the one recorded is named as the
+first bad entry, even when every link after it was recomputed, and a chain that ends
+before or after the recorded count is broken there. Rewriting the log and the head file
+together is not detectable from these files; a sign-off or pack pins the head it saw.
+
+An append can stop half way. A last line without its newline, or a complete last line
+the head file does not yet record (power lost between the two writes), is a torn entry:
+reported as incomplete, not as tampering, and in the way of appends and sign-off until
+someone confirms dropping it (`drop_torn_entry`), which is itself logged. A reader that
+does not hold the lock may catch a writer between the two writes, so it looks again
+briefly and then takes the lock to read once more. If another writer still holds the
+lock, that writer's append is in progress: the reader reports the log as recorded (the
+intact entries, `in_progress` set) and never asks anyone to drop a live append. Only a
+reader that holds the lock, or that could take it, reports a torn entry.
+
+One writer at a time: every append takes an exclusive, non-blocking lock on a sibling
+lock file and re-reads the log under it, and the caller states the position it last
+saw. A second tab or terminal that read an older position gets LogConflict and reloads;
+one that tries while another holds the lock gets CaseLocked, including another thread
+using the same CaseLog object. The operating system drops the lock when its holder
+dies, so a crash never leaves the case locked. Forking a process while it holds the lock
+is not supported (the tool never does): a child is refused through an inherited CaseLog,
+and leaving an inherited block releases nothing. Case folders must be on a local disk: on a network
+share the operating system may emulate the lock per process, which does not separate
+two CaseLog objects in one process.
+
+Messages name entries by number only and never quote their content: data holds case
+details, and errors end up in terminals and logs.
+"""
+
+from __future__ import annotations
+
+import errno
+import hashlib
+import json
+import os
+import threading
+import time
+from collections.abc import Iterator
+from contextlib import contextmanager, suppress
+from dataclasses import asdict, dataclass, field
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+
+GENESIS = "0" * 64
+HASHED_FIELDS = ("seq", "prev", "at", "event", "data")
+ENTRY_FIELDS = frozenset((*HASHED_FIELDS, "hash"))
+TORN_DROPPED = "torn_entry_dropped"
+HEAD_FIELDS = frozenset(("count", "hash", "hashes"))
+READ_RETRIES, READ_PAUSE = 5, 0.02  # seconds; a writer paused for longer is handled in verify
+WRITER_WAIT = 0.2  # seconds a writer waits for another writer's hold to end before refusing
+READER_WAIT = 10.0  # seconds a writer waits while only readers hold the case (R42: a reader is no writer)
+_UNREADABLE = object()
+
+
+class CaseLogError(Exception):
+    """Base for case-log refusals."""
+
+
+class CaseLogBroken(CaseLogError):
+    """The chain does not hold, or the last entry is incomplete. Nothing may be appended
+    and no sign-off accepted until it is resolved."""
+
+    def __init__(self, path: Path, first_bad: int, reason: str, torn: bool):
+        self.first_bad = first_bad
+        self.torn = torn
+        self.reason = reason
+        super().__init__(f"{path}: case log entry {first_bad} {reason}")
+
+
+class LogConflict(CaseLogError):
+    """The writer's view of the log is stale: someone appended since it last read."""
+
+    def __init__(self, expected: int, actual: int):
+        self.expected = expected
+        self.actual = actual
+        super().__init__(
+            f"case log is at entry {actual}, not {expected}: it changed since you loaded it; reload"
+        )
+
+
+class CaseLocked(CaseLogError):
+    """Another writer holds the case."""
+
+
+@dataclass(frozen=True)
+class Entry:
+    seq: int
+    prev: str
+    at: str
+    event: str
+    data: dict[str, Any]
+    hash: str
+
+
+@dataclass(frozen=True)
+class Head:
+    """Where the intact log ends: `position` entries, the last with hash `hash`."""
+
+    position: int
+    hash: str
+
+
+@dataclass(frozen=True)
+class LogCheck:
+    head: Head  # the end of the intact prefix
+    entries: list[Entry] = field(repr=False)
+    first_bad: int | None = None  # 1-based entry number; None when the log is intact
+    reason: str = ""
+    torn: bool = False
+    intact_bytes: int = field(default=0, repr=False)
+    in_progress: bool = False  # the case is held: `head` is the log as recorded, the rest unchecked
+    recorded: int | None = field(default=None, repr=False)  # entries the head file records
+    checked: bool = True  # False: the case is held and no steady read was had; nothing is claimed
+
+    def as_recorded(self) -> LogCheck:
+        """The log as the head file records it, for a failure that lies wholly after the
+        recorded entries (which were all walked and matched): what a reader reports while
+        the case is held. What follows them is being saved, not checked (R43)."""
+        k = self.recorded or 0
+        kept = self.entries[:k]
+        return LogCheck(Head(k, kept[-1].hash if kept else GENESIS), kept,
+                        intact_bytes=sum(len(_line(e)) for e in kept), in_progress=True, recorded=k)
+
+    @property
+    def past_recorded(self) -> bool:
+        """The first failure is after every entry the head file records."""
+        return self.recorded is not None and self.first_bad is not None and self.first_bad > self.recorded
+
+    @property
+    def ok(self) -> bool:
+        """No entry is bad. While the case is held (`in_progress`) this covers only the
+        recorded entries, and with `checked` False it covers nothing."""
+        return self.first_bad is None and self.checked
+
+
+def _canonical(obj: Any) -> bytes:
+    # allow_nan=False: NaN and Infinity are not JSON, and another reader of the log
+    # (verify, a future hosted version) must be able to recompute every hash.
+    return json.dumps(
+        obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
+    ).encode("utf-8")
+
+
+def _line(entry: Entry) -> bytes:
+    """The exact line the writer produced for an entry that was read back intact."""
+    return _canonical(asdict(entry)) + b"\n"
+
+
+def entry_hash(entry: dict[str, Any]) -> str:
+    """sha256 over the canonical JSON of the hashed fields (everything but `hash`)."""
+    return hashlib.sha256(_canonical({k: entry.get(k) for k in HASHED_FIELDS})).hexdigest()
+
+
+def _utc_now() -> str:
+    return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
+
+
+def _unique_members(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    obj = dict(pairs)
+    if len(obj) != len(pairs):
+        raise ValueError("duplicate member")
+    return obj
+
+
+def _no_constant(token: str) -> Any:
+    raise ValueError(f"{token} is not JSON")
+
+
+def _decode(line: bytes) -> Any:
+    """The entry a line holds, read strictly: no duplicate members, no NaN or Infinity,
+    and the line must be exactly the canonical bytes the writer produces. Anything a
+    lenient decoder would quietly reinterpret (a repeated member, 1e999 read as
+    infinity, other spacing or key order) is therefore not the entry that was hashed."""
+    obj = json.loads(line.decode("utf-8"), object_pairs_hook=_unique_members,
+                     parse_constant=_no_constant)
+    if _canonical(obj) != line:
+        raise ValueError("not in canonical form")
+    return obj
+
+
+def _parse(line: bytes, n: int, prev: str) -> tuple[Entry | None, str]:
+    """Check one complete line as entry number `n` following hash `prev`."""
+    try:
+        obj = _decode(line)
+    except (UnicodeDecodeError, ValueError, TypeError, RecursionError):
+        return None, "is not a readable entry: it is not exactly what the log writes"
+    if not isinstance(obj, dict) or set(obj) != ENTRY_FIELDS:
+        return None, "has missing or extra fields"
+    seq, hsh = obj["seq"], obj["hash"]
+    if not isinstance(seq, int) or isinstance(seq, bool) or not isinstance(hsh, str) \
+            or not isinstance(obj["prev"], str) or not isinstance(obj["at"], str) \
+            or not isinstance(obj["event"], str) or not isinstance(obj["data"], dict):
+        return None, "has a field of the wrong type"
+    if entry_hash(obj) != hsh:
+        return None, "was changed: its hash does not match its content"
+    if seq != n:
+        return None, f"is out of place: it says it is entry {seq}; an entry is missing, added or reordered"
+    if obj["prev"] != prev:
+        return None, f"does not follow entry {n - 1}: the hash it carries for it does not match"
+    return Entry(**obj), ""
+
+
+def _is_hash(value: Any) -> bool:
+    return isinstance(value, str) and len(value) == 64 and all(c in "0123456789abcdef" for c in value)
+
+
+def _read_head(path: Path) -> list[str] | object | None:
+    """The hash of every entry the head file records, in order; None if there is no head
+    file; _UNREADABLE if it cannot be read or is not exactly what the writer produces."""
+    try:
+        raw = path.read_bytes()
+    except FileNotFoundError:
+        return None
+    except OSError:  # a directory in its place, no permission: it cannot vouch for the log
+        return _UNREADABLE
+    try:
+        if not raw.endswith(b"\n"):
+            raise ValueError("no newline")
+        obj = _decode(raw[:-1])
+    except (UnicodeDecodeError, ValueError, TypeError, RecursionError):
+        return _UNREADABLE
+    if not isinstance(obj, dict) or set(obj) != HEAD_FIELDS:
+        return _UNREADABLE
+    count, hsh, hashes = obj["count"], obj["hash"], obj["hashes"]
+    if not isinstance(count, int) or isinstance(count, bool) or not isinstance(hashes, list) \
+            or len(hashes) != count or not all(_is_hash(h) for h in hashes) \
+            or hsh != (hashes[-1] if hashes else GENESIS):
+        return _UNREADABLE
+    return hashes
+
+
+def _head_bytes(hashes: list[str]) -> bytes:
+    return _canonical({"count": len(hashes), "hash": hashes[-1] if hashes else GENESIS,
+                       "hashes": hashes}) + b"\n"
+
+
+def _check(raw: bytes | None, recorded: list[str] | object | None) -> LogCheck:
+    """Walk the chain in `raw` to the first entry that does not hold, compare every entry
+    walked with the head file's record, and name the earlier of the two failures."""
+    if raw is None:
+        return LogCheck(Head(0, GENESIS), [], 1, "cannot be read: the log file cannot be opened", False, 0)
+    pieces = raw.split(b"\n")
+    complete, tail = pieces[:-1], pieces[-1]  # tail is non-empty only if torn
+    entries: list[Entry] = []
+    ends = [0]  # ends[k]: bytes up to and including entry k's newline
+    prev = GENESIS
+    chain_bad, chain_reason = None, ""
+    for n, line in enumerate(complete, start=1):
+        entry, reason = _parse(line, n, prev)
+        if entry is None:
+            chain_bad, chain_reason = n, reason
+            break
+        entries.append(entry)
+        prev = entry.hash
+        ends.append(ends[-1] + len(line) + 1)
+
+    if recorded is None and raw:
+        # Every writer creates the head file before the first line, so a log with no head
+        # beside it was damaged; nothing in it is a torn write to drop.
+        return LogCheck(Head(0, GENESIS), [], 1, "cannot be trusted: the head file beside the "
+                        "log is missing", False, 0)
+    hashes: list[str] = recorded if isinstance(recorded, list) else []  # none yet: empty
+    n, count = len(entries), len(hashes)
+
+    def at(k: int) -> Head:
+        return Head(k, entries[k - 1].hash if k else GENESIS)
+
+    def failed(first_bad: int, reason: str, torn: bool = False) -> LogCheck:
+        return LogCheck(at(first_bad - 1), entries[: first_bad - 1], first_bad, reason, torn,
+                        ends[first_bad - 1], recorded=None if recorded is _UNREADABLE else count)
+
+    if recorded is _UNREADABLE:
+        return failed(1, "cannot be trusted: the head file beside the log is unreadable")
+    same = 0
+    while same < min(n, count) and entries[same].hash == hashes[same]:
+        same += 1
+    if same < min(n, count):
+        return failed(same + 1, "does not match the head file: the log was rewritten from "
+                                "this entry on")
+    if chain_bad is not None:
+        return failed(chain_bad, chain_reason)
+    if n == count and not tail:
+        return LogCheck(at(n), entries, intact_bytes=ends[-1], recorded=count)
+    if n == count:
+        return failed(n + 1, "is incomplete: the write did not finish (the process or power "
+                             "stopped); confirm dropping it before anything else is recorded "
+                             "or signed off", torn=True)
+    if n == count + 1 and not tail:
+        return failed(n, "is incomplete: it was written but the head file was not updated (the "
+                         "process or power stopped); confirm dropping it before anything else "
+                         "is recorded or signed off", torn=True)
+    if recorded is None:  # entries on disk, and no torn first append explains them
+        return failed(1, "cannot be trusted: the head file beside the log is missing")
+    if n < count and tail:
+        # The head file records this entry, and only part of its line is there: damage to a
+        # recorded entry, named incomplete, and not one to drop like a crash's torn write.
+        return failed(n + 1, f"is incomplete: the head file records {count} entries and this "
+                             "entry's line is cut short")
+    if n < count:
+        return failed(n + 1, f"is missing: the head file records {count} entries and the log "
+                             f"holds {n}")
+    return failed(count + 1, f"was added after the head the head file records (entry {count})")
+
+
+def _unchecked(reason: str, *, in_progress: bool) -> LogCheck:
+    """No steady read was had: nothing is claimed about any entry."""
+    return LogCheck(Head(0, GENESIS), [], reason=reason, in_progress=in_progress, checked=False)
+
+
+def _refuse_unchecked(path: Path, check: LogCheck) -> None:
+    if not check.checked:
+        raise CaseLocked(f"{path}: the log {check.reason.split(': ', 1)[-1]}; nothing could be "
+                         "checked yet, try again")
+
+
+def _holder_id() -> tuple[int, int]:
+    """Who holds a writer lock: the process and the thread. With the process in it, a
+    forked child never passes for its parent (forking while holding is not supported; a
+    child is refused rather than let in)."""
+    return os.getpid(), threading.get_ident()
+
+
+# The writer locks this process holds, by the lock file's identity (device and inode, so
+# two spellings of one path, a symlink included, are the same file), with the (process,
+# thread) holding each. A second CaseLog on the same file in the holding thread reads as
+# the holder: its own fallback lock would be refused by its own thread, which is not
+# another writer.
+_HELD: dict[tuple[int, int], tuple[int, int]] = {}
+_HELD_GUARD = threading.RLock()  # reentrant, like _state: a cleanup run by the GC cannot deadlock
+
+
+def _file_id(st: os.stat_result) -> tuple[int, int]:
+    return st.st_dev, st.st_ino
+
+
+class CaseLog:
+    def __init__(self, path: Path | str):
+        self.path = Path(path)
+        self.lock_path = self.path.with_name(self.path.name + ".lock")
+        self.head_path = self.path.with_name(self.path.name + ".head")
+        # Guards the fields below, never held long. Reentrant, so a writer block's
+        # cleanup run by the garbage collector or a signal handler inside one of these
+        # short regions, on the same thread, cannot deadlock it.
+        self._state = threading.RLock()
+        self._lock_fd: int | None = None
+        self._owner: tuple[int, int] | None = None  # (process id, thread ident) of the holder
+        self._lock_depth = 0
+        self._lock_id: tuple[int, int] | None = None  # the lock file's identity while held
+        self._pid = os.getpid()  # a CaseLog belongs to the process that opened it (R42)
+
+    # --- reading -----------------------------------------------------------------------
+
+    def verify(self) -> LogCheck:
+        """Walk the chain from the start, stop at the first entry that does not hold, and
+        compare every entry with the head file."""
+        me = _holder_id()
+        with self._state:
+            holder = self._owner == me
+        if not holder:
+            try:
+                lock_id = _file_id(os.stat(self.lock_path))
+            except OSError:  # no lock file: nobody in this process holds it
+                lock_id = None
+            if lock_id is not None:
+                with _HELD_GUARD:
+                    holder = _HELD.get(lock_id) == me
+        if holder:  # nothing else can write: one read is the truth
+            return _check(self._read_log(), _read_head(self.head_path))
+        # Take the lock first: if the case is free, one read under the lock is the truth.
+        # A probe by another reader holds it for a moment, so it is tried a few times
+        # before the case counts as held. An object a forked child inherited still names
+        # its parent as holder whether or not the parent has let go, so the lock is tested
+        # through a fresh handle.
+        for attempt in range(READ_RETRIES):
+            if attempt:
+                time.sleep(READ_PAUSE)
+            try:
+                with self._reading():
+                    return _check(self._read_log(), _read_head(self.head_path))
+            except CaseLocked:
+                held = self._held()
+                # "Being saved" stands only if the case is still held after the read: a
+                # holder that let go meanwhile may have left an incomplete entry, which a
+                # read of the free case must name (R43). A fault at or before the recorded
+                # entries is real either way.
+                if held.first_bad is not None or self._still_held():
+                    return held
+                continue
+            except FileNotFoundError:
+                # No lock file: no writer has ever started on this case (each creates it
+                # first), and a check writes nothing. A steady read is the truth, unless a
+                # writer started meanwhile: then probe again.
+                check = self._steady()
+                if check is not None and not self.lock_path.exists():
+                    return check
+                continue
+            except OSError:
+                return self._untested()
+        return self._held()
+
+    @contextmanager
+    def _reading(self) -> Iterator[None]:
+        """Hold the case's lock shared for one read, through a fresh descriptor (so an
+        object a forked child inherited tests the lock as it is now). Readers never
+        exclude each other; a writer holding the case refuses it with CaseLocked, and a
+        writer waits for readers (R42: a reader is not a case-log writer). Where the
+        platform has no shared lock (Windows) the hold is exclusive and brief. A missing
+        lock file raises FileNotFoundError and nothing is created."""
+        fd = os.open(self.lock_path, _PROBE_FLAGS)
+        try:
+            try:
+                _lock(fd, shared=True)
+            except OSError as e:
+                if e.errno in _CONTENDED:
+                    raise CaseLocked(f"{self.path}: another window or command is writing to this case") from e
+                raise
+            try:
+                yield
+            finally:
+                with suppress(OSError):
+                    _unlock(fd)
+        finally:
+            os.close(fd)
+
+    def _still_held(self) -> bool:
+        """Another holds the case right now (a lock that cannot be tested counts as not)."""
+        try:
+            with self._reading():
+                return False
+        except CaseLocked:
+            return True
+        except OSError:
+            return False
+
+    def _only_readers_hold(self) -> bool:
+        """The lock is held, and only shared (by readers), so a writer should wait."""
+        if not _SHARED_LOCKS:
+            return False
+        try:
+            with self._reading():
+                return True
+        except (CaseLocked, OSError):
+            return False
+
+    def _steady(self) -> LogCheck | None:
+        """A read across which the head file did not change, or None if every read moved:
+        it holds every entry the head records, each walked and matched."""
+        for attempt in range(READ_RETRIES):
+            if attempt:
+                time.sleep(READ_PAUSE)
+            check, still = self._look()
+            if still:
+                return check
+        return None
+
+    def _held(self) -> LogCheck:
+        """Someone else holds the case (R43): judge only the entries the log records as
+        complete, from a steady read. A change, removal or reordering at or before them is
+        broken; anything after them is being saved, and the log is never called intact.
+        With no steady read, nothing is claimed."""
+        check = self._steady()
+        if check is None:
+            return _unchecked("being saved: the log changed during every read", in_progress=True)
+        if check.first_bad is not None and not check.past_recorded:
+            return check
+        return check.as_recorded()
+
+    def _untested(self) -> LogCheck:
+        """The lock cannot be taken or tested: no holder is known, so a steady read is
+        believed as it stands (an incomplete entry reported as incomplete). With no
+        steady read, nothing is claimed, and no other window is blamed."""
+        check = self._steady()
+        if check is not None:
+            return check
+        return _unchecked("could not be checked: the case lock cannot be taken and the log "
+                          "changed during every read", in_progress=False)
+
+    def _look(self) -> tuple[LogCheck, bool]:
+        """One read judged by the head read before it, and whether the head held still."""
+        before = _read_head(self.head_path)
+        check = _check(self._read_log(), before)
+        return check, _read_head(self.head_path) == before
+
+    def _read_log(self) -> bytes | None:
+        try:
+            return self.path.read_bytes()
+        except FileNotFoundError:
+            return b""
+        except OSError:  # a directory in its place, no permission
+            return None
+
+    def require_intact(self) -> Head:
+        """The head of a log checked whole, or CaseLogBroken naming the first bad entry.
+        Sign-off (T27) must call it while holding the case (writer()) and refuse on the
+        exception (R43). Called while another holds the case, it refuses with CaseLocked:
+        only the recorded entries could be checked, so the log is not known whole."""
+        check = self.verify()
+        _refuse_unchecked(self.path, check)
+        if not check.ok:
+            raise CaseLogBroken(self.path, check.first_bad, check.reason, check.torn)
+        if check.in_progress:
+            raise CaseLocked(f"{self.path}: another window or command is saving to this case; "
+                             "only its recorded entries could be checked, try again")
+        return check.head
+
+    def entries(self) -> list[Entry]:
+        """Every entry of an intact log; CaseLogBroken otherwise. While another holds the
+        case, the recorded entries; CaseLocked if no steady read was had."""
+        check = self.verify()
+        _refuse_unchecked(self.path, check)
+        if not check.ok:
+            raise CaseLogBroken(self.path, check.first_bad, check.reason, check.torn)
+        return check.entries
+
+    # --- writing -----------------------------------------------------------------------
+
+    @contextmanager
+    def writer(self, *, wait: float | None = None, create: bool = True) -> Iterator[CaseLog]:
+        """Hold the case's single-writer lock; refuses if another writer still holds it after
+        `wait` seconds (WRITER_WAIT by default). While only readers hold the case (a check
+        takes the lock shared), it waits for them, up to READER_WAIT.
+
+        The thread that holds it may nest (a sign-off holds the lock across its checks and
+        its append). Any other writer is refused, whether it is another process, another
+        CaseLog on the same file, or another thread using this same instance: the lock
+        belongs to a thread, not to the object. Forking a process while it holds the lock is
+        not supported: a child writing through an inherited CaseLog is refused, and leaving
+        a block it inherited releases nothing."""
+        if self._pid != os.getpid():
+            raise CaseLocked(f"{self.path}: this case log was opened by another process; open "
+                             "the case again in this one")
+        me = _holder_id()
+        entered = False
+        start = time.monotonic()
+        deadline = start + (WRITER_WAIT if wait is None else wait)
+        try:
+            while True:
+                try:
+                    with self._state:
+                        entered = self._enter(me, create)
+                    break
+                except CaseLocked:
+                    # Another writer: wait briefly, then refuse (R42). Only readers: they
+                    # are no writer and finish their read, so wait for them (READER_WAIT).
+                    limit = start + READER_WAIT if self._only_readers_hold() else deadline
+                    if time.monotonic() >= limit:
+                        raise
+                    time.sleep(READ_PAUSE)
+            yield self
+        finally:
+            if entered:
+                with self._state:
+                    # Released by the process that holds it, whichever thread runs this:
+                    # an abandoned block may be finalised by the garbage collector on
+                    # another thread. A forked child leaving a block it inherited is
+                    # another process and never unlocks its parent's lock.
+                    if self._owner is not None and self._owner[0] == os.getpid():
+                        self._release_one_level()
+
+    def _enter(self, me: tuple[int, int], create: bool = True) -> bool:
+        """Take or join the lock for `me` (call under _state); True once it is held. With
+        `create` False a missing lock file raises FileNotFoundError and nothing is made."""
+        if self._owner == me:
+            self._lock_depth += 1
+        elif self._owner is not None:
+            raise CaseLocked(f"{self.path}: another window or command is writing to this case")
+        else:
+            if create:
+                self.path.parent.mkdir(parents=True, exist_ok=True)
+            fd = os.open(self.lock_path, os.O_RDWR | (os.O_CREAT if create else 0), 0o600)
+            locked = False
+            try:
+                _lock(fd)
+                locked = True
+                lock_id = _file_id(os.fstat(fd))
+                self._lock_fd, self._owner, self._lock_depth, self._lock_id = fd, me, 1, lock_id
+                with _HELD_GUARD:
+                    _HELD[lock_id] = me
+            except BaseException as e:
+                # Whatever interrupts this (a lock error, or KeyboardInterrupt between
+                # two steps) leaves no lock behind: once the descriptor is recorded
+                # the lock is released, before that the descriptor is closed.
+                if self._lock_fd == fd:
+                    self._lock_depth = 1
+                    self._owner = me
+                    self._release_one_level()
+                else:
+                    os.close(fd)
+                # Only contention means another writer holds the lock. Any other lock
+                # error (no locks available, an I/O error) is not evidence of a writer:
+                # it propagates, so a reader falls back to the plain read and a torn
+                # entry is reported, never excused as some writer's append.
+                if not locked and isinstance(e, OSError) and e.errno in _CONTENDED:
+                    raise CaseLocked(f"{self.path}: another window or command is writing to this case") from e
+                raise
+        return True
+
+    def _release_one_level(self) -> None:
+        """Leave one level of this process's writer lock (call under _state)."""
+        self._lock_depth -= 1
+        if self._lock_depth == 0:
+            fd, self._lock_fd, self._owner = self._lock_fd, None, None
+            lock_id, self._lock_id = self._lock_id, None
+            if lock_id is not None:
+                with _HELD_GUARD:
+                    _HELD.pop(lock_id, None)
+            if fd is not None:
+                # Closing the descriptor releases the lock on every platform, so it runs
+                # even when the explicit unlock fails; skipping it would leave the lock
+                # held and block later appends until the process exits.
+                try:
+                    _unlock(fd)
+                except OSError:
+                    pass
+                finally:
+                    os.close(fd)
+
+    def append(self, event: str, data: dict[str, Any], *, expected: int) -> Entry:
+        """Append one entry if the log is intact and still at `expected` entries."""
+        if not isinstance(event, str) or not event.strip():
+            raise ValueError("event must be a non-empty string")
+        if not isinstance(data, dict):
+            raise ValueError("data must be a mapping")
+        try:
+            # Plain JSON only: json.dumps would quietly turn a tuple into a list and a 1,
+            # True or None key into a string, so the Entry returned here would differ from
+            # the one every later reader sees.
+            blob = _canonical(data)
+            same = json.loads(blob) == data
+        except (TypeError, ValueError, RecursionError) as e:
+            raise ValueError(f"data is not plain JSON: {e}") from e
+        if not same:
+            raise ValueError("data is not plain JSON: it would not read back unchanged "
+                             "(use lists, not tuples, and string keys)")
+        # From here on only the copy read back from those bytes is used: the caller's dict
+        # may be shared, and a change to it between hashing and writing must not reach the log.
+        snapshot = json.loads(blob)
+        with self.writer():
+            check = self.verify()
+            if not check.ok:
+                raise CaseLogBroken(self.path, check.first_bad, check.reason, check.torn)
+            if check.head.position != expected:
+                raise LogConflict(expected, check.head.position)
+            return self._write(event, snapshot, check)
+
+    def drop_torn_entry(self, *, expected: int, by: str) -> Entry:
+        """Cut an incomplete last entry off and record who confirmed it. `expected` is the
+        intact position the person was shown. Refused if the last entry is not torn, or
+        if the chain is broken before it (that is tampering, not a torn write)."""
+        if not isinstance(by, str) or not by.strip():
+            raise ValueError("a name is required to drop a torn entry")
+        with self.writer():
+            check = self.verify()
+            if not check.torn:
+                if check.ok:
+                    raise CaseLogBroken(self.path, check.head.position + 1, "does not exist: nothing is torn", False)
+                raise CaseLogBroken(self.path, check.first_bad, check.reason, False)
+            if check.head.position != expected:
+                raise LogConflict(expected, check.head.position)
+            return self._replace_torn(check, by.strip())
+
+    def _replace_torn(self, check: LogCheck, by: str) -> Entry:
+        # Write the intact prefix plus the drop entry to a temporary file and rename it over
+        # the log, so a crash leaves either the torn log or the repaired one, never a
+        # truncated log with no record of who dropped the entry. A crash after the rename
+        # and before the head file is replaced leaves the drop entry itself unrecorded: the
+        # log loads as torn at the same entry, and dropping it again repairs it.
+        intact = self.path.read_bytes()[: check.intact_bytes]
+        entry, line = self._encode(TORN_DROPPED, {"seq": check.first_bad, "by": by}, check.head)
+        tmp = self.path.with_name(self.path.name + ".tmp")
+        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        try:
+            _write_all(fd, intact + line)
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        try:
+            _replace(tmp, self.path)
+        except OSError:
+            tmp.unlink(missing_ok=True)
+            raise
+        _fsync_dir(self.path.parent)
+        self._write_head([*(e.hash for e in check.entries), entry.hash])
+        return entry
+
+    @staticmethod
+    def _encode(event: str, data: dict[str, Any], head: Head) -> tuple[Entry, bytes]:
+        """The entry and its line. The line is checked as every reader will check it, so
+        the hash is over exactly the bytes written, and the Entry returned is the one read
+        back from them."""
+        body = {"seq": head.position + 1, "prev": head.hash, "at": _utc_now(), "event": event, "data": data}
+        line = _canonical({**body, "hash": entry_hash(body)})
+        entry, reason = _parse(line, head.position + 1, head.hash)
+        if entry is None:  # pragma: no cover - only if the encoder and the reader disagree
+            raise CaseLogError(f"{reason}; nothing was written")
+        return entry, line + b"\n"
+
+    def _write_head(self, hashes: list[str]) -> None:
+        """Replace the head file in one rename, after the last entry it names is on disk."""
+        tmp = self.head_path.with_name(self.head_path.name + ".tmp")
+        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        try:
+            _write_all(fd, _head_bytes(hashes))
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        try:
+            _replace(tmp, self.head_path)
+        except OSError:
+            tmp.unlink(missing_ok=True)
+            raise
+        _fsync_dir(self.head_path.parent)
+
+    def _write(self, event: str, data: dict[str, Any], check: LogCheck) -> Entry:
+        return self._write_entry(event, data, check)
+
+    def _write_entry(self, event: str, data: dict[str, Any], check: LogCheck) -> Entry:
+        entry, line = self._encode(event, data, check.head)
+        if not check.entries and not self.head_path.exists():
+            # The head file exists before the first line does, so a crash during the first
+            # append leaves a torn entry under an empty head, and a missing head beside any
+            # entry is always damage, never a crash to repair (T12 review 9).
+            self._write_head([])
+        created = not self.path.exists()
+        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
+        try:
+            _write_all(fd, line)
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        if created:
+            _fsync_dir(self.path.parent)  # make the new file's name durable too
+        self._write_head([*(e.hash for e in check.entries), entry.hash])
+        return entry
+
+
+# On Windows a reader's open file blocks a rename over it for the moment the read takes
+# (no delete sharing), so a rename that meets one is retried briefly, not failed mid-append.
+REPLACE_RETRIES = 40
+REPLACE_PAUSE = 0.025
+
+
+def _replace(src: Path, dst: Path) -> None:
+    for attempt in range(REPLACE_RETRIES):
+        try:
+            os.replace(src, dst)
+            return
+        except PermissionError:
+            if os.name != "nt" or attempt == REPLACE_RETRIES - 1:
+                raise
+            time.sleep(REPLACE_PAUSE)
+
+
+def _write_all(fd: int, data: bytes) -> None:
+    view = memoryview(data)
+    while view:  # one call in practice; loop on a short write
+        view = view[os.write(fd, view):]
+
+
+def _fsync_dir(path: Path) -> None:
+    if os.name == "nt":  # pragma: no cover - Windows cannot open a directory for fsync
+        return
+    fd = os.open(path, os.O_RDONLY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+if os.name == "nt":  # pragma: no cover - exercised on Windows only
+    import ctypes
+    import msvcrt
+    from ctypes import wintypes
+
+    # LockFileEx, not msvcrt.locking: msvcrt has no shared lock, and a check must share the
+    # case with other checks (R43) while a writer takes it alone (R42). One byte, per handle;
+    # closing the handle, or the process ending, releases it.
+    class _Overlapped(ctypes.Structure):
+        _fields_ = [("Internal", ctypes.c_void_p), ("InternalHigh", ctypes.c_void_p),
+                    ("Offset", wintypes.DWORD), ("OffsetHigh", wintypes.DWORD),
+                    ("hEvent", wintypes.HANDLE)]
+
+    _KERNEL32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    _KERNEL32.LockFileEx.argtypes = [wintypes.HANDLE, wintypes.DWORD, wintypes.DWORD,
+                                     wintypes.DWORD, wintypes.DWORD, ctypes.POINTER(_Overlapped)]
+    _KERNEL32.LockFileEx.restype = wintypes.BOOL
+    _KERNEL32.UnlockFileEx.argtypes = [wintypes.HANDLE, wintypes.DWORD, wintypes.DWORD,
+                                       wintypes.DWORD, ctypes.POINTER(_Overlapped)]
+    _KERNEL32.UnlockFileEx.restype = wintypes.BOOL
+    _FAIL_IMMEDIATELY, _EXCLUSIVE = 0x1, 0x2
+    _ERROR_LOCK_VIOLATION = 33  # another handle holds a conflicting lock
+
+    _CONTENDED = {errno.EACCES}
+    _SHARED_LOCKS = True
+    _PROBE_FLAGS = os.O_RDONLY
+
+    def _win_error() -> OSError:
+        code = ctypes.get_last_error()
+        return OSError(errno.EACCES if code == _ERROR_LOCK_VIOLATION else errno.EIO,
+                       ctypes.FormatError(code))
+
+    def _lock(fd: int, shared: bool = False) -> None:
+        flags = _FAIL_IMMEDIATELY | (0 if shared else _EXCLUSIVE)
+        if not _KERNEL32.LockFileEx(msvcrt.get_osfhandle(fd), flags, 0, 1, 0,
+                                    ctypes.byref(_Overlapped())):
+            raise _win_error()
+
+    def _unlock(fd: int) -> None:
+        if not _KERNEL32.UnlockFileEx(msvcrt.get_osfhandle(fd), 0, 1, 0, ctypes.byref(_Overlapped())):
+            raise _win_error()
+
+else:
+    import fcntl
+
+    # flock with LOCK_NB reports a lock another process holds as EWOULDBLOCK (EAGAIN).
+    _CONTENDED = {errno.EWOULDBLOCK, errno.EAGAIN, errno.EACCES}
+
+    _SHARED_LOCKS = True
+    _PROBE_FLAGS = os.O_RDONLY  # a reader needs only read access to take a shared lock
+
+    def _lock(fd: int, shared: bool = False) -> None:
+        fcntl.flock(fd, (fcntl.LOCK_SH if shared else fcntl.LOCK_EX) | fcntl.LOCK_NB)
+
+    def _unlock(fd: int) -> None:
+        fcntl.flock(fd, fcntl.LOCK_UN)
+
+
+LOG_NAME = "log.jsonl"
+
+
+def for_case(folder: Path | str) -> CaseLog:
+    """The case log of a case folder (cases/<id>/log.jsonl)."""
+    return CaseLog(Path(folder) / LOG_NAME)
diff --git a/src/cma/cli.py b/src/cma/cli.py
index 671ee6d..c3cb09b 100644
--- a/src/cma/cli.py
+++ b/src/cma/cli.py
@@ -24,6 +24,8 @@ from .policy import PolicyError
 app = typer.Typer(no_args_is_help=True, add_completion=False)
 import_app = typer.Typer(no_args_is_help=True, help="Convert a bank export into a statement CSV.")
 app.add_typer(import_app, name="import")
+case_app = typer.Typer(no_args_is_help=True, help="Work with a case folder.")
+app.add_typer(case_app, name="case")
 console = Console()
 
 
@@ -303,6 +305,39 @@ def import_monzo(
     console.print("Check the closing balance against your Monzo app before trusting any metric.")
 
 
+@case_app.command("check")
+def case_check(folder: Path = typer.Argument(..., help="The case folder (cases/<id>).")):
+    """Load a case's log and check its hash chain against its head file (R43).
+
+    Exit 0 only when the whole log is intact, 3 when an entry was changed, removed,
+    reordered or not finished, naming the first bad entry, and 4 while another window or
+    command is saving to the case (D75): check again. Entries are named by number, never
+    quoted."""
+    from . import case
+
+    if not folder.is_dir():
+        console.print(f"[red]No case folder at {folder}.[/red]")
+        raise typer.Exit(code=2)
+    check = case.for_case(folder).verify()
+    if not check.checked:
+        if check.in_progress:
+            console.print("Case log is being saved by another window or command; nothing could "
+                          "be checked yet. Check again in a moment.")
+        else:
+            console.print(f"Case log {check.reason}. Check again in a moment.")
+        raise typer.Exit(code=4)
+    if not check.ok:
+        console.print(f"[red]Case log broken:[/red] entry {check.first_bad} {check.reason}.")
+        console.print("Nothing may be recorded or signed off on this case until it is resolved.")
+        raise typer.Exit(code=3)
+    if check.in_progress:  # R43, D75: being saved is never intact, so not exit 0
+        console.print(f"Case log is being saved by another window or command: its "
+                      f"{check.head.position} recorded entries check out, the rest is not "
+                      "checked yet. Check again in a moment.")
+        raise typer.Exit(code=4)
+    console.print(f"case log intact: {check.head.position} entries, head {check.head.hash[:12]}")
+
+
 @app.command()
 def truth(path: Path):
     """Print the ground truth for a generated statement."""
diff --git a/tests/test_case_log.py b/tests/test_case_log.py
new file mode 100644
index 0000000..f82613a
--- /dev/null
+++ b/tests/test_case_log.py
@@ -0,0 +1,1708 @@
+"""The case log: hash-chained, append-only, one writer at a time (R42, R43; property P15).
+
+P15: for any case log, changing, removing or reordering any entry before the head is
+detected on the next load. The logs here are small enough to try every entry and every
+kind of tamper exhaustively, which is the property over all logs of those sizes.
+"""
+
+import contextlib
+import json
+import os
+import threading
+import time
+
+import pytest
+
+from cma import case
+
+EVENTS = ["import", "profile_change", "override", "preview", "pack_write", "sign_off"]
+
+
+def _log(tmp_path, n):
+    log = case.CaseLog(tmp_path / "log.jsonl")
+    for i in range(n):
+        log.append(EVENTS[i % len(EVENTS)], {"n": i, "file": f"h{i}"}, expected=i)
+    return log
+
+
+def _lines(log):
+    return log.path.read_text(encoding="utf-8").splitlines(keepends=True)
+
+
+def _write(log, lines):
+    log.path.write_text("".join(lines), encoding="utf-8")
+
+
+def _write_head(log, hashes):
+    log.head_path.write_text(json.dumps({"count": len(hashes), "hash": hashes[-1] if hashes else case.GENESIS,
+                                         "hashes": hashes}, sort_keys=True,
+                                        separators=(",", ":")) + "\n", encoding="utf-8")
+
+
+def _crash_mid_append(log, monkeypatch, cut):
+    """Append one more entry, losing power after `cut` bytes of its line reach the disk:
+    the line has no newline and the head file was never updated."""
+    real = case._write_all
+
+    def torn(fd, data):
+        real(fd, data[:cut])
+        raise OSError("power lost")
+
+    monkeypatch.setattr(case, "_write_all", torn)
+    with pytest.raises(OSError):
+        log.append("override", {"n": 99}, expected=log.require_intact().position)
+    monkeypatch.undo()
+
+
+# --- appending -------------------------------------------------------------------------
+
+
+def test_each_entry_carries_the_hash_of_the_entry_before_it(tmp_path):
+    log = _log(tmp_path, 3)
+    entries = [json.loads(line) for line in _lines(log)]
+    assert [e["seq"] for e in entries] == [1, 2, 3]
+    assert entries[0]["prev"] == case.GENESIS
+    assert entries[1]["prev"] == entries[0]["hash"]
+    assert entries[2]["prev"] == entries[1]["hash"]
+    head = log.require_intact()
+    assert (head.position, head.hash) == (3, entries[2]["hash"])
+
+
+def test_append_returns_the_new_head_and_stamps_utc_time(tmp_path):
+    log = case.CaseLog(tmp_path / "log.jsonl")
+    entry = log.append("import", {"file": "abc"}, expected=0)
+    assert entry.seq == 1 and entry.event == "import" and entry.data == {"file": "abc"}
+    assert entry.at.endswith("Z")
+    assert log.verify().head.position == 1
+
+
+def test_empty_or_missing_log_is_intact_at_position_zero(tmp_path):
+    log = case.CaseLog(tmp_path / "log.jsonl")
+    head = log.require_intact()
+    assert (head.position, head.hash) == (0, case.GENESIS)
+
+
+def test_stale_expected_position_is_a_conflict_and_writes_nothing(tmp_path):
+    log = _log(tmp_path, 2)
+    before = log.path.read_bytes()
+    with pytest.raises(case.LogConflict) as e:
+        log.append("override", {"line": "T1"}, expected=1)
+    assert (e.value.expected, e.value.actual) == (1, 2)
+    assert log.path.read_bytes() == before
+
+
+def test_a_second_writer_is_refused_while_the_lock_is_held(tmp_path):
+    log = _log(tmp_path, 1)
+    other = case.CaseLog(log.path)
+    with log.writer(), pytest.raises(case.CaseLocked):
+        other.append("override", {}, expected=1)
+    other.append("override", {}, expected=1)  # released
+    assert log.require_intact().position == 2
+
+
+def test_append_refuses_a_broken_log(tmp_path):
+    log = _log(tmp_path, 3)
+    lines = _lines(log)
+    _write(log, [lines[0], lines[2]])
+    with pytest.raises(case.CaseLogBroken):
+        log.append("override", {}, expected=2)
+
+
+def test_event_and_data_are_checked(tmp_path):
+    log = case.CaseLog(tmp_path / "log.jsonl")
+    with pytest.raises(ValueError):
+        log.append("", {}, expected=0)
+    with pytest.raises(ValueError):
+        log.append("import", ["not", "a", "dict"], expected=0)
+    assert not log.path.exists() or log.path.read_bytes() == b""
+
+
+# --- P15: tamper anywhere before the head is detected, and the first bad entry named ---
+
+
+def _change(entry, field):
+    e = dict(entry)
+    if field == "data":
+        e["data"] = {**e["data"], "n": e["data"]["n"] + 1000}
+    elif field == "event":
+        e["event"] = "sign_off" if e["event"] != "sign_off" else "import"
+    elif field == "at":
+        e["at"] = "2000-01-01T00:00:00Z"
+    elif field == "prev":
+        e["prev"] = "f" * 64
+    elif field == "seq":
+        e["seq"] = e["seq"] + 7
+    elif field == "hash":
+        e["hash"] = "0" * 63 + "1"
+    return e
+
+
+def _dump(entry):
+    return json.dumps(entry, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n"
+
+
+SIZES = range(2, 7)
+FIELDS = ["data", "event", "at", "prev", "seq", "hash"]
+
+
+@pytest.mark.invariants
+@pytest.mark.parametrize("n", SIZES)
+@pytest.mark.parametrize("field", FIELDS)
+def test_p15_changing_any_entry_before_the_head_is_detected(tmp_path, n, field):
+    log = _log(tmp_path, n)
+    original = _lines(log)
+    for k in range(n - 1):  # every entry before the head
+        lines = list(original)
+        lines[k] = _dump(_change(json.loads(lines[k]), field))
+        _write(log, lines)
+        check = case.CaseLog(log.path).verify()
+        assert not check.ok and not check.torn
+        assert check.first_bad == k + 1, (field, k)
+
+
+@pytest.mark.invariants
+@pytest.mark.parametrize("n", SIZES)
+def test_p15_changing_an_entry_and_recomputing_its_hash_is_detected_at_that_entry(tmp_path, n):
+    log = _log(tmp_path, n)
+    original = _lines(log)
+    for k in range(n - 1):
+        e = json.loads(original[k])
+        e["data"] = {"n": -1}
+        e["hash"] = case.entry_hash(e)
+        lines = list(original)
+        lines[k] = _dump(e)
+        _write(log, lines)
+        check = log.verify()
+        assert not check.ok
+        assert check.first_bad == k + 1  # its hash is not the one the head file recorded
+
+
+@pytest.mark.invariants
+@pytest.mark.parametrize("n", SIZES)
+def test_p15_removing_any_entry_before_the_head_is_detected(tmp_path, n):
+    log = _log(tmp_path, n)
+    original = _lines(log)
+    for k in range(n - 1):
+        _write(log, original[:k] + original[k + 1:])
+        check = log.verify()
+        assert not check.ok and not check.torn
+        assert check.first_bad == k + 1
+
+
+@pytest.mark.invariants
+@pytest.mark.parametrize("n", SIZES)
+def test_p15_reordering_any_entries_before_the_head_is_detected(tmp_path, n):
+    log = _log(tmp_path, n)
+    original = _lines(log)
+    for i in range(n):
+        for j in range(i + 1, n):
+            lines = list(original)
+            lines[i], lines[j] = lines[j], lines[i]
+            _write(log, lines)
+            check = log.verify()
+            assert not check.ok
+            assert check.first_bad == i + 1, (i, j)
+
+
+@pytest.mark.invariants
+@pytest.mark.parametrize("n", SIZES)
+def test_p15_inserting_an_entry_before_the_head_is_detected(tmp_path, n):
+    log = _log(tmp_path, n)
+    original = _lines(log)
+    for k in range(n):
+        lines = [*original[:k], original[k], *original[k:]]  # a duplicated entry
+        _write(log, lines)
+        check = log.verify()
+        assert not check.ok
+        assert check.first_bad == k + 2
+
+
+def test_a_garbled_line_before_the_head_is_broken_not_torn(tmp_path):
+    log = _log(tmp_path, 3)
+    lines = _lines(log)
+    _write(log, [lines[0], "{not json\n", lines[2]])
+    check = log.verify()
+    assert not check.ok and not check.torn and check.first_bad == 2
+
+
+def test_the_message_names_the_first_bad_entry_and_holds_no_entry_content(tmp_path):
+    log = _log(tmp_path, 3)
+    lines = _lines(log)
+    e = json.loads(lines[1])
+    e["data"] = {"secret": "ACME LTD"}
+    _write(log, [lines[0], _dump(e), lines[2]])
+    with pytest.raises(case.CaseLogBroken) as err:
+        log.require_intact()
+    assert err.value.first_bad == 2
+    assert "entry 2" in str(err.value)
+    assert "ACME" not in str(err.value)
+
+
+# --- a torn last entry (power lost mid-write) ------------------------------------------
+
+
+@pytest.mark.invariants
+@pytest.mark.parametrize("cut", [1, 10, -2, -1])
+def test_p15_torn_last_entry_is_detected_and_named(tmp_path, monkeypatch, cut):
+    log = _log(tmp_path, 2)
+    _crash_mid_append(log, monkeypatch, cut)  # no newline: the write never finished
+    check = log.verify()
+    assert not check.ok and check.torn and check.first_bad == 3
+    assert check.head.position == 2  # the intact part
+    with pytest.raises(case.CaseLogBroken) as err:
+        log.require_intact()
+    assert err.value.torn and "entry 3" in str(err.value) and "incomplete" in str(err.value)
+
+
+@pytest.mark.invariants
+def test_p15_a_lock_error_is_not_a_live_writer_so_a_torn_entry_is_still_reported(tmp_path, monkeypatch):
+    # T12 review verify-28: a lock subsystem error (here ENOLCK) was treated as another
+    # writer holding the lock, so a torn log was reported as its intact prefix.
+    import errno
+    log = _log(tmp_path, 2)
+    _crash_mid_append(log, monkeypatch, 5)
+    monkeypatch.setattr(case, "READ_PAUSE", 0)
+
+    def broken_lock(fd, shared=False):
+        raise OSError(errno.ENOLCK, "no locks available")
+
+    monkeypatch.setattr(case, "_lock", broken_lock)
+    with pytest.raises(OSError) as err, log.writer():
+        pass
+    assert not isinstance(err.value, case.CaseLocked)
+    check = log.verify()
+    assert not check.ok and check.torn and check.first_bad == 3
+
+
+@pytest.mark.invariants
+def test_p15_a_contended_lock_still_reads_as_another_writer(tmp_path, monkeypatch):
+    import errno
+    log = _log(tmp_path, 1)
+
+    def held(fd, shared=False):
+        raise OSError(errno.EWOULDBLOCK, "held")
+
+    monkeypatch.setattr(case, "_lock", held)
+    with pytest.raises(case.CaseLocked), log.writer():
+        pass
+
+
+@pytest.mark.invariants
+def test_p15_a_failed_unlock_still_releases_the_lock(tmp_path, monkeypatch):
+    # T12 review: if the explicit unlock raised, the descriptor was never closed, so the
+    # lock stayed held and blocked later appends until the process exited.
+    import errno
+    log = _log(tmp_path, 1)
+    closed = []
+    real_close = os.close
+
+    def broken_unlock(fd):
+        raise OSError(errno.EIO, "unlock failed")
+
+    def tracking_close(fd):
+        closed.append(fd)
+        real_close(fd)
+
+    monkeypatch.setattr(case, "_unlock", broken_unlock)
+    monkeypatch.setattr(case.os, "close", tracking_close)
+    with log.writer():
+        held = log._lock_fd
+    assert held in closed and log._lock_fd is None
+    monkeypatch.undo()
+    other = case.CaseLog(log.path)  # a fresh handle, as another command would open
+    other.append("override", {}, expected=1)
+    assert len(other.entries()) == 2
+
+
+@pytest.mark.invariants
+@pytest.mark.skipif(not hasattr(os, "fork"), reason="fork is POSIX only")
+def test_p15_a_forked_child_cannot_write_on_its_parents_lock(tmp_path):
+    # T12 review: the owner was the thread ident alone, which a forked child inherits,
+    # so the child entered the writer without a lock and both could append at seq 2.
+    log = _log(tmp_path, 1)
+    with log.writer():
+        pid = os.fork()
+        if pid == 0:  # the child: report through the exit code only
+            try:
+                with log.writer():
+                    os._exit(1)
+            except case.CaseLocked:
+                os._exit(0)
+            except BaseException:
+                os._exit(2)
+        _, status = os.waitpid(pid, 0)
+    assert os.waitstatus_to_exitcode(status) == 0
+    assert len(log.entries()) == 1
+
+
+@pytest.mark.invariants
+@pytest.mark.skipif(not hasattr(os, "fork"), reason="fork is POSIX only")
+def test_p15_a_forked_child_leaving_the_writer_does_not_release_its_parents_lock(tmp_path):
+    # T12 review: a child forked inside a writer block ran the block's cleanup on the way
+    # out and unlocked the shared open file, so the parent wrote on without its lock.
+    log = _log(tmp_path, 1)
+    pid = None
+    try:
+        with log.writer():
+            pid = os.fork()
+            if pid:
+                _, status = os.waitpid(pid, 0)
+                assert os.waitstatus_to_exitcode(status) == 0
+                with pytest.raises(case.CaseLocked), case.CaseLog(log.path).writer():
+                    pass
+    finally:
+        if pid == 0:  # the child left the block normally; report and stop here
+            os._exit(0)
+    with case.CaseLog(log.path).writer():  # released once the parent leaves
+        pass
+
+
+@pytest.mark.invariants
+def test_p15_an_interrupt_after_the_lock_is_taken_leaves_no_lock(tmp_path, monkeypatch):
+    # Pre-review: KeyboardInterrupt after flock but before the descriptor was recorded
+    # leaked it, and every writer in the process was refused from then on.
+    log = _log(tmp_path, 1)
+    real = case._lock
+
+    def lock_then_interrupt(fd, shared=False):
+        real(fd)
+        raise KeyboardInterrupt
+
+    monkeypatch.setattr(case, "_lock", lock_then_interrupt)
+    with pytest.raises(KeyboardInterrupt), log.writer():
+        pass
+    monkeypatch.undo()
+    assert log._lock_fd is None and log._owner is None
+    case.CaseLog(log.path).append("override", {}, expected=1)
+
+
+@pytest.mark.invariants
+def test_p15_cleanup_reentering_the_state_lock_on_its_thread_does_not_hang(tmp_path):
+    # Pre-review: a writer block finalised by the garbage collector (or a signal handler)
+    # while its thread was inside a short state-lock region deadlocked on that lock.
+    log = _log(tmp_path, 1)
+
+    def reenter():
+        with log._state, log.writer():
+            pass
+
+    t = threading.Thread(target=reenter, daemon=True)
+    t.start()
+    t.join(5)
+    assert not t.is_alive()
+
+
+def test_a_rename_blocked_by_a_windows_reader_is_retried_not_failed(tmp_path, monkeypatch):
+    # Pre-review: on Windows a reader's open file blocks a rename over it for a moment; the
+    # head file's rename after an append must wait it out, not leave a torn entry.
+    real, calls = os.replace, []
+
+    def busy_twice(src, dst):
+        calls.append(dst)
+        if len(calls) <= 2:
+            raise PermissionError(13, "in use by a reader")
+        real(src, dst)
+
+    src, dst = tmp_path / "a.tmp", tmp_path / "a"
+    src.write_bytes(b"x")
+    monkeypatch.setattr(case.os, "replace", busy_twice)
+    monkeypatch.setattr(case, "REPLACE_PAUSE", 0)
+    monkeypatch.setattr(case.os, "name", "nt")
+    case._replace(src, dst)
+    monkeypatch.setattr(case.os, "name", "posix")
+    assert dst.read_bytes() == b"x" and len(calls) == 3
+    src.write_bytes(b"y")
+    calls.clear()
+    with pytest.raises(PermissionError):  # elsewhere a permission error is real at once
+        case._replace(src, dst)
+    assert len(calls) == 1
+
+
+@pytest.mark.invariants
+@pytest.mark.skipif(not hasattr(os, "symlink"), reason="needs symlinks")
+def test_p15_the_holder_sees_a_torn_entry_through_another_spelling_of_the_path(tmp_path, monkeypatch):
+    # T12 review: a second CaseLog opened through a symlinked folder was not recognised as
+    # the holder, so its refused fallback lock excused a torn entry as an append landing.
+    log = _log(tmp_path, 2)
+    _crash_mid_append(log, monkeypatch, 10)
+    alias = tmp_path / "alias"
+    try:
+        os.symlink(log.path.parent, alias, target_is_directory=True)
+    except OSError:
+        pytest.skip("symlinks not permitted here")
+    with log.writer(), pytest.raises(case.CaseLogBroken):
+        case.CaseLog(alias / log.path.name).require_intact()
+
+
+@pytest.mark.invariants
+@pytest.mark.skipif(not hasattr(os, "fork"), reason="fork is POSIX only")
+def test_p15_a_forked_childs_reader_reports_a_torn_entry_once_its_parent_has_let_go(tmp_path, monkeypatch):
+    # R43 (revision 5): only a writer holding the case now excuses an incomplete entry. An
+    # object inherited across a fork still names the parent after the parent lets go.
+    log = _log(tmp_path, 2)
+    _crash_mid_append(log, monkeypatch, 10)
+    monkeypatch.setattr(case, "READ_PAUSE", 0)
+    go_r, go_w = os.pipe()
+    pid = None
+    with log.writer():
+        pid = os.fork()
+        if pid == 0:
+            code = 2
+            try:
+                os.close(go_w)
+                os.read(go_r, 1)  # the parent has let go
+                check = log.verify()
+                code = 0 if check.torn and not check.in_progress and check.first_bad == 3 else 1
+            finally:
+                os._exit(code)
+        os.close(go_r)
+    os.write(go_w, b"x")
+    os.close(go_w)
+    _, status = os.waitpid(pid, 0)
+    assert os.waitstatus_to_exitcode(status) == 0
+
+
+@pytest.mark.invariants
+def test_p15_a_held_cases_recorded_entries_are_judged_strictly_and_an_unsteady_read_claims_nothing(
+        tmp_path, monkeypatch):
+    # R43 (revision 6, D73): while anyone holds the case, the entries the log records as
+    # complete are judged from every read; nothing after them is called intact or broken.
+    log = _log(tmp_path, 4)
+    lines = _lines(log)
+    tampered = "".join([*lines[:2], lines[2].replace('"n":2', '"n":7'), *lines[3:]]).encode()
+    holder, taken, leave = case.CaseLog(log.path), threading.Event(), threading.Event()
+
+    def hold():
+        with holder.writer():
+            taken.set()
+            leave.wait(10)
+
+    t = threading.Thread(target=hold)
+    t.start()
+    assert taken.wait(5)
+    real_head, calls = case._read_head, {"n": 0}
+
+    def head_keeps_moving(path):
+        calls["n"] += 1
+        hashes = real_head(path)
+        return hashes[:2] if calls["n"] % 2 else hashes  # never the same twice in a row
+
+    try:
+        monkeypatch.setattr(case, "READ_PAUSE", 0)
+        monkeypatch.setattr(case.CaseLog, "_read_log", lambda self: tampered)
+        check = case.CaseLog(log.path).verify()  # entry 3 is recorded: damage is named
+        assert not check.ok and check.first_bad == 3 and not check.in_progress
+        monkeypatch.setattr(case, "_read_head", head_keeps_moving)
+        check = case.CaseLog(log.path).verify()  # entry 3 is past the head it was read with
+        assert not check.checked and not check.ok and check.first_bad is None and check.in_progress
+        with pytest.raises(case.CaseLocked):
+            case.CaseLog(log.path).require_intact()
+    finally:
+        monkeypatch.undo()
+        leave.set()
+        t.join(10)
+
+
+@pytest.mark.invariants
+@pytest.mark.skipif(not hasattr(os, "fork"), reason="fork is POSIX only")
+def test_p15_a_forked_child_cannot_write_through_an_inherited_log_even_when_it_was_free(tmp_path):
+    # T12 review / R42: a CaseLog belongs to the process that opened it; the child's
+    # writes through it are refused whether or not the lock was held at the fork.
+    log = _log(tmp_path, 1)
+    pid = os.fork()
+    if pid == 0:
+        code = 2
+        try:
+            log.append("override", {}, expected=1)
+            code = 1
+        except case.CaseLocked:
+            code = 0
+        finally:
+            os._exit(code)
+    _, status = os.waitpid(pid, 0)
+    assert os.waitstatus_to_exitcode(status) == 0
+    assert len(log.entries()) == 1
+    log.append("override", {}, expected=1)  # the parent's own handle still writes
+
+
+def _stale_unrecorded(log, k):
+    """k recorded entries plus a complete line the head file does not record: the power
+    went between writing the line and replacing the head file."""
+    head = log.head_path.read_bytes()
+    log.append("override", {"n": k}, expected=k)
+    log.head_path.write_bytes(head)
+
+
+@pytest.mark.invariants
+def test_p15_a_reader_caught_across_a_drop_does_not_call_a_healthy_log_rewritten(tmp_path, monkeypatch):
+    # Pre-review: a drop replaces the log file; a reader that read the old log and then
+    # the new head judged the old unrecorded line against the drop entry's hash.
+    log = _log(tmp_path, 3)
+    _stale_unrecorded(log, 3)
+    go, done, release, held = threading.Event(), threading.Event(), threading.Event(), threading.Event()
+
+    def dropper():
+        d = case.CaseLog(log.path)
+        with d.writer():
+            held.set()
+            go.wait(5)
+            d.drop_torn_entry(expected=3, by="A. Underwriter")
+            done.set()
+            release.wait(5)
+
+    t = threading.Thread(target=dropper)
+    t.start()
+    assert held.wait(5)  # the reader starts while the dropper holds the case
+    reader, calls, real = case.CaseLog(log.path), {"n": 0}, case.CaseLog._read_log
+
+    def read(self):
+        raw = real(self)
+        if self is reader:
+            calls["n"] += 1
+            if calls["n"] == 1:  # the drop lands between this log read and the head
+                go.set()
+                done.wait(5)
+        return raw
+
+    monkeypatch.setattr(case.CaseLog, "_read_log", read)
+    try:
+        check = reader.verify()
+    finally:
+        monkeypatch.undo()
+        release.set()
+        t.join(10)
+    assert check.ok, check.reason
+    assert case.CaseLog(log.path).verify().ok
+
+
+@pytest.mark.invariants
+def test_p15_a_reader_during_a_slow_append_reports_it_being_saved_never_torn(tmp_path, monkeypatch):
+    # An append whose head file is slow: the case is held, so the reader reports the
+    # recorded entries and the new line as being saved; once free, the log is whole.
+    log = _log(tmp_path, 3)
+    written, go = threading.Event(), threading.Event()
+    writer = case.CaseLog(log.path)
+    real_head = case.CaseLog._write_head
+
+    def slow_head(self, hashes):
+        if self is writer:
+            written.set()
+            go.wait(5)
+        real_head(self, hashes)
+
+    monkeypatch.setattr(case.CaseLog, "_write_head", slow_head)
+    monkeypatch.setattr(case, "READ_PAUSE", 0)
+    t = threading.Thread(target=lambda: writer.append("override", {"n": 3}, expected=3))
+    t.start()
+    assert written.wait(5)
+    try:
+        check = case.CaseLog(log.path).verify()
+    finally:
+        go.set()
+        t.join(10)
+    assert check.in_progress and check.ok and not check.torn and check.head.position == 3
+    after = case.CaseLog(log.path).verify()
+    assert after.ok and not after.in_progress and after.head.position == 4
+
+
+@pytest.mark.invariants
+def test_p15_a_torn_entry_is_being_saved_while_held_and_named_once_the_case_is_free(tmp_path, monkeypatch):
+    # R43 (revision 6): while a drop holds the case, a reader reports the recorded entries
+    # and the rest as being saved, never intact; free, a torn entry is named.
+    log = _log(tmp_path, 3)
+    _crash_mid_append(log, monkeypatch, 10)
+    monkeypatch.setattr(case, "READ_PAUSE", 0)
+    free = case.CaseLog(log.path).verify()
+    assert free.torn and free.first_bad == 4 and not free.in_progress
+    inside, go = threading.Event(), threading.Event()
+    dropper = case.CaseLog(log.path)
+    real = case.CaseLog._replace_torn
+
+    def slow(self, check, by):
+        inside.set()
+        go.wait(5)
+        return real(self, check, by)
+
+    monkeypatch.setattr(case.CaseLog, "_replace_torn", slow)
+    t = threading.Thread(target=lambda: dropper.drop_torn_entry(expected=3, by="A. Underwriter"))
+    t.start()
+    assert inside.wait(5)
+    try:
+        held = case.CaseLog(log.path).verify()
+    finally:
+        go.set()
+        t.join(10)
+    assert held.in_progress and held.first_bad is None and held.head.position == 3
+    done = case.CaseLog(log.path).verify()
+    assert done.ok and done.head.position == 4 and done.entries[-1].event == case.TORN_DROPPED
+
+
+@pytest.mark.invariants
+def test_p15_entries_removed_while_another_writer_appends_are_still_named(tmp_path, monkeypatch):
+    # Entries the log records as complete are judged strictly even while another writer
+    # holds the case mid-append: removing them is named, never excused as being saved.
+    log = _log(tmp_path, 3)
+    written, go = threading.Event(), threading.Event()
+    writer = case.CaseLog(log.path)
+    real_head = case.CaseLog._write_head
+
+    def slow_head(self, hashes):
+        if self is writer:
+            written.set()
+            go.wait(5)
+        real_head(self, hashes)
+
+    monkeypatch.setattr(case.CaseLog, "_write_head", slow_head)
+    t = threading.Thread(target=lambda: writer.append("override", {"n": 3}, expected=3))
+    t.start()
+    assert written.wait(5)
+    lines = log.path.read_bytes().split(b"\n")
+    log.path.write_bytes(b"\n".join(lines[:2]) + b"\n")  # recorded entries 3 and 4 cut away
+    try:
+        check = case.CaseLog(log.path).verify()
+    finally:
+        go.set()
+        t.join(10)
+    assert not check.ok and check.first_bad == 3 and not check.in_progress
+
