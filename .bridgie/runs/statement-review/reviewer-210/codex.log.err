+
+    csv = tmp_path / "s.csv"
+    csv.write_bytes(f"id,date,amount,balance,description\nT1,2026-01-01,{big},{big},A\nT2,2026-01-02,{big},1.00,"
+                    .encode() + b"CAF\xe9\n")
+    with pytest.raises(ingest.StatementError) as e:
