   309	def case_check(folder: Path = typer.Argument(..., help="The case folder (cases/<id>).")):
   310	    """Load a case's log and check its hash chain against its head file (R43).
   311	
   312	    Exit 0 only when the whole log is intact, 3 when an entry was changed, removed,
   313	    reordered or not finished, naming the first bad entry, and 4 while another window or
   314	    command is saving to the case (D75): check again. Entries are named by number, never
   315	    quoted."""
   316	    from . import case
   317	
   318	    if not folder.is_dir():
   319	        console.print(f"[red]No case folder at {folder}.[/red]")
   320	        raise typer.Exit(code=2)
   321	    check = case.for_case(folder).verify()
   322	    if not check.checked:
   323	        if check.in_progress:
   324	            console.print("Case log is being saved by another window or command; nothing could "
   325	                          "be checked yet. Check again in a moment.")
   326	        else:
   327	            console.print(f"Case log {check.reason}. Check again in a moment.")
   328	        raise typer.Exit(code=4)
   329	    if not check.ok:
   330	        console.print(f"[red]Case log broken:[/red] entry {check.first_bad} {check.reason}.")
   331	        console.print("Nothing may be recorded or signed off on this case until it is resolved.")
   332	        raise typer.Exit(code=3)
   333	    if check.in_progress:  # R43, D75: being saved is never intact, so not exit 0
   334	        console.print(f"Case log is being saved by another window or command: its "
   335	                      f"{check.head.position} recorded entries check out, the rest is not "
   336	                      "checked yet. Check again in a moment.")
   337	        raise typer.Exit(code=4)
   338	    console.print(f"case log intact: {check.head.position} entries, head {check.head.hash[:12]}")
