   233	def _decide(graph, cfg, decision: dict) -> dict:
   234	    """Resume with this decision, and make sure it is the one that was recorded.
   235	
   236	    Two people can open the same pending review from a shared --checkpoint-db. If
   237	    someone else decided first, resuming is a no-op that returns *their* decision; say
   238	    so instead of reporting it as ours.
   239	    """
   240	    if not graph.get_state(cfg).interrupts:
   241	        _decided_elsewhere(graph.get_state(cfg).values)
   242	    final = graph.invoke(Command(resume=decision), cfg)
   243	    review = final.get("review")
   244	    if "__interrupt__" not in final and (
   245	        review is None or review.reviewer != (decision.get("reviewer") or "").strip()
   246	        or review.approved != decision.get("approved")
    72	def validate_ruleset(data: object, expected_id: str, source: str = "rules") -> None:
    73	    if not isinstance(data, dict):
    74	        raise RulesetError(f"{source}: not a mapping")
    75	    problems: list[str] = []
    76	    if "id" not in data:
    77	        problems.append("missing id")
    78	    elif data["id"] != expected_id:
    79	        problems.append(f"id {data['id']!r} does not match the file ({expected_id!r})")
    80	    if not isinstance(data.get("frozen"), bool):
    81	        problems.append("frozen must be true or false")
    82	    for key in sorted(set(data) - TABLE_KEYS, key=repr):
    83	        problems.append(f"unknown key {key!r}")
    84	    rules = data.get("rules")
    85	    if not isinstance(rules, list) or not rules:
    86	        raise RulesetError(f"{source}: " + "; ".join([*problems, "no rules"]))
    87	    categories = {c.value for c in Category}
    88	    seen: set[str] = set()
    89	    for i, r in enumerate(rules, start=1):
    90	        where = f"rule {i} ({r.get('id', '?') if isinstance(r, dict) else '?'})"
    91	        if not isinstance(r, dict):
    92	            problems.append(f"{where}: not a mapping")
    93	            continue
    94	        for key in sorted(RULE_KEYS - set(r)):
    95	            problems.append(f"{where}: missing {key}")
    96	        for key in sorted(set(r) - RULE_KEYS, key=repr):
    97	            problems.append(f"{where}: unknown key {key!r}")
    98	        # Every field is a string. Checking the type first means a list, a mapping, a
    99	        # number or null is reported here, not raised later as a TypeError.
   100	        for key in sorted(RULE_KEYS & set(r)):
   101	            if not isinstance(r[key], str) or not r[key]:
   102	                problems.append(f"{where}: {key} {r[key]!r} is not a non-empty string")
   103	        if isinstance(r.get("id"), str):
   104	            if r["id"] in seen:
   105	                problems.append(f"{where}: duplicate id")
   106	            seen.add(r["id"])
   107	        if isinstance(r.get("direction"), str) and r["direction"] not in DIRECTIONS:
   108	            problems.append(f"{where}: direction {r['direction']!r} is not one of {list(DIRECTIONS)}")
   109	        if isinstance(r.get("category"), str) and r["category"] not in categories:
   110	            problems.append(f"{where}: category {r['category']!r} is not a category")
   111	        if isinstance(r.get("pattern"), str) and r["pattern"]:
   112	            try:
   113	                re.compile(r["pattern"])
   114	            except re.error as e:
   115	                problems.append(f"{where}: pattern does not compile ({e})")
   116	    if problems:
   117	        raise RulesetError(f"{source}: " + "; ".join(problems))
   118	
   119	
   120	def ruleset_from_data(data: object, expected_id: str, source: str, sha256: str) -> Ruleset:
   121	    validate_ruleset(data, expected_id, source)
   122	    assert isinstance(data, dict)
   123	    return Ruleset(
   124	        id=data["id"],
   125	        sha256=sha256,
   126	        rules=tuple(
   127	            Rule(r["id"], re.compile(r["pattern"]), r["direction"], Category(r["category"]))
   128	            for r in data["rules"]
   129	        ),
   130	    )
   131	
   132	
   133	class _UniqueKeyLoader(yaml.SafeLoader):
   134	    """safe_load keeps the last of two equal keys, so a second `category:` inside a rule
   135	    would silently change it with nothing left for the validator to see. Refuse instead."""
   136	
   137	    def construct_mapping(self, node, deep=False):
   138	        seen: set = set()
   139	        for key_node, _ in node.value:
   140	            key = self.construct_object(key_node, deep=deep)
   141	            try:
   142	                duplicate = key in seen
   143	            except TypeError:  # an unhashable key; the base class reports it
   144	                continue
   145	            if duplicate:
   146	                raise yaml.constructor.ConstructorError(
   147	                    "while constructing a mapping", node.start_mark,
   148	                    f"found duplicate key {key!r}", key_node.start_mark)
   149	            seen.add(key)
   150	        return super().construct_mapping(node, deep=deep)
   151	
   152	
   153	def _table_bytes(ruleset_id: str) -> bytes:
   154	    return resources.files("cma.rules").joinpath(f"{ruleset_id}.yaml").read_bytes()
   155	
   156	
   157	@lru_cache
   158	def load_ruleset(ruleset_id: str) -> Ruleset:
   159	    """A packaged table by id. Only ids in RULESETS load, so an id never names a path."""
   160	    if ruleset_id not in RULESETS:
   161	        raise RulesetError(f"unknown ruleset {ruleset_id!r}; known: {', '.join(RULESETS)}")
   162	    source = f"cma/rules/{ruleset_id}.yaml"
   163	    try:
   164	        raw = _table_bytes(ruleset_id)
   165	    except OSError as e:
   166	        raise RulesetError(f"{source}: cannot be read from the installed package ({e.__class__.__name__})") from e
   167	    try:
   168	        data = yaml.load(raw.decode("utf-8"), Loader=_UniqueKeyLoader)
   169	    except UnicodeDecodeError as e:
   170	        raise RulesetError(f"{source}: not UTF-8 text") from e
   171	    except yaml.YAMLError as e:
   172	        problem = getattr(e, "problem", None) or e.__class__.__name__
   173	        raise RulesetError(f"{source}: not valid YAML ({problem})") from e
   174	    # The hash is of the file's bytes as installed, so it matches sha256sum on that file.
   175	    return ruleset_from_data(data, ruleset_id, source, hashlib.sha256(raw).hexdigest())
   176	
