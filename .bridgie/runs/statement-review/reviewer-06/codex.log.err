   213	            raise typer.Exit(code=3)
   214	        decision = _ask(payload, grounded, reviewer)
   215	        final = _decide(graph, cfg, decision)
   216	
   217	    approved = final["review"].approved
   218	    if out:
   219	        target = out if approved else out.with_name(out.stem + ".rejected.md")
   220	        evidence = _evidence_path(target)
   221	        target.write_text(final["final_memo"])
   222	        evidence.write_text(json.dumps(evidence_record({**final, "ruleset": ruleset}), indent=2, default=str))
   223	        console.print(f"wrote {target} and {evidence}")
   224	    if not approved:
   225	        console.rule("Not approved")
   226	        console.print(Markdown(final["final_memo"]))
   227	        raise typer.Exit(code=1)
   228	    if not out:
   229	        console.rule("Final")
   230	        console.print(Markdown(final["final_memo"]))
