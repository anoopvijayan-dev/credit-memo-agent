[project]
name = "credit-memo-agent"
version = "0.1.0"
description = "A UK SME cash-flow credit-memo agent: deterministic metrics, cited figures, policy checks, and a human sign-off before anything leaves the building."
readme = "README.md"
requires-python = ">=3.11"
license = { text = "MIT" }
authors = [{ name = "Anoop Vijayan" }]
dependencies = [
  "langgraph>=1.0",
  "pydantic>=2.6",
  "pyyaml>=6",
  "typer>=0.12",
  "rich>=13",
]

[project.optional-dependencies]
llm = ["anthropic>=0.40", "openai>=1.40"]
mcp = ["mcp>=2.0"]
durable = ["langgraph-checkpoint-sqlite>=3.0"]
dev = ["pytest>=8", "ruff>=0.5"]

[project.scripts]
cma = "cma.cli:app"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/cma"]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I", "B", "SIM", "RUF"]
ignore = ["B008", "E501"]  # typer.Option defaults are the idiom; lines are wrapped by hand

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]
markers = [
  "dual_run: compares behaviour before and after a change (P7: the rule table as code at fd7b64c vs v1.yaml)",
]
{
  "type": "object",
  "required": ["task", "criteria", "findings", "verdict", "verifier"],
  "properties": {
    "task": { "type": "string" },
    "criteria": { "type": "array", "items": { "type": "object", "required": ["id", "tier", "check", "result"], "properties": { "id": { "type": "string" }, "tier": { "type": "string", "enum": ["mechanical", "specified", "contracts", "invariants", "adversarial", "behavioural", "dual_run", "human"] }, "check": { "type": "string" }, "result": { "type": "string", "enum": ["pass", "fail", "not_proven"] }, "artifact": { "type": ["string", "null"] } } } },
    "findings": { "type": "array", "items": { "type": "object", "required": ["severity", "claim", "repro"], "properties": { "severity": { "type": "string", "enum": ["blocker", "major", "minor"] }, "file": { "type": ["string", "null"] }, "line": { "type": ["integer", "null"] }, "criterion": { "type": ["string", "null"] }, "claim": { "type": "string" }, "repro": { "type": "string" }, "disposition": { "type": ["string", "null"] } } } },
    "verdict": { "type": "string", "enum": ["pass", "fail", "not_proven"] },
    "verifier": { "type": "object", "required": ["seat", "adapter", "model"], "properties": { "seat": { "type": "string" }, "adapter": { "type": "string" }, "model": { "type": "string" } } }
  }
}

