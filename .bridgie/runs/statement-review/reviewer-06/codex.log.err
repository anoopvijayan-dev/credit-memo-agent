   139	def _refuse_to_overwrite(out: Path | None) -> None:
   140	    """Never replace an earlier memo or its evidence: the pair is the audit record."""
   141	    if out is None:
   142	        return
   143	    taken = [p for p in _outputs(out) if p.exists()]
   144	    if taken:
   145	        console.print(f"[red]Refusing to overwrite {', '.join(map(str, taken))}. Choose another --out.[/red]")
   146	        raise typer.Exit(code=2)
   147	
   148	
   149	def _outputs(out: Path) -> list[Path]:
   150	    rejected = out.with_name(out.stem + ".rejected.md")
   151	    return [out, _evidence_path(out), rejected, _evidence_path(rejected)]
   152	
   153	
   154	def _evidence_path(memo: Path) -> Path:
   155	    return memo.with_name(memo.stem + ".evidence.json")
   156	
   157	
   158	@contextmanager
   159	def _checkpointer(path: Path | None):
   160	    if path is None:
   161	        yield None
   162	        return
   163	    try:
   164	        with sqlite_checkpointer(path) as saver:
   165	            yield saver
   166	    except RuntimeError as e:
   167	        console.print(f"[red]{e}[/red]")
   168	        raise typer.Exit(code=2) from e
