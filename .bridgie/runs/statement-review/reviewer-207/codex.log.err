+        sent.append(message)
+
+    async def receive():
+        return {"type": "http.request", "body": b"", "more_body": False}
+
+    asyncio.run(served[0]({"type": "http", "method": "POST", "path": "/mcp", "headers": []}, receive, send))
+    assert sent[0]["status"] == 503 and no_network == []
