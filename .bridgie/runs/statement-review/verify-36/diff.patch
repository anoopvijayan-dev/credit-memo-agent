+def _case_dir(tmp_path, n):
+    folder = tmp_path / "cases" / "c1"
+    folder.mkdir(parents=True)
+    log = case.for_case(folder)
+    for i in range(n):
+        log.append(EVENTS[i % len(EVENTS)], {"n": i, "secret": "ACME LTD"}, expected=i)
+    return folder, log
