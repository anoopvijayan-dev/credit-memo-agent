    25	class PolicyError(ValueError):
    26	    """The policy file is malformed; no decision should be made from it."""
    27	
    28	
    29	def default_policy_text() -> str:
    30	    return resources.files("cma.policies").joinpath(DEFAULT_POLICY_NAME).read_text()
    31	
    32	
    33	def load_policy(path: Path | None = None) -> dict:
    34	    source = str(path or f"cma/policies/{DEFAULT_POLICY_NAME}")
    35	    try:
    36	        text = Path(path).read_text() if path else default_policy_text()
    37	        policy = yaml.safe_load(text)
    38	    except FileNotFoundError as e:
    39	        raise PolicyError(f"{source}: no such file") from e
    40	    except yaml.YAMLError as e:
    41	        raise PolicyError(f"{source}: not valid YAML ({e.__class__.__name__})") from e
    42	    validate(policy, source=source)
    43	    policy["_sha256"] = hashlib.sha256(text.encode()).hexdigest()
    44	    return policy
    45	
    46	
    47	def validate(policy: object, source: str = "policy", metric_ids: set[str] | None = None) -> None:
    48	    problems: list[str] = []
    49	    if not isinstance(policy, dict):
    50	        raise PolicyError(f"{source}: not a mapping")
    51	    if not isinstance(policy.get("name"), str) or not policy["name"].strip():
    52	        problems.append("missing name")
    53	    rules = policy.get("rules")
    54	    if not isinstance(rules, list) or not rules:
    55	        raise PolicyError(f"{source}: no rules")
    56	    seen: set[str] = set()
    57	    for i, r in enumerate(rules, start=1):
    58	        where = f"rule {i} ({r.get('id', '?') if isinstance(r, dict) else '?'})"
    59	        if not isinstance(r, dict):
    60	            problems.append(f"{where}: not a mapping")
    61	            continue
    62	        for key in ("id", "description", "metric", "op", "threshold", "on_fail"):
    63	            if key not in r:
    64	                problems.append(f"{where}: missing {key}")
    65	        if r.get("id") in seen:
    66	            problems.append(f"{where}: duplicate id")
    67	        seen.add(r.get("id"))
    68	        if r.get("op") not in OPS:
    69	            problems.append(f"{where}: op {r.get('op')!r} is not one of {sorted(OPS)}")
    70	        if r.get("on_fail") not in ON_FAIL:
    71	            problems.append(f"{where}: on_fail {r.get('on_fail')!r} must be refer or fail")
    72	        if r.get("when_missing", "refer") not in WHEN_MISSING:
    73	            problems.append(f"{where}: when_missing must be pass, refer or fail")
    74	        for key in ("threshold", "refer_below", "refer_above"):
    75	            if key in r and (isinstance(r[key], bool) or not isinstance(r[key], int | float)):
    76	                problems.append(f"{where}: {key} must be a number")
    77	        if metric_ids is not None and r.get("metric") not in metric_ids:
    78	            problems.append(f"{where}: unknown metric {r.get('metric')!r}")
    79	    if problems:
    80	        raise PolicyError(f"{source}: " + "; ".join(problems))
    81	
    82	
    83	def evaluate(metrics: list[Metric], policy: dict | None = None) -> PolicyResult:
    84	    policy = policy or load_policy()
    85	    by_id = {m.id: m for m in metrics}
    86	    validate(policy, metric_ids=set(by_id))
    87	    results: list[RuleResult] = []
    88	    for rule in policy["rules"]:
    89	        m = by_id[rule["metric"]]
    90	        req = f"rule requires {rule['op']} {rule['threshold']}"
    91	        if m.value is None:
    92	            outcome = RuleOutcome(rule.get("when_missing", "refer"))
    93	            detail = f"{m.name} cannot be computed ({m.method}); policy says {outcome.value} when missing."
    94	        else:
    95	            passed = OPS[rule["op"]](m.value, rule["threshold"])
    96	            if passed:
    97	                outcome = RuleOutcome.PASS
    98	                # Soft bands: close to the threshold still gets a human look.
    99	                if "refer_below" in rule and m.value < rule["refer_below"]:
   100	                    outcome = RuleOutcome.REFER
   101	                    req += f", referred below {rule['refer_below']}"
   102	                if "refer_above" in rule and m.value > rule["refer_above"]:
   103	                    outcome = RuleOutcome.REFER
   104	                    req += f", referred above {rule['refer_above']}"
   105	            else:
   106	                outcome = RuleOutcome(rule["on_fail"])
   107	            detail = f"{m.name} is {m.display()}; {req}."
   108	        results.append(
   109	            RuleResult(
   110	                rule_id=rule["id"], description=rule["description"], metric_id=m.id,
   111	                outcome=outcome, detail=detail, op=rule["op"], threshold=float(rule["threshold"]),
   112	                refer_below=rule.get("refer_below"), refer_above=rule.get("refer_above"), unit=m.unit,
   113	            )
   114	        )
   115	    if any(r.outcome == RuleOutcome.FAIL for r in results):
   116	        overall = RuleOutcome.FAIL
   117	    elif any(r.outcome == RuleOutcome.REFER for r in results):
   118	        overall = RuleOutcome.REFER
