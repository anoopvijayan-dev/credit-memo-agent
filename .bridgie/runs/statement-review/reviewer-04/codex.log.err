   130	def _stored_state_problem(values: dict) -> str | None:
   131	    """A stored review is only resumed if it still says what it said: the statement file
   132	    is unchanged and the stored memo still passes (or fails) the guard the same way."""
   133	    path = Path(values["statement_path"])
   134	    if not path.is_file():
   135	        return f"the statement {path} is no longer there"
   136	    if hashlib.sha256(path.read_bytes()).hexdigest() != values.get("statement_sha256"):
   137	        return f"the statement {path} has changed since the memo was drafted"
   138	    again = grd.check(values["memo"], values["metrics"], values["policy"], required_headings=grd.REQUIRED_HEADINGS)
   139	    if again.grounded != values["guard"].grounded:
   140	        return "the stored grounding result does not match the stored memo"
   141	    return None
