   204	
   205	
   206	def build(llm: LLM | None = None, checkpointer=None):
   207	    llm = llm or get_llm()
   208	
   209	    def load(s: MemoState) -> MemoState:
   210	        path = Path(s["statement_path"])
   211	        statement = ingest.load_csv(path)
   212	        return {
   213	            "statement": statement,
   214	            "statement_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
   215	            "model": f"{llm.name}:{getattr(llm, 'model', '-')}",
   216	            "offline_lock": firm.load().offline_lock,
   217	            "egress": "offline" if isinstance(llm, FakeLLM) else f"{llm.name}:{getattr(llm, 'model', '-')}",
   218	            # A run starts clean, even on a thread that has run before.
   219	            "redrafts": 0,
   220	            "guard_feedback": "",
   221	            "review": None,
   222	            "final_memo": None,
   223	        }
   224	
   225	    def categorise(s: MemoState) -> MemoState:
   226	        return {"statement": cat.categorise(s["statement"])}
   227	
   228	    def metrics(s: MemoState) -> MemoState:
   229	        return {"metrics": met.compute(s["statement"], vat_stagger=s.get("vat_stagger"))}
   230	
   231	    def policy(s: MemoState) -> MemoState:
   232	        p = pol.load_policy(Path(s["policy_path"])) if s.get("policy_path") else None
   233	        return {"policy": pol.evaluate(s["metrics"], p)}
   234	
   235	    def draft(s: MemoState) -> MemoState:
   236	        user = draft_prompt(s["statement"], s["metrics"], s["policy"], s.get("guard_feedback", ""))
   237	        return {"memo": llm.complete(SYSTEM_PROMPT, user), "redrafts": s.get("redrafts", 0)}
   238	
   239	    def guard(s: MemoState) -> MemoState:
   240	        g = grd.check(s["memo"], s["metrics"], s["policy"], required_headings=grd.REQUIRED_HEADINGS)
   241	        feedback = ""
   242	        if not g.grounded:
   243	            parts = [f"- {f.number_text}: {f.reason}" for f in g.unmatched]
   244	            parts += [f"- {mid} quoted without its tag" for mid in g.missing_citations]
   245	            feedback = "\n".join(parts)
   246	        return {"guard": g, "guard_feedback": feedback}
   247	
   248	    def route_after_guard(s: MemoState) -> str:
   249	        if s["guard"].grounded or s.get("redrafts", 0) >= MAX_REDRAFTS:
   250	            return "review"
   251	        return "redraft"
   252	
   253	    def redraft(s: MemoState) -> MemoState:
   254	        return {"redrafts": s.get("redrafts", 0) + 1}
   255	
   256	    def review(s: MemoState) -> MemoState:
   257	        """Stop for a named human. An invalid decision is not an error: ask again, saying why.
   258	
   259	        Each refusal is a fresh interrupt, so LangGraph replays earlier answers in order
   260	        and the reviewer can always correct theirs.
   261	        """
   262	        payload = {
   263	            "memo": s["memo"],
   264	            "policy_outcome": s["policy"].overall.value,
   265	            "guard_grounded": s["guard"].grounded,
   266	            "guard_unmatched": [f.number_text or f.reason for f in s["guard"].unmatched],
   267	            "guard_missing_citations": s["guard"].missing_citations,
   268	            "question": "Approve this memo for the credit file?",
   269	            "error": None,
   270	        }
   271	        while True:
   272	            decision = interrupt(payload)
   273	            problem = _review_problem(decision, s["guard"].grounded)
   274	            if problem is None:
   275	                return {"review": ReviewDecision(**decision)}
   276	            payload = {**payload, "error": problem}
   277	
   278	    def finalise(s: MemoState) -> MemoState:
   279	        r, g = s["review"], s["guard"]
   280	        if g.grounded:
   281	            grounding = "passed"
   282	        elif r.approved:
   283	            grounding = "overridden by reviewer"
   284	        else:
   285	            grounding = "failed"
     1	"""MCP server exposing the deterministic layers as tools.
     2	
     3	Lets any MCP client (Claude Desktop, an n8n agent node, another LangGraph graph) ask
     4	for metrics or a policy result without ever touching the arithmetic itself.
     5	
     6	Run:  python -m cma.mcp_server
     7	
     8	Files: tools only read files under CMA_DATA_DIR, which must be set (MCP hosts often
     9	start servers with the working directory at / or ~, so there is no default), and only
    10	.csv statements and .yaml/.yml policies. A refused statement is reported by line
    11	number only; cell values are never echoed to the client.
    12	
    13	Descriptions: statement descriptions are text the payer chose ("IGNORE PREVIOUS
    14	INSTRUCTIONS..."). `transactions_for` leaves them out unless the caller asks, and then
    15	returns them marked as untrusted data.
    16	
    17	Offline lock: the server is a way for data to reach a model, so it refuses to start
    18	while offline_lock is on in firm.yaml (the default).
    19	"""
    20	
    21	from __future__ import annotations
    22	
    23	import os
    24	from pathlib import Path
    25	
    26	from mcp.server.mcpserver import MCPServer
    27	
    28	from . import categorise, firm, ingest, metrics, policy
    29	
    30	server = MCPServer("credit-memo-agent")
    31	
    32	
    33	def data_dir() -> Path:
    34	    raw = os.environ.get("CMA_DATA_DIR")
    35	    if not raw:
    36	        raise ValueError("CMA_DATA_DIR is not set; set it to the folder of statements this server may read")
    37	    return Path(raw).resolve()
    38	
    39	
    40	def safe_path(raw: str, suffixes: tuple[str, ...]) -> Path:
    41	    """Resolve `raw` inside the data directory, or refuse."""
    42	    root = data_dir()
    43	    p = Path(raw)
    44	    p = (p if p.is_absolute() else root / p).resolve()
    45	    if not p.is_relative_to(root):
    46	        raise ValueError(f"{raw}: outside the data directory {root} (set CMA_DATA_DIR)")
    47	    if p.suffix.lower() not in suffixes:
    48	        raise ValueError(f"{raw}: only {', '.join(suffixes)} files can be read")
    49	    if not p.is_file():
    50	        raise ValueError(f"{raw}: no such file")
    51	    return p
    52	
    53	
    54	def _statement(path: str):
    55	    p = safe_path(path, (".csv",))
    56	    try:
    57	        return ingest.load_csv(p)
    58	    except ingest.StatementError as e:
    59	        lines = sorted({x.split(":", 1)[0] for x in e.problems})
    60	        raise ValueError(f"{path}: statement refused, {len(e.problems)} problem(s) on {', '.join(lines[:10])}; "
    61	                         "run `cma run` locally to see them") from None
    62	
    63	
    64	@server.tool()
    65	def statement_summary(path: str) -> dict:
    66	    """Load a statement CSV and return account name, period and transaction count."""
    67	    s = _statement(path)
    68	    return {
    69	        "account_name": s.account_name,
    70	        "start": s.start.isoformat(),
    71	        "end": s.end.isoformat(),
    72	        "transactions": len(s.transactions),
    73	    }
    74	
    75	
    76	@server.tool()
    77	def compute_metrics(path: str, vat_stagger: int | None = None) -> list[dict]:
    78	    """Categorise a statement and compute the cited metrics table (M1..M16).
    79	    vat_stagger is the HMRC stagger group (1, 2 or 3); without it M13 is n/a."""
    80	    s = categorise.categorise(_statement(path))
    81	    return [m.model_dump() for m in metrics.compute(s, vat_stagger=vat_stagger)]
    82	
    83	
    84	@server.tool()
    85	def check_policy(path: str, policy_path: str | None = None, vat_stagger: int | None = None) -> dict:
    86	    """Run the lending policy against a statement and return pass/refer/fail per rule."""
    87	    s = categorise.categorise(_statement(path))
    88	    p = policy.load_policy(safe_path(policy_path, (".yaml", ".yml"))) if policy_path else None
    89	    return policy.evaluate(metrics.compute(s, vat_stagger=vat_stagger), p).model_dump()
    90	
    91	
    92	@server.tool()
    93	def transactions_for(path: str, ids: list[str], include_descriptions: bool = False) -> list[dict]:
    94	    """Return the statement lines behind a metric's evidence ids, so a reviewer can check a
    95	    figure. Descriptions are payer-written text; they are only included when asked for,
    96	    and then under `untrusted_description`."""
    97	    by_id = _statement(path).by_id()
    98	    out = []
    99	    for i in ids:
   100	        if i not in by_id:
   101	            continue
   102	        t = by_id[i]
   103	        row = {"id": t.id, "date": t.date.isoformat(), "amount": t.amount, "balance": t.balance,
   104	               "category": t.category.value if t.category else None}
   105	        if include_descriptions:
   106	            row["untrusted_description"] = t.description
   107	        out.append(row)
   108	    return out
   109	
   110	
   111	def main() -> None:
   112	    try:
   113	        firm.load().require_offline_off("Starting the MCP server")
   114	    except (firm.OfflineLockError, firm.FirmConfigError) as e:
   115	        raise SystemExit(str(e)) from None
   116	    data_dir()  # refuse to start without CMA_DATA_DIR
   117	    server.run()
   118	
   119	
   120	if __name__ == "__main__":
   121	    main()
    75	
    76	
    77	class AnthropicLLM:
    78	    name = "anthropic"
    79	
    80	    def __init__(self, model: str | None = None):
    81	        firm.load().require_offline_off("A hosted model (anthropic)")
    82	        import anthropic
    83	
    84	        self.client = anthropic.Anthropic(timeout=120.0, max_retries=2)
    85	        self.model = model or os.getenv("CMA_ANTHROPIC_MODEL", "claude-sonnet-5-5")
    86	
    87	    def complete(self, system: str, user: str) -> str:
    88	        msg = self.client.messages.create(
    89	            model=self.model,
    90	            max_tokens=2000,
    91	            system=system,
    92	            messages=[{"role": "user", "content": user}],
    93	        )
    94	        if msg.stop_reason == "max_tokens":
    95	            raise LLMError("the model's reply was cut off at the token limit")
    96	        return "".join(block.text for block in msg.content if getattr(block, "type", "") == "text")
    97	
    98	
    99	class OpenAILLM:
   100	    name = "openai"
   101	
   102	    def __init__(self, model: str | None = None):
   103	        firm.load().require_offline_off("A hosted model (openai)")
   104	        from openai import OpenAI
   105	
   106	        self.client = OpenAI(timeout=120.0, max_retries=2)
   107	        self.model = model or os.getenv("CMA_OPENAI_MODEL", "gpt-4.1")
   108	
   109	    def complete(self, system: str, user: str) -> str:
   110	        r = self.client.chat.completions.create(
   111	            model=self.model,
   112	            messages=[{"role": "system", "content": system}, {"role": "user", "content": user}],
   113	        )
   114	        if r.choices[0].finish_reason == "length":
   115	            raise LLMError("the model's reply was cut off at the token limit")
   116	        return r.choices[0].message.content or ""
   117	
   118	
   119	def get_llm(name: str | None = None) -> LLM:
   120	    name = (name or os.getenv("CMA_LLM", "fake")).lower()
   121	    if name == "fake":
   122	        return FakeLLM()
   123	    if name == "anthropic":
   124	        return AnthropicLLM()
   125	    if name == "openai":
   126	        return OpenAILLM()
   127	    raise ValueError(f"unknown LLM provider {name!r}")
   165	        parsed.append((d, t, tid, desc, amount, bal))
   166	
   167	    parsed.sort(key=lambda x: (x[0], x[1], x[2]))
   168	    first = parsed[0]
   169	    implied = round(first[5] - first[4], 2) if first[5] is not None else None
   170	    if opening_balance is None:
   171	        if implied is None:
   172	            raise MonzoImportError("first row has no Balance; pass --opening-balance")
   173	        opening_balance = implied
   174	        source = "Monzo Balance column"
   175	    else:
   176	        if implied is not None and abs(implied - opening_balance) > 0.005:
   177	            raise MonzoImportError(
   178	                f"--opening-balance {opening_balance:.2f} disagrees with Monzo's Balance column, "
   179	                f"which implies {implied:.2f}; leave --opening-balance out to use Monzo's"
   180	            )
   181	        source = "opening balance supplied"
   182	
   183	    out_rows = []
   184	    bal = opening_balance
   185	    for d, _t, tid, desc, amount, monzo_bal in parsed:
   186	        bal = round(bal + amount, 2)
   187	        if monzo_bal is not None and abs(monzo_bal - bal) > 0.005:
   188	            raise MonzoImportError(
   189	                f"{tid}: walked balance {bal:.2f} disagrees with Monzo's {monzo_bal:.2f}; "
   190	                "the export may be missing transactions"
   191	            )
   192	        out_rows.append({"id": tid, "date": d.isoformat(), "description": desc,
   193	                         "amount": f"{amount:.2f}", "balance": f"{bal:.2f}"})
   194	
   195	    Path(dst).parent.mkdir(parents=True, exist_ok=True)
   196	    with Path(dst).open("w", newline="") as f:
   197	        w = csv.DictWriter(f, fieldnames=["id", "date", "description", "amount", "balance"])
   198	        w.writeheader()
   199	        w.writerows(out_rows)
   200	    return ImportResult(
   201	        rows=len(out_rows), start=parsed[0][0], end=parsed[-1][0],
   202	        opening_balance=opening_balance, closing_balance=bal,
   203	        balance_source=source, skipped_non_gbp=skipped,
   204	    )
