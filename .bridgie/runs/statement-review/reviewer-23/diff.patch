+    category: hmrc_vat
+    protected: true
+  - id: hmrc_paye
+    pattern: 'HMRC PAYE'
+    unless: *pot_move
+    direction: out
+    category: hmrc_paye
+    protected: true
+  # HMRC paying money back (VAT repayment, tax refund, R&D credit).
+  - id: hmrc_repayment
+    names: [HMRC, HM REVENUE]
+    unless: *pot_move
+    direction: in
+    category: hmrc_repayment
+    protected: true
+  # UK business lenders and merchant cash advance providers, named. Before the director
+  # and capital wording, so "STRIPE CAPITAL" and "BOOST CAPITAL" are lenders.
+  - id: lender_repayment
+    names: &lenders
+      - FUNDING CIRCLE
+      - IWOCA
+      - YOULEND
+      - LIBERIS
+      - 365 BUSINESS FINANCE
+      - CAPIFY
+      - BOOST CAPITAL
+      - FLEXIMIZE
+      - MARKETFINANCE
+      - MARKET FINANCE
+      - NUCLEUS COMMERCIAL FINANCE
+      - ESME LOANS
