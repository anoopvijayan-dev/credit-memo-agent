+    direction: out
+    category: loan_repayment
+    protected: true
+  # A named lender's explicit refund or reversal ("DD REPAYMENT REVERSAL IWOCA LTD") is
+  # money given back, not a new drawdown. Still protected: a lender line (R21).
+  - id: lender_refund
+    names: *lenders
+    requires: &refund_wording '(?<![A-Z0-9])(?:REFUND|REFUNDED|REVERSAL|REVERSED|RETURNED\s+PAYMENT|PAYMENT\s+RETURNED|CHARGEBACK)(?![A-Z0-9])'
+    unless: *pot_move
