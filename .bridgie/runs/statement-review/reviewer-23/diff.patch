+    ([{**GOOD, "names": []}], "names must be"),
+    ([{**GOOD, "names": "STRIPE"}], "names must be"),
+    ([{**GOOD, "names": ["STRIPE", " "]}], "names must be"),
+    ([{**GOOD, "names": ["STRIPE", "stripe"]}], "listed twice"),
+    ([{**GOOD, "unless": "("}], "unless does not compile"),
