+      - SUM UP
+      - SQUARE UK
+      - SQUARE EUROPE
+      - SQUARE PAYMENTS
+      - ZETTLE
+      - IZETTLE
+      - WORLDPAY
+      - BARCLAYCARD MERCHANT
+      - BARCLAYCARD PAYMENT ACCEPTANCE
+      - ELAVON
+      - GLOBAL PAYMENTS
+      - GLOBALPAYMENTS
+      - CARDNET
+      - TAKEPAYMENTS
+      - DOJO
+      - PAYMENTSENSE
+      - TEYA
+      - SALTPAY
+      - ADYEN
+      - CHECKOUT.COM
+      - CHECKOUT COM
+      - TRUST PAYMENTS
+      - FISERV
+      - FIRST DATA
+      - VIVA WALLET
+      - MYPOS
+      - EVO PAYMENTS
+      - HANDEPAY
+      - TOTAL PROCESSING
+    direction: in
+    category: revenue_card_settlement
+  - id: payment_gateways
+    names:
+      - STRIPE
+      - PAYPAL
+      - GOCARDLESS
+      - OPAYO
+      - SAGEPAY
+      - SAGE PAY
+      - BRAINTREE
+      - KLARNA
+      - CLEARPAY
+      - PAYSAFE
+    direction: in
+    category: revenue_card_settlement
+  # Marketplace payouts. Amazon by its payout entities only: a plain AMAZON credit is
+  # usually a refund on a purchase, and stays for a person to look at.
+  - id: marketplaces
+    names:
+      - AMAZON PAYMENTS
+      - AMAZON EU
+      - AMAZON SERVICES EUROPE
+      - AMZN PAYMENTS
+      - AMZN MKTP PAYOUT
+      - EBAY
+      - ETSY
+      - NOT ON THE HIGH STREET
+      - NOTHS
+      - ONBUY
