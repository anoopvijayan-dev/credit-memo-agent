   487	def link_reversals(statement: Statement) -> Statement:
   488	    """Point each returned DD credit at the most recent unreversed debit it undoes.
   489	
   490	    Same amount, same payee, on or before the reversal date. A returned DD with no
   491	    amount (some banks print a zero-value notice) or no matching debit stays unlinked:
   492	    it still counts in M7 but changes no sum.
   493	    """
   494	    taken: set[str] = set()
   495	    txns = statement.transactions
   496	    for i, r in enumerate(txns):
   497	        if r.category != Category.RETURNED_DD or r.amount <= 0:
   498	            continue
   499	        payee = counterparty(r.description)
   500	        for o in reversed(txns[:i]):
   501	            if (
   502	                o.id not in taken
   503	                and o.amount < 0
   504	                and o.category not in (Category.RETURNED_DD, None)
   505	                and abs(o.amount + r.amount) < 0.005
   506	                and counterparty(o.description) == payee
   507	            ):
   508	                r.reverses = o.id
   509	                taken.add(o.id)
   510	                break
   511	    return statement
   512	
   513	
   514	OUTGOING_TRANSFER = re.compile(r"^(?:FPS DEBIT|BACS DEBIT|TFR)\b")
   515	
   516	
   517	def unmark_round_trips(statement: Statement, ruleset_id: str | None = None) -> Statement:
   518	    """A "customer" the applicant also sends transfers to is not counted as revenue.
   519	
   520	    Money sent out by transfer and received back with an invoice reference is the
   521	    cheapest way to manufacture revenue. Such credits become OTHER (and so show in M16).
   522	    This also catches a genuine customer who is paid a refund by transfer: the cost is
   523	    understated revenue, which a person can add back; the alternative is gameable.
   524	
   525	    Only a category the built-in table set is undone: a person's override, a profile name
   526	    or a firm rule ranks above the table and is left alone.
   527	    """
   528	    paid_out = {counterparty(t.description) for t in statement.transactions
   529	                if t.amount < 0 and OUTGOING_TRANSFER.search(t.description.upper())}
   530	    for t in statement.transactions:
   531	        set_by_table = ruleset_id is None or (t.rule_id or "").startswith(f"{ruleset_id}:")
   532	        if t.category == Category.REVENUE_TRANSFER and counterparty(t.description) in paid_out and set_by_table:
   533	            t.category = Category.OTHER
   534	            if ruleset_id is not None:
   535	                t.rule_id = f"{ruleset_id}:round_trip"
   536	    return statement
   537	
   538	
   539	def categorise(
   540	    statement: Statement,
   541	    ruleset: Ruleset | None = None,
   542	    *,
   543	    overrides: Mapping[str, LineOverride] | None = None,
   544	    profile: ProfileNames | None = None,
   545	    firm_rules: Sequence[Rule] = (),
   546	) -> Statement:
   547	    ruleset = ruleset or active_ruleset()
   548	    overrides = overrides or {}
   549	    for t in statement.transactions:
   550	        t.category, t.rule_id = classify(t, ruleset, override=overrides.get(t.id), profile=profile,
   551	                                         firm_rules=firm_rules)
   552	        t.reverses = None
   553	    return link_reversals(unmark_round_trips(statement, ruleset.id))
