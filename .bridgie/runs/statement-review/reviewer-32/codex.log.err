   477	def counterparty(description: str) -> str:
   478	    """Who is on the other side of a line: the description without the payment rail,
   479	    a trailing " DD", invoice numbers or other references with digits in them. One
   480	    normaliser for reversal matching, round-trip detection and concentration (M15)."""
   481	    d = RAIL_PREFIX.sub("", description.upper())
   482	    d = re.sub(r"\s+DD$", "", d)
   483	    d = REFERENCE_TOKEN.sub(" ", d)
   484	    return " ".join(d.split()) or description.upper().strip()
