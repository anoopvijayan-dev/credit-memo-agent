+
+def _classify_credit(t: Transaction, desc: str, ruleset: Ruleset, profile: ProfileNames | None,
+                     firm_rules: Sequence[Rule]) -> tuple[Category, str]:
+    """Design C1's precedence for a credit, after the override: (2) a protected verdict,
+    (3) a profile name, (4) an ambiguous verdict, (5) firm rules, (6) an unprotected
+    verdict, (7) the default. Only (3) and an override settle an ambiguous credit."""
+    verdict = credit_verdict(ruleset, desc, t.amount)
+    if verdict is not None and not verdict.ambiguous and verdict.rule.protected:
+        return verdict.rule.category, f"{ruleset.id}:{verdict.rule.id}"
+    found = _profile(t, desc, profile)
+    if found:
+        return found
+    if verdict is not None and verdict.ambiguous:
+        return Category.OTHER, f"{ruleset.id}:conflict:" + "+".join(r.id for r in verdict.rules)
+    for rule in firm_rules:
+        if rule_matches(rule, desc, t.amount):
+            return rule.category, f"firm:{rule.id}"
+    if verdict is not None:
+        return verdict.rule.category, f"{ruleset.id}:{verdict.rule.id}"
+    return Category.OTHER, f"{ruleset.id}:default"
+
+
+def categorise_one(t: Transaction, ruleset: Ruleset | None = None) -> Category:
+    return classify(t, ruleset)[0]
 
 
 RAIL_PREFIX = re.compile(
@@ -265,25 +514,40 @@ def link_reversals(statement: Statement) -> Statement:
 OUTGOING_TRANSFER = re.compile(r"^(?:FPS DEBIT|BACS DEBIT|TFR)\b")
 
 
-def unmark_round_trips(statement: Statement) -> Statement:
+def unmark_round_trips(statement: Statement, ruleset_id: str | None = None) -> Statement:
     """A "customer" the applicant also sends transfers to is not counted as revenue.
 
     Money sent out by transfer and received back with an invoice reference is the
     cheapest way to manufacture revenue. Such credits become OTHER (and so show in M16).
     This also catches a genuine customer who is paid a refund by transfer: the cost is
     understated revenue, which a person can add back; the alternative is gameable.
+
+    Only a category the built-in table set is undone: a person's override, a profile name
+    or a firm rule ranks above the table and is left alone.
     """
     paid_out = {counterparty(t.description) for t in statement.transactions
                 if t.amount < 0 and OUTGOING_TRANSFER.search(t.description.upper())}
     for t in statement.transactions:
-        if t.category == Category.REVENUE_TRANSFER and counterparty(t.description) in paid_out:
+        set_by_table = ruleset_id is None or (t.rule_id or "").startswith(f"{ruleset_id}:")
+        if t.category == Category.REVENUE_TRANSFER and counterparty(t.description) in paid_out and set_by_table:
             t.category = Category.OTHER
+            if ruleset_id is not None:
+                t.rule_id = f"{ruleset_id}:round_trip"
     return statement
 
 
-def categorise(statement: Statement, ruleset: Ruleset | None = None) -> Statement:
+def categorise(
+    statement: Statement,
+    ruleset: Ruleset | None = None,
+    *,
+    overrides: Mapping[str, LineOverride] | None = None,
+    profile: ProfileNames | None = None,
+    firm_rules: Sequence[Rule] = (),
+) -> Statement:
     ruleset = ruleset or active_ruleset()
+    overrides = overrides or {}
     for t in statement.transactions:
-        t.category = categorise_one(t, ruleset)
+        t.category, t.rule_id = classify(t, ruleset, override=overrides.get(t.id), profile=profile,
+                                         firm_rules=firm_rules)
         t.reverses = None
-    return link_reversals(unmark_round_trips(statement))
+    return link_reversals(unmark_round_trips(statement, ruleset.id))
diff --git a/src/cma/graph.py b/src/cma/graph.py
index 8e788f0..1824f50 100644
--- a/src/cma/graph.py
+++ b/src/cma/graph.py
@@ -185,6 +185,28 @@ def ruleset_used(s: MemoState) -> dict:
     return {"id": v1.id, "sha256": v1.sha256, "inferred": "pre-ruleset checkpoint"}
 
 
+def line_rule_ids(s: MemoState) -> list[str | None]:
+    """Each line's rule id. A checkpoint from before provenance holds none: either no
+    ruleset at all (before T01; the lines were categorised by the table that is now v1,
+    P7) or a recorded ruleset with no rule ids on the lines (T02). The table the state
+    names, or v1 when it names none, is replayed on a copy, provided the installed table
+    has the recorded hash, and its rule id taken for each line whose saved category it
+    reproduces. A line it does not reproduce keeps None rather than a rule that did not
+    set it."""
+    txns = s["statement"].transactions
+    if all(t.rule_id for t in txns):
+        return [t.rule_id for t in txns]
+    recorded = s.get("ruleset") or {}
+    try:
+        table = cat.load_ruleset(recorded.get("id") or "v1")
+    except cat.RulesetError:
+        return [t.rule_id for t in txns]
+    if recorded.get("sha256") and recorded["sha256"] != table.sha256:
+        return [t.rule_id for t in txns]  # not the table that categorised these lines
+    replay = cat.categorise(s["statement"].model_copy(deep=True), table).transactions
+    return [t.rule_id or (r.rule_id if r.category == t.category else None) for t, r in zip(txns, replay, strict=True)]
+
+
 def evidence_record(s: MemoState) -> dict:
     """Everything needed to audit the memo later, as plain JSON."""
     return {
@@ -195,6 +217,10 @@ def evidence_record(s: MemoState) -> dict:
         "model": s.get("model"),
         "vat_stagger": s.get("vat_stagger"),
         "ruleset": ruleset_used(s),
+        # Each line's category and the rule that set it: ids only, no descriptions.
+        "lines": [{"id": t.id, "category": t.category.value if t.category else None, "rule_id": rule_id,
+                   "reverses": t.reverses} for t, rule_id in zip(s["statement"].transactions, line_rule_ids(s),
+                                                                 strict=True)],
         "metrics": [m.model_dump() for m in s["metrics"]],
         "policy": s["policy"].model_dump(mode="json"),
         "guard": {**s["guard"].model_dump(), "grounded": s["guard"].grounded},
diff --git a/src/cma/metrics.py b/src/cma/metrics.py
index a294efe..ec65010 100644
--- a/src/cma/metrics.py
+++ b/src/cma/metrics.py
@@ -23,6 +23,12 @@ from .models import REVENUE_CATEGORIES, Category, Metric, Statement, Transaction
 VAT_STAGGERS: dict[int, tuple[int, ...]] = {1: (3, 6, 9, 12), 2: (1, 4, 7, 10), 3: (2, 5, 8, 11)}
 VAT_DD_WORKING_DAYS = 3  # HMRC collects by Direct Debit up to three working days after the due date.
 FINANCING = {Category.LOAN_REPAYMENT, Category.LOAN_DRAWDOWN, Category.OWNER_DRAWINGS}
+# Money in that is neither trading receipts, a lending drawdown nor a returned DD. Under v1
+# every such credit is OTHER; v2 names some of them (director funding, own pots, refunds,
+# HMRC, grants), and M9 and M16 treat them all as v1 treats OTHER, so naming a credit
