    65	def pytest_sessionfinish(session):
    66	    """Every statement file the suite wrote, found by walking its temporary directories."""
    67	    base = session.config._tmp_path_factory.getbasetemp()
    68	    for path in sorted(p for p in base.rglob("*") if p.is_file()):
    69	        try:
    70	            statement = _orig_load_csv(path)
    71	        except Exception:  # not a five-column statement, or one the loader refuses
    72	            continue
    73	        _record(statement, None, loaded=True)
