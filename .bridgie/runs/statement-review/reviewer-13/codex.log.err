+++ b/src/cma/rules/v1.yaml
@@ -0,0 +1,60 @@
+# Built-in categorisation table v1: the table as it was in src/cma/categorise.py before
+# it moved to data. Frozen: CMA_RULESET=v1 must reproduce today's categories and M1-M16
+# exactly (tests/test_rules.py, P7). Change a newer table, never this one.
+#
+# Rules are ordered; the first whose pattern matches the upper-cased description and
+# whose direction matches the sign of the amount wins. No match: a debit is supplier,
+# a credit is other. Patterns are Python regular expressions; direction is in, out or
+# any; category is a cma.models.Category value.
+id: v1
+frozen: true
+rules:
+  - id: returned_dd
+    pattern: '^UNPAID DD\b'
+    direction: any
+    category: returned_dd
+  - id: bank_fees
+    pattern: 'UNPAID ITEM FEE|ACCOUNT FEES|BANK CHARGES'
+    direction: out
+    category: bank_fees
+  - id: hmrc_vat
+    pattern: 'HMRC VAT'
+    direction: out
+    category: hmrc_vat
+  - id: hmrc_paye
+    pattern: 'HMRC PAYE'
+    direction: out
+    category: hmrc_paye
+  - id: payroll
+    pattern: 'PAYROLL|SALARIES'
+    direction: out
+    category: payroll
+  - id: rent
+    pattern: '\bRENT\b'
+    direction: out
+    category: rent
+  - id: loan_repayment
+    pattern: '\bLOAN\b|FINANCE\b'
+    direction: out
+    category: loan_repayment
+  - id: loan_drawdown
+    pattern: '\bLOAN\b|FINANCE\b'
+    direction: in
+    category: loan_drawdown
+  - id: owner_drawings
+    pattern: 'OWNER DRAWINGS|DIRECTOR DRAWINGS|DIVIDEND'
+    direction: out
+    category: owner_drawings
+  # Money in that is never trading income, whatever reference it carries.
+  - id: non_trading_in
+    pattern: '\bDIRECTOR\b|\bOWNER\b|\bCAPITAL\b|\bSHAREHOLDER\b|\bHMRC\b|\bREFUND\b|\bREVERSAL\b|\bSAVINGS\b|\bPOT TRANSFER\b|\bINTEREST\b|\bGRANT\b|\bINSURANCE CLAIM\b'
+    direction: in
+    category: other
+  - id: card_settlement
+    pattern: 'ACQUIRER SETTLEMENT|PAYGATE PAYOUT|CARD SETTLEMENT'
+    direction: in
+    category: revenue_card_settlement
+  - id: invoice_transfer
+    pattern: '\bINV(?:OICE)?\s*[-#:]?\s*\d+'
+    direction: in
+    category: revenue_transfer
diff --git a/tests/golden/p7_tools/capture_plugin.py b/tests/golden/p7_tools/capture_plugin.py
new file mode 100644
index 0000000..126d48b
--- /dev/null
+++ b/tests/golden/p7_tools/capture_plugin.py
@@ -0,0 +1,86 @@
+"""pytest plugin: record every statement the test suite computes metrics on or categorises
+as a whole, and every (description, amount) the categoriser sees, using the code as it is
+*before* T01. A statement categorised but never passed to metrics.compute is recorded
+too, with no VAT stagger, so make_p7_baseline.py gives it an M1-M16 baseline (verify-10:
+the two-credit Monzo invoice fixture was otherwise captured only as single lines). So is
+every statement ingest.load_csv returns, before any category is set, marked "loaded" so
+the baseline categorises it with the rule table (verify-11: the newest-first and
+byte-order-mark fixtures in tests/test_ingest.py are only loaded). And, so that no
+fixture depends on which function its test happens to call, every file left in the
+session's temporary directories that ingest.load_csv accepts is recorded the same way
+(verify-12: the Monzo balance-column conversion writes a statement no test loads).
+Output: $CAPTURE_OUT (JSON)."""
+
+import atexit
+import json
+import os
+
+from cma import categorise, ingest, metrics
+
+STATEMENTS: dict[str, dict] = {}
+LINES: dict[tuple[str, float], str] = {}
+
+_orig_compute = metrics.compute
+_orig_one = categorise.categorise_one
+_orig_categorise = categorise.categorise
+_orig_load_csv = ingest.load_csv
+
+
+def _record(statement, vat_stagger, loaded=False):
+    s = statement.model_dump(mode="json")
+    key = json.dumps([s, vat_stagger, loaded], sort_keys=True)
+    STATEMENTS[key] = {"statement": s, "vat_stagger": vat_stagger, "loaded": loaded}
+
+
+def _one(t):
+    c = _orig_one(t)
+    LINES[(t.description, t.amount)] = c.value
+    return c
+
+
+def _compute(statement, vat_stagger=None):
+    out = _orig_compute(statement, vat_stagger=vat_stagger)
+    _record(statement, vat_stagger)
+    return out
+
+
+def _categorise(statement):
+    out = _orig_categorise(statement)
+    _record(out, None)
+    return out
+
+
+def _load_csv(*args, **kwargs):
+    out = _orig_load_csv(*args, **kwargs)
+    _record(out, None, loaded=True)
+    return out
+
+
+ingest.load_csv = _load_csv
+categorise.categorise_one = _one
+categorise.categorise = _categorise
+metrics.compute = _compute
+
+
+def pytest_sessionfinish(session):
+    """Every statement file the suite wrote, found by walking its temporary directories."""
+    base = session.config._tmp_path_factory.getbasetemp()
+    for path in sorted(p for p in base.rglob("*") if p.is_file()):
+        try:
+            statement = _orig_load_csv(path)
+        except Exception:  # not a five-column statement, or one the loader refuses
+            continue
+        _record(statement, None, loaded=True)
+
+
+@atexit.register
+def _dump():
+    path = os.environ["CAPTURE_OUT"]
+    with open(path, "w") as f:
+        json.dump(
+            {
+                "statements": list(STATEMENTS.values()),
+                "lines": [{"description": d, "amount": a, "category": c} for (d, a), c in LINES.items()],
+            },
+            f,
+        )
diff --git a/tests/golden/p7_tools/make_p7_baseline.py b/tests/golden/p7_tools/make_p7_baseline.py
new file mode 100644
index 0000000..c0987ba
--- /dev/null
+++ b/tests/golden/p7_tools/make_p7_baseline.py
@@ -0,0 +1,144 @@
+"""Build tests/golden/p7_v1_baseline.json from the code as it was BEFORE T01.
+
+Run from a checkout of the pre-change commit (fd7b64c), with the capture produced by
+capture_plugin.py (every statement the test suite loads, computes metrics on or
+categorises as a whole, and every line the categoriser sees). Install the durable extra so no capturing test is skipped.
+From the worktree root, with S a scratch directory:
+
+    git archive fd7b64c | tar -x -C $S/old
+    cd $S/old && PYTHONDONTWRITEBYTECODE=1 CAPTURE_OUT=$S/capture.json \
+        PYTHONPATH=$S/old/src:<worktree>/tests/golden/p7_tools python -m pytest -q -p capture_plugin
+    MADE_AT=fd7b64c PYTHONPATH=$S/old/src python <worktree>/tests/golden/p7_tools/make_p7_baseline.py \
+        $S/capture.json $S/p7.json
+    # then compare $S/p7.json with gunzip < tests/golden/p7_v1_baseline.json.gz: every key equal
+
+tests/test_p7_history.py runs exactly these steps and the comparison.
+
+Committed statement files are found by globbing tests/ and examples/ for *.csv, not
+listed by hand.
+"""
+
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+from datetime import date
+from pathlib import Path
+
+from cma import categorise, ingest, metrics, synth
+from cma.models import Statement
+
+SYNTH_CASES = [
+    *[(a, p, 7, 12, "2026-09-30") for a in synth.ARCHETYPES for p in synth.PROFILES],
+    ("cafe", "stretched", 3, 12, "2026-09-30"),
+    ("cafe", "good", 7, 3, "2026-09-30"),
+    ("cafe", "poor", 7, 4, "2026-09-30"),
+    ("cafe", "poor", 7, 2, "2026-09-30"),
+]
+
+
+def statement_files(root: Path = Path(".")) -> list[str]:
+    """Every committed statement file under tests/ and examples/."""
+    return sorted(p.relative_to(root).as_posix() for d in ("tests", "examples") for p in (root / d).rglob("*.csv"))
+
+
+def sha(text: str) -> str:
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def categories_sha(s: Statement) -> str:
+    return sha("\n".join(f"{t.id}|{t.category.value}|{t.reverses or ''}" for t in s.transactions))
+
+
+def metric_rows(s: Statement, vat_stagger):
+    return [
+        {"id": m.id, "unit": m.unit, "value": m.value, "evidence_n": len(m.evidence),
+         "evidence_sha256": sha("\n".join(m.evidence))}
+        for m in metrics.compute(s, vat_stagger=vat_stagger)
+    ]
+
+
+def rows_key(s: dict, vat_stagger) -> str:
+    """A statement's lines AND the VAT stagger its figures were computed with: the same
+    lines under another stagger give another M13, so they are another case (verify-01
+    found the stagger-3 run of a fixture dropped because only its lines were compared)."""
+    return json.dumps([[[t["id"], t["date"], t["description"], t["amount"], t["balance"]]
+                        for t in s["transactions"]], vat_stagger])
+
+
+def main(capture_path: str, out_path: str) -> None:
+    cap = json.loads(Path(capture_path).read_text())
+    out: dict = {
+        "_about": (
+            "P7 baseline: M1-M16 (id, unit, value, evidence) and categories, computed by the "
+            "categoriser as it was before the rule table moved to src/cma/rules/ (T01). "
+            "Under CMA_RULESET=v1 every entry must be reproduced exactly. Built by "
+            "tests/golden/p7_tools/make_p7_baseline.py from the pre-change commit; do not "
+            "regenerate from newer code."
+        ),
+        "made_at_commit": os.environ.get("MADE_AT") or subprocess.check_output(["git", "rev-parse", "--short", "HEAD"], text=True).strip(),
+        "synthetic": [], "examples": [], "fixtures": [], "lines": [],
+    }
+    seen_rows: set[str] = set()
+    for archetype, profile, seed, months, end in SYNTH_CASES:
+        rows, truth = synth.generate(archetype, profile, seed=seed, months=months, end=date.fromisoformat(end))
+        with tempfile.TemporaryDirectory() as d:
+            csv_path, _ = synth.write(rows, truth, Path(d), stem="s")
+            raw = csv_path.read_bytes()
+            s = categorise.categorise(ingest.load_csv(csv_path))
+        for v in (None, truth.vat_stagger):
+            seen_rows.add(rows_key(s.model_dump(mode="json"), v))
+        out["synthetic"].append({
+            "archetype": archetype, "profile": profile, "seed": seed, "months": months, "end": end,
+            "csv_sha256": hashlib.sha256(raw).hexdigest(),
+            "categories_sha256": categories_sha(s),
+            "metrics": {str(v): metric_rows(s, v) for v in (None, truth.vat_stagger)},
+        })
+    for p in statement_files():
+        s = categorise.categorise(ingest.load_csv(Path(p)))
+        for v in (None, 3):
+            seen_rows.add(rows_key(s.model_dump(mode="json"), v))
+        out["examples"].append({
+            "path": p, "file_sha256": hashlib.sha256(Path(p).read_bytes()).hexdigest(),
+            "categories_sha256": categories_sha(s),
+            "metrics": {"None": metric_rows(s, None), "3": metric_rows(s, 3)},
+        })
+    skipped = 0
+    for rec in cap["statements"]:
+        sd = rec["statement"]
+        if rows_key(sd, rec["vat_stagger"]) in seen_rows:
+            continue
+        given = Statement(**sd)
+        fresh = categorise.categorise(Statement(**sd))
+        # A loaded statement has no categories yet; the rule table sets all of them.
+        if not rec.get("loaded") and categories_sha(given) != categories_sha(fresh):
+            skipped += 1  # categories set by hand in the test; not the rule table's output
+            continue
+        seen_rows.add(rows_key(sd, rec["vat_stagger"]))
+        out["fixtures"].append({
+            "account_name": sd["account_name"],
+            "vat_stagger": rec["vat_stagger"],
+            "lines": [[t.id, str(t.date), t.description, t.amount, t.balance, t.category.value, t.reverses]
+                      for t in fresh.transactions],
+            "metrics": metric_rows(fresh, rec["vat_stagger"]),
+        })
+    # Lines the tests categorise one at a time, outside any statement above.
+    in_statements = {(t["description"], t["amount"]) for r in cap["statements"] for t in r["statement"]["transactions"]}
+    out["lines"] = sorted({(x["description"], x["amount"], x["category"]) for x in cap["lines"]
+                           if (x["description"], x["amount"]) not in in_statements})
+    Path(out_path).parent.mkdir(parents=True, exist_ok=True)
+    # One fixture line, metric or synthetic case per text line: diffable, not bloated.
+    text = json.dumps(out, separators=(",", ":"))
+    text = re.sub(r'(\[\[|\},\{|\],\[|"(?:synthetic|examples|fixtures|lines)":)', lambda m: m.group(0)[:-1] + "\n" + m.group(0)[-1] if m.group(0)[-1] in "[{" else m.group(0) + "\n", text)
+    Path(out_path).write_text(text + "\n")
+    import cma
+    print(f"cma from {cma.__file__}")
+    print(f"synthetic={len(out['synthetic'])} examples={len(out['examples'])} "
+          f"fixtures={len(out['fixtures'])} hand_categorised_skipped={skipped} lines={len(out['lines'])}")
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], sys.argv[2])
diff --git a/tests/golden/p7_v1_baseline.json.gz b/tests/golden/p7_v1_baseline.json.gz
new file mode 100644
index 0000000..551e645
Binary files /dev/null and b/tests/golden/p7_v1_baseline.json.gz differ
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 39614cc..b7812da 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -49,6 +49,32 @@ def test_written_memo_carries_its_evidence(tmp_path):
     assert record["vat_stagger"] == 3 and record["guard"]["grounded"] is True
 
 
+def test_unknown_cma_ruleset_is_refused_not_blamed_on_the_model(tmp_path, monkeypatch):
+    # T01: exit 4 means the model failed; a bad CMA_RULESET is a refusal (exit 2).
+    monkeypatch.setenv("CMA_RULESET", "v9")
+    r = runner.invoke(app, ["run", str(_statement(tmp_path)), "--yes", "--reviewer", "A"])
+    assert r.exit_code == 2, r.output
+    assert "Refused." in r.output and "CMA_RULESET" in r.output and "model call failed" not in r.output
+
+
+@pytest.mark.contracts
+@pytest.mark.parametrize("env", [None, "v1"])
+def test_written_evidence_records_the_ruleset(tmp_path, monkeypatch, env):
+    """R54: `cma run` writes the ruleset id and the pinned hash of v1 into the evidence
+    file, with CMA_RULESET unset (the default) and set to v1."""
+    from cma.categorise import FROZEN_SHA256
+
+    if env is None:
+        monkeypatch.delenv("CMA_RULESET", raising=False)
+    else:
+        monkeypatch.setenv("CMA_RULESET", env)
+    out = tmp_path / "memo.md"
+    r = runner.invoke(app, ["run", str(_statement(tmp_path)), "--yes", "--reviewer", "A", "--out", str(out)])
+    assert r.exit_code == 0, r.output
+    record = json.loads((tmp_path / "memo.evidence.json").read_text())
+    assert record["ruleset"] == {"id": "v1", "sha256": FROZEN_SHA256["v1"]}
+
+
 def test_whitespace_reviewer_is_refused(tmp_path):
     r = runner.invoke(app, ["run", str(_statement(tmp_path)), "--yes", "--reviewer", "   "])
     assert r.exit_code == 2
diff --git a/tests/test_p7_history.py b/tests/test_p7_history.py
new file mode 100644
index 0000000..c6dd289
--- /dev/null
+++ b/tests/test_p7_history.py
@@ -0,0 +1,213 @@
+"""P7 and R54 checked against the code before T01, and against the installed wheel.
+
+tests/test_rules.py compares v1 with the committed golden. These tests check the golden
+and the packaging themselves:
+- the golden is rebuilt from the pre-change commit (PRE_CHANGE, kept with its capture
+  tools in tests/golden/p7_tools/) and must equal the committed file on every key;
+- a review left pending in a --checkpoint-db by that commit resumes under this code;
+- the built wheel carries v1.yaml byte for byte, and loads it from outside the checkout;
+- a missing rules package is refused like a missing table, not blamed on the model.
+
+They need git and the pre-change commit in the repository (CI fetches full history), and
+pip able to build a wheel.
+"""
+
+import gzip
+import hashlib
+import json
+import os
+import shutil
+import sqlite3
+import subprocess
+import sys
+import venv
+from datetime import date
+from pathlib import Path
+
+import pytest
+
+from cma import categorise, synth
+from cma.categorise import load_ruleset
+
+ROOT = Path(__file__).parents[1]
+TOOLS = ROOT / "tests" / "golden" / "p7_tools"
+GOLDEN = ROOT / "tests" / "golden" / "p7_v1_baseline.json.gz"
+PRE_CHANGE = "fd7b64c"  # the last commit with the rule table as code
+
+
+def _env(**extra) -> dict:
+    env = {k: v for k, v in os.environ.items() if k not in ("PYTHONPATH", "CMA_RULESET")}
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    env.update(extra)
+    return env
+
+
+@pytest.fixture(scope="session")
+def pre_change(tmp_path_factory) -> Path:
+    """A clean export of the pre-change commit."""
+    if shutil.which("git") is None or subprocess.call(
+            ["git", "cat-file", "-e", f"{PRE_CHANGE}^{{commit}}"], cwd=ROOT,
+            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
+        pytest.skip(f"needs git and commit {PRE_CHANGE} (a full clone)")
+    out = tmp_path_factory.mktemp("pre_change")
+    archive = subprocess.run(["git", "archive", PRE_CHANGE], cwd=ROOT, check=True, capture_output=True).stdout
+    subprocess.run(["tar", "-x", "-C", str(out)], input=archive, check=True)
+    assert not (out / "src" / "cma" / "rules").exists(), "not the commit before the table moved"
+    return out
+
+
+@pytest.mark.dual_run
+@pytest.mark.invariants
+def test_p7_golden_is_rebuilt_exactly_from_the_pre_change_commit(pre_change, tmp_path):
+    """Run the pre-change suite with the capture plugin, rebuild the baseline from the
+    capture with the pre-change code, and compare with the committed golden."""
+    capture, rebuilt = tmp_path / "capture.json", tmp_path / "p7.json"
+    suite = subprocess.run(
+        [sys.executable, "-m", "pytest", "-q", "-rs", "-p", "capture_plugin", "-p", "no:cacheprovider"],
+        cwd=pre_change, capture_output=True, text=True,
+        env=_env(CAPTURE_OUT=str(capture), PYTHONPATH=f"{pre_change / 'src'}{os.pathsep}{TOOLS}"))
+    assert suite.returncode == 0, suite.stdout[-2000:]
+    assert " skipped" not in suite.stdout.splitlines()[-1], "a capturing test was skipped: " + suite.stdout[-800:]
+    make = subprocess.run(
+        [sys.executable, str(TOOLS / "make_p7_baseline.py"), str(capture), str(rebuilt)],
+        cwd=pre_change, capture_output=True, text=True,
+        env=_env(MADE_AT=PRE_CHANGE, PYTHONPATH=str(pre_change / "src")))
+    assert make.returncode == 0, make.stderr[-2000:]
+    assert f"cma from {pre_change / 'src' / 'cma'}" in make.stdout, make.stdout
+
+    got = json.loads(rebuilt.read_text())
+    want = json.loads(gzip.decompress(GOLDEN.read_bytes()))
+    assert want["made_at_commit"] == PRE_CHANGE
+    assert set(got) == set(want)
+    for key in sorted(want):  # _about included
+        assert got[key] == want[key], f"golden key {key!r} differs from the pre-change rebuild"
+    assert got == want
+    assert len(got["synthetic"]) == 13 and len(got["examples"]) == 1 and len(got["fixtures"]) == 48
+
+
+@pytest.mark.contracts
+@pytest.mark.dual_run
+def test_a_review_left_pending_by_the_pre_change_version_resumes_here(pre_change, tmp_path, monkeypatch):
+    """`cma run --checkpoint-db` under the pre-change commit leaves a review pending in a
+    real SQLite file. Resumed here with a damaged v1.yaml it is refused with nothing
+    recorded; with the table repaired the same review resumes and its evidence names v1,
+    inferred."""
+    pytest.importorskip("langgraph.checkpoint.sqlite")
+    from typer.testing import CliRunner
+
+    from cma.cli import app
+    from cma.graph import build, sqlite_checkpointer
+    from cma.llm import FakeLLM
+
+    rows, truth = synth.generate("cafe", "stretched", end=date(2026, 9, 30))
+    csv_path, _ = synth.write(rows, truth, tmp_path)
+    db = tmp_path / "reviews.db"
+    old = subprocess.run(
+        [sys.executable, "-m", "cma.cli", "run", str(csv_path), "--checkpoint-db", str(db), "--thread", "old-1"],
+        cwd=tmp_path, stdin=subprocess.DEVNULL, capture_output=True, text=True,
+        env=_env(PYTHONPATH=str(pre_change / "src")))
+    assert "review id: old-1" in old.stdout, old.stdout + old.stderr
+    with sqlite3.connect(db) as c:
+        assert c.execute("select count(*) from checkpoints where thread_id = 'old-1'").fetchone()[0] > 0
+
+    def pending():
+        with sqlite_checkpointer(db) as saver:
+            snap = build(FakeLLM(), checkpointer=saver).get_state({"configurable": {"thread_id": "old-1"}})
+        return snap
+
+    snap = pending()
+    assert snap.interrupts and "ruleset" not in snap.values and snap.values.get("review") is None
+
+    text = (ROOT / "src" / "cma" / "rules" / "v1.yaml").read_text()
+    monkeypatch.setattr(categorise, "_table_bytes",
+                        lambda rid: text.replace("category: returned_dd", "category: [returned_dd]", 1).encode())
+    load_ruleset.cache_clear()
+    out = tmp_path / "memo.md"
+    args = ["resume", "old-1", "--checkpoint-db", str(db), "--reviewer", "C", "--out", str(out)]
+    try:
+        r = CliRunner().invoke(app, args, input="y\n\n")
+        assert r.exit_code == 2, r.output
+        assert "Refused, nothing recorded." in r.output
+        assert not out.exists() and not (tmp_path / "memo.evidence.json").exists()
+        snap = pending()
+        assert snap.interrupts and snap.values.get("review") is None, "the review must still be pending"
+
+        monkeypatch.undo()
+        load_ruleset.cache_clear()
+        r = CliRunner().invoke(app, args, input="y\n\n")
+    finally:
+        load_ruleset.cache_clear()
+    assert r.exit_code == 0, r.output
+    record = json.loads((tmp_path / "memo.evidence.json").read_text())
+    assert record["ruleset"] == {"id": "v1", "sha256": load_ruleset("v1").sha256, "inferred": "pre-ruleset checkpoint"}
+    assert "APPROVED by C" in out.read_text()
+
+
+@pytest.mark.contracts
+@pytest.mark.dual_run
+def test_rollback_a_review_left_pending_here_resumes_under_the_pre_change_version(pre_change, tmp_path):
+    """Rollback path: a review left pending in a --checkpoint-db by this code (its state
+    now carries `ruleset`) is resumed by the pre-change commit, as after reinstalling the
+    previous wheel. It must finish and write its memo and evidence."""
+    pytest.importorskip("langgraph.checkpoint.sqlite")
+    rows, truth = synth.generate("cafe", "stretched", end=date(2026, 9, 30))
+    csv_path, _ = synth.write(rows, truth, tmp_path)
+    db, out = tmp_path / "reviews.db", tmp_path / "memo.md"
+    new = subprocess.run(
+        [sys.executable, "-m", "cma.cli", "run", str(csv_path), "--checkpoint-db", str(db), "--thread", "new-1"],
+        cwd=tmp_path, stdin=subprocess.DEVNULL, capture_output=True, text=True,
+        env=_env(PYTHONPATH=str(ROOT / "src")))
+    assert "review id: new-1" in new.stdout, new.stdout + new.stderr
+    old = subprocess.run(
+        [sys.executable, "-m", "cma.cli", "resume", "new-1", "--checkpoint-db", str(db), "--reviewer", "C",
+         "--out", str(out)],
+        cwd=tmp_path, input="y\n\n", capture_output=True, text=True,
+        env=_env(PYTHONPATH=str(pre_change / "src")))
+    assert old.returncode == 0, old.stdout[-2000:] + old.stderr[-2000:]
+    assert "APPROVED by C" in out.read_text()
+    record = json.loads((tmp_path / "memo.evidence.json").read_text())
+    assert "ruleset" not in record and record["guard"]["grounded"] is True
+
+
+@pytest.mark.contracts
+def test_the_built_wheel_carries_v1_byte_for_byte(tmp_path):
+    """Build the wheel, install it in a fresh virtual environment and load v1 from
+    outside the checkout; its hash must be the source file's."""
+    dist = tmp_path / "dist"
+    built = subprocess.run([sys.executable, "-m", "pip", "wheel", "--no-deps", "-q", "-w", str(dist), str(ROOT)],
+                           capture_output=True, text=True, env=_env())
+    assert built.returncode == 0, built.stderr[-2000:]
+    (wheel,) = dist.glob("*.whl")
+    env_dir = tmp_path / "venv"
+    # System site-packages supply the dependencies; the wheel's cma, installed in the
+    # venv's own site-packages, comes first on the path.
+    venv.create(env_dir, system_site_packages=True, with_pip=True)
+    py = env_dir / "bin" / "python"
+    subprocess.run([str(py), "-m", "pip", "install", "-q", "--no-deps", "--no-index", str(wheel)],
+                   check=True, capture_output=True, env=_env())
+    away = tmp_path / "elsewhere"
+    away.mkdir()
+    probe = ("import json, cma; from cma import categorise as c; r = c.load_ruleset('v1'); "
+             "print(json.dumps({'file': cma.__file__, 'id': r.id, 'sha256': r.sha256}))")
+    ran = subprocess.run([str(py), "-I", "-c", probe], cwd=away, capture_output=True, text=True, env=_env())
+    assert ran.returncode == 0, ran.stderr[-2000:]
+    got = json.loads(ran.stdout)
+    assert Path(got["file"]).is_relative_to(env_dir), got["file"]
+    assert got["id"] == "v1"
+    assert got["sha256"] == hashlib.sha256((ROOT / "src" / "cma" / "rules" / "v1.yaml").read_bytes()).hexdigest()
+
+
+@pytest.mark.contracts
+def test_cma_run_refuses_when_the_rules_package_is_missing(tmp_path):
+    """An install with no cma/rules at all raises ModuleNotFoundError inside importlib;
+    that is a missing table (exit 2), not a model failure (exit 4)."""
+    pkg = tmp_path / "pkg"
+    shutil.copytree(ROOT / "src" / "cma", pkg / "cma", ignore=shutil.ignore_patterns("__pycache__"))
+    shutil.rmtree(pkg / "cma" / "rules")
+    rows, truth = synth.generate("cafe", "stretched", end=date(2026, 9, 30))
+    csv_path, _ = synth.write(rows, truth, tmp_path)
+    r = subprocess.run(
+        [sys.executable, "-m", "cma.cli", "run", str(csv_path), "--yes", "--reviewer", "A"],
+        cwd=tmp_path, capture_output=True, text=True, env=_env(PYTHONPATH=str(pkg), CMA_RULESET="v1"))
+    assert r.returncode == 2, r.stdout + r.stderr
+    assert "Refused." in r.stdout and "cannot be read" in r.stdout and "model call failed" not in r.stdout
diff --git a/tests/test_rules.py b/tests/test_rules.py
new file mode 100644
index 0000000..b194ab3
--- /dev/null
+++ b/tests/test_rules.py
@@ -0,0 +1,594 @@
+"""Rule tables as packaged data (R54, R10, P7).
+
+The built-in table lives in src/cma/rules/<id>.yaml, is validated on load like the
+policy, and carries an id and a hash. CMA_RULESET chooses the table. v1 is the table
+as it was before it moved out of code, frozen: tests/golden/p7_v1_baseline.json.gz holds
+M1-M16 and every category computed by that code on every committed synthetic case,
+example and test fixture, and v1 must reproduce all of it exactly.
+
+The baseline is rebuilt from the pre-change commit with the tools in
+tests/golden/p7_tools/ (commands in make_p7_baseline.py's docstring); a rebuild must
+equal the committed file on every key. tests/test_p7_history.py does that rebuild.
+"""
+
+import gzip
+import hashlib
+import json
+import random
+import re
+from datetime import date
+from importlib import resources
+from pathlib import Path
+
+import pytest
+import yaml
+
+from cma import categorise, ingest, metrics, synth
+from cma.categorise import RulesetError, active_ruleset, load_ruleset, validate_ruleset
+from cma.models import Category, Statement, Transaction
+
+GOLDEN = Path(__file__).parent / "golden" / "p7_v1_baseline.json.gz"
+
+
+def _sha(text: str) -> str:
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+# --- the table as data -------------------------------------------------------------
+
+
+@pytest.mark.contracts
+def test_v1_is_packaged_with_an_id_and_the_hash_of_its_file():
+    raw = resources.files("cma.rules").joinpath("v1.yaml").read_bytes()
+    rs = load_ruleset("v1")
+    assert rs.id == "v1"
+    assert rs.sha256 == hashlib.sha256(raw).hexdigest()
+    assert rs.rules and all(r.id for r in rs.rules)
+
+
+def test_v1_is_marked_frozen():
+    assert yaml.safe_load(resources.files("cma.rules").joinpath("v1.yaml").read_text())["frozen"] is True
+
+
+GOOD_RULE = {"id": "card", "pattern": "CARD SETTLEMENT", "direction": "in", "category": "revenue_card_settlement"}
+
+
+@pytest.mark.parametrize("bad, match", [
+    ("- a list", "not a mapping"),
+    ({"id": "v1", "frozen": True, "rules": []}, "no rules"),
+    ({"frozen": True, "rules": [GOOD_RULE]}, "missing id"),
+    ({"id": "v2", "frozen": True, "rules": [GOOD_RULE]}, "id 'v2' does not match"),
+    ({"id": "v1", "rules": [GOOD_RULE]}, "frozen"),
+    ({"id": "v1", "frozen": True, "rules": [{**GOOD_RULE, "direction": "sideways"}]}, "direction"),
+    ({"id": "v1", "frozen": True, "rules": [{**GOOD_RULE, "category": "lottery"}]}, "category 'lottery'"),
+    ({"id": "v1", "frozen": True, "rules": [{**GOOD_RULE, "pattern": "("}]}, "pattern does not compile"),
+    # These raise OverflowError and RecursionError, not re.error.
+    ({"id": "v1", "frozen": True, "rules": [{**GOOD_RULE, "pattern": "A{4294967296}"}]}, "pattern does not compile"),
+    ({"id": "v1", "frozen": True, "rules": [{**GOOD_RULE, "pattern": "(" * 2000 + ")" * 2000}]},
+     "pattern does not compile"),
+    ({"id": "v1", "frozen": True, "rules": [GOOD_RULE, GOOD_RULE]}, "duplicate id"),
+    ({"id": "v1", "frozen": True, "rules": [{k: v for k, v in GOOD_RULE.items() if k != "pattern"}]}, "missing pattern"),
+    ({"id": "v1", "frozen": True, "rules": [{**GOOD_RULE, "colour": "red"}]}, "unknown key"),
+])
+def test_a_malformed_table_is_refused_naming_the_problem(bad, match):
+    with pytest.raises(RulesetError, match=match):
+        validate_ruleset(bad, expected_id="v1", source="v1.yaml")
+
+
+# A field of the wrong YAML type (a list, a mapping, a number, null) is refused as a
+# malformed table, never raised as a TypeError that the CLI would blame on the model.
+@pytest.mark.parametrize("field", ["id", "pattern", "direction", "category"])
+@pytest.mark.parametrize("value", [["returned_dd"], {"a": 1}, 7, None, True])
+def test_a_rule_field_of_the_wrong_type_is_refused(field, value):
+    bad = {"id": "v1", "frozen": True, "rules": [{**GOOD_RULE, field: value}, GOOD_RULE | {"id": "b"}]}
+    with pytest.raises(RulesetError, match=f"rule 1 .*{field}"):
+        validate_ruleset(bad, expected_id="v1", source="v1.yaml")
+
+
+@pytest.mark.parametrize("bad", [
+    {"id": ["v1"], "frozen": True, "rules": [GOOD_RULE]},
+    {"id": "v1", "frozen": True, "rules": [GOOD_RULE], ("a", "b"): 1},
+    {"id": "v1", "frozen": True, "rules": {"card": GOOD_RULE}},
+    {"id": "v1", "frozen": True, "rules": ["card"]},
+])
+def test_a_table_field_of_the_wrong_type_is_refused(bad):
+    with pytest.raises(RulesetError):
+        validate_ruleset(bad, expected_id="v1", source="v1.yaml")
+
+
+@pytest.fixture
+def packaged_table(monkeypatch):
+    """Replace the packaged v1.yaml bytes, as a damaged install would."""
+    def use(text: str | bytes):
+        raw = text.encode() if isinstance(text, str) else text
+        monkeypatch.setattr(categorise, "_table_bytes", lambda ruleset_id: raw)
+        load_ruleset.cache_clear()
+    yield use
+    load_ruleset.cache_clear()
+
+
+def test_a_damaged_packaged_table_is_refused_on_load(packaged_table):
+    text = resources.files("cma.rules").joinpath("v1.yaml").read_text()
+    packaged_table(text.replace("category: returned_dd", "category: [returned_dd]", 1))
+    with pytest.raises(RulesetError, match=r"cma/rules/v1.yaml: rule 1 \(returned_dd\): category"):
+        load_ruleset("v1")
+    packaged_table("id: v1\nrules: [\n")
+    with pytest.raises(RulesetError, match="not valid YAML"):
+        load_ruleset("v1")
+
+
+def test_a_scalar_yaml_cannot_construct_is_refused_as_invalid_yaml(packaged_table):
+    """PyYAML raises ValueError, not YAMLError, building the impossible date 2026-02-30
+    (verify-11); that is a damaged table, not a model failure."""
+    packaged_table(_v1_text().replace("category: returned_dd", "category: 2026-02-30", 1))
+    with pytest.raises(RulesetError, match=r"cma/rules/v1\.yaml: not valid YAML"):
+        load_ruleset("v1")
+
+
+def _v1_text() -> str:
+    return resources.files("cma.rules").joinpath("v1.yaml").read_text()
+
+
+@pytest.mark.parametrize("old, new, key", [
+    # A second category inside a rule: safe_load would keep the last one.
+    ("    category: revenue_card_settlement\n",
+     "    category: revenue_card_settlement\n    category: supplier\n", "category"),
+    # A second rules list at the top level would replace the whole table.
+    ("frozen: true\n", "frozen: true\nrules: []\n", "rules"),
+])
+def test_a_repeated_key_in_the_table_is_refused(packaged_table, monkeypatch, old, new, key):
+    text = _v1_text()
+    assert old in text
+    packaged_table(text.replace(old, new, 1))
+    with pytest.raises(RulesetError, match=rf"cma/rules/v1\.yaml: not valid YAML .*duplicate key '{key}'"):
+        load_ruleset("v1")
+    monkeypatch.setenv("CMA_RULESET", "v1")
+    line = Transaction(id="T1", date=date(2026, 1, 5), description="CARD SETTLEMENT ACME", amount=120.0, balance=120.0)
+    with pytest.raises(RulesetError):
+        categorise.categorise_one(line)
+
+
+def test_a_missing_packaged_table_is_refused_not_raised_as_an_os_error(monkeypatch):
+    def missing(ruleset_id):
+        raise FileNotFoundError(f"cma/rules/{ruleset_id}.yaml")
+    monkeypatch.setattr(categorise, "_table_bytes", missing)
+    load_ruleset.cache_clear()
+    try:
+        with pytest.raises(RulesetError, match=r"cma/rules/v1\.yaml: cannot be read from the installed package"):
+            load_ruleset("v1")
+    finally:
+        load_ruleset.cache_clear()
+
+
+def test_cma_run_refuses_a_missing_table_rather_than_blaming_the_model(tmp_path, monkeypatch):
+    from typer.testing import CliRunner
+
+    from cma.cli import app
+
+    def missing(ruleset_id):
+        raise FileNotFoundError(ruleset_id)
+    monkeypatch.setattr(categorise, "_table_bytes", missing)
+    load_ruleset.cache_clear()
+    monkeypatch.setenv("CMA_RULESET", "v1")
+    rows, truth = synth.generate("cafe", "stretched", end=date(2026, 9, 30))
+    csv_path, _ = synth.write(rows, truth, tmp_path)
+    try:
+        r = CliRunner().invoke(app, ["run", str(csv_path), "--yes", "--reviewer", "A"])
+    finally:
+        load_ruleset.cache_clear()
+    assert r.exit_code == 2, r.output
+    assert "Refused." in r.output and "cannot be read" in r.output and "model call failed" not in r.output
+
+
+def test_the_hash_is_of_the_file_bytes_not_of_normalised_text(packaged_table):
+    """The pin is compared with the file's bytes: a CRLF copy with the same rules is a
+    different file and is refused, naming both hashes."""
+    lf = _v1_text().encode()
+    crlf = lf.replace(b"\n", b"\r\n")
+    assert load_ruleset("v1").sha256 == hashlib.sha256(lf).hexdigest()
+    packaged_table(crlf)
+    with pytest.raises(RulesetError, match=hashlib.sha256(crlf).hexdigest()):
+        load_ruleset("v1")
+
+
+@pytest.mark.contracts
+def test_v1_hash_is_pinned_in_code():
+    assert categorise.FROZEN_SHA256["v1"] == hashlib.sha256(_v1_text().encode()).hexdigest()
+    assert load_ruleset("v1").sha256 == categorise.FROZEN_SHA256["v1"]
+
+
+@pytest.mark.contracts
+@pytest.mark.parametrize("old, new", [
+    ("category: revenue_card_settlement", "category: other"),  # verify-12: schema-valid, still v1
+    ("direction: in\n", "direction: any\n"),
+    ("frozen: true", "frozen: false"),
+])
+def test_a_schema_valid_change_to_frozen_v1_is_refused(packaged_table, old, new):
+    text = _v1_text()
+    assert old in text
+    changed = text.replace(old, new, 1)
+    validate_ruleset(yaml.safe_load(changed), "v1")  # the schema alone accepts it
+    packaged_table(changed)
+    with pytest.raises(RulesetError, match=r"cma/rules/v1\.yaml: frozen table v1 has been changed"):
+        load_ruleset("v1")
+
+
+@pytest.mark.contracts
+def test_cma_run_refuses_a_changed_v1_and_writes_no_evidence(tmp_path, monkeypatch, packaged_table):
+    from typer.testing import CliRunner
+
+    from cma.cli import app
+
+    packaged_table(_v1_text().replace("category: revenue_card_settlement", "category: other", 1))
+    monkeypatch.setenv("CMA_RULESET", "v1")
+    rows, truth = synth.generate("cafe", "stretched", end=date(2026, 9, 30))
+    csv_path, _ = synth.write(rows, truth, tmp_path)
+    out = tmp_path / "memo.md"
+    r = CliRunner().invoke(app, ["run", str(csv_path), "--yes", "--reviewer", "A", "--out", str(out)])
+    assert r.exit_code == 2, r.output
+    assert "Refused." in r.output and "frozen table v1 has been changed" in r.output
+    assert not out.exists() and not (tmp_path / "memo.evidence.json").exists()
+
+
+@pytest.mark.parametrize("old, new", [
+    ("category: returned_dd", "category: [returned_dd]"),
+    ("pattern: '^UNPAID DD\\b'", "pattern: 'A{4294967296}'"),
+    ("- id: returned_dd", "- id: [returned_dd]"),
+    ("direction: any", "direction: {any: 1}"),
+])
+def test_cma_run_refuses_a_damaged_table_rather_than_blaming_the_model(tmp_path, monkeypatch, packaged_table, old, new):
+    from typer.testing import CliRunner
+
+    from cma.cli import app
+
+    text = resources.files("cma.rules").joinpath("v1.yaml").read_text()
+    packaged_table(text.replace(old, new, 1))
+    monkeypatch.setenv("CMA_RULESET", "v1")
+    rows, truth = synth.generate("cafe", "stretched", end=date(2026, 9, 30))
+    csv_path, _ = synth.write(rows, truth, tmp_path)
+    r = CliRunner().invoke(app, ["run", str(csv_path), "--yes", "--reviewer", "A"])
+    assert r.exit_code == 2, r.output
+    assert "Refused." in r.output and "rule 1" in r.output and "model call failed" not in r.output
+
+
+def test_an_unknown_ruleset_is_refused_naming_the_known_ones():
+    with pytest.raises(RulesetError, match=r"v9.*v1"):
+        load_ruleset("v9")
+
+
+def test_a_ruleset_id_cannot_name_a_path():
+    with pytest.raises(RulesetError):
+        load_ruleset("../policies/uk_sme_default")
+
+
+# --- CMA_RULESET chooses the table -----------------------------------------------------
+
+
+def test_cma_ruleset_chooses_the_table(monkeypatch):
+    monkeypatch.setenv("CMA_RULESET", "v1")
+    assert active_ruleset().id == "v1"
+    monkeypatch.setenv("CMA_RULESET", "v9")
+    with pytest.raises(RulesetError, match="CMA_RULESET"):
+        active_ruleset()
+    with pytest.raises(RulesetError):
+        categorise.categorise_one(Transaction(id="T", date=date(2026, 1, 1), description="X", amount=1.0, balance=1.0))
+
+
+def test_unset_cma_ruleset_uses_the_default(monkeypatch):
+    monkeypatch.delenv("CMA_RULESET", raising=False)
+    assert active_ruleset().id == categorise.DEFAULT_RULESET
+
+
+def test_the_categoriser_uses_the_table_it_is_given():
+    """A rule added to a table changes the category; the code holds no table of its own."""
+    v1 = load_ruleset("v1")
+    data = yaml.safe_load(resources.files("cma.rules").joinpath("v1.yaml").read_text())
+    data["rules"].insert(0, {"id": "test_cash", "pattern": "CASH PAID IN", "direction": "in", "category": "loan_drawdown"})
+    other = categorise.ruleset_from_data(data, expected_id="v1", source="test", sha256="x")
+    t = Transaction(id="T", date=date(2026, 1, 1), description="CASH PAID IN", amount=50.0, balance=50.0)
+    assert categorise.categorise_one(t, v1) == Category.OTHER
+    assert categorise.categorise_one(t, other) == Category.LOAN_DRAWDOWN
+
+
+# --- R54: the evidence records the ruleset --------------------------------------------------
+
+
+@pytest.mark.contracts
+def test_evidence_records_the_ruleset(tmp_path, monkeypatch):
+    from langgraph.types import Command
+
+    from cma.graph import build, evidence_record
+    from cma.llm import FakeLLM
+
+    monkeypatch.setenv("CMA_RULESET", "v1")
+    rows, truth = synth.generate("cafe", "stretched", end=date(2026, 9, 30))
+    csv_path, _ = synth.write(rows, truth, tmp_path)
+    graph = build(FakeLLM())
+    cfg = {"configurable": {"thread_id": "rules-evidence"}}
+    graph.invoke({"statement_path": str(csv_path)}, cfg)
+    graph.invoke(Command(resume={"approved": False, "reviewer": "A. Analyst", "notes": "test"}), cfg)
+    record = evidence_record(graph.get_state(cfg).values)
+    assert record["ruleset"] == {"id": "v1", "sha256": load_ruleset("v1").sha256}
+
+
+@pytest.mark.contracts
+def test_a_review_drafted_before_the_ruleset_was_recorded_still_names_v1(tmp_path, monkeypatch):
+    """A review left pending in a checkpoint written before T01 has no ruleset in its state.
+    Its lines were categorised by the table that is now v1 (P7), so the evidence written on
+    resume names v1 and its hash, and says it was inferred, never null. CMA_RULESET at
+    resume time does not change it: the categories were fixed when the memo was drafted."""
+    from langgraph.types import Command
+
+    from cma.graph import build, evidence_record
+    from cma.llm import FakeLLM
+
+    rows, truth = synth.generate("cafe", "stretched", end=date(2026, 9, 30))
+    csv_path, _ = synth.write(rows, truth, tmp_path)
+    graph = build(FakeLLM())
+    cfg = {"configurable": {"thread_id": "legacy"}}
+    graph.invoke({"statement_path": str(csv_path)}, cfg)
+    graph.invoke(Command(resume={"approved": True, "reviewer": "A. Analyst"}), cfg)
+    legacy = {k: v for k, v in graph.get_state(cfg).values.items() if k != "ruleset"}
+    monkeypatch.setenv("CMA_RULESET", "v9")
+    assert evidence_record(legacy)["ruleset"] == {
+        "id": "v1", "sha256": load_ruleset("v1").sha256, "inferred": "pre-ruleset checkpoint"}
+    assert evidence_record({**legacy, "ruleset": None})["ruleset"]["id"] == "v1"
+
+
+# --- R10: M16 keeps its id, unit and value, and its name says what it measures ------------
+
+
+def test_m16_is_named_as_non_trading_money_in(v1):
+    path = Path(__file__).parents[1] / "examples" / "cafe_stretched.csv"
+    m16 = next(m for m in metrics.compute(categorise.categorise(ingest.load_csv(path))) if m.id == "M16")
+    assert m16.name == "Non-trading money in (share)"
+    assert m16.unit == "pct"
+
+
+# --- P7 under v1: identical to the code before the move, no exceptions ---------------------
+
+
+def _golden() -> dict:
+    return json.loads(gzip.decompress(GOLDEN.read_bytes()))
+
+
+def _categories_sha(s: Statement) -> str:
+    return _sha("\n".join(f"{t.id}|{t.category.value}|{t.reverses or ''}" for t in s.transactions))
+
+
+def _metric_rows(s: Statement, vat_stagger):
+    return [
+        {"id": m.id, "unit": m.unit, "value": m.value, "evidence_n": len(m.evidence),
+         "evidence_sha256": _sha("\n".join(m.evidence))}
+        for m in metrics.compute(s, vat_stagger=vat_stagger)
+        if int(m.id[1:]) <= 16
+    ]
+
+
+def _stagger(key: str):
+    return None if key == "None" else int(key)
+
+
+@pytest.fixture
+def v1(monkeypatch):
+    monkeypatch.setenv("CMA_RULESET", "v1")
+
+
+@pytest.mark.dual_run
+@pytest.mark.invariants
+def test_p7_golden_covers_every_case():
+    g = _golden()
+    combos = {(c["archetype"], c["profile"]) for c in g["synthetic"]}
+    assert combos >= {(a, p) for a in synth.ARCHETYPES for p in synth.PROFILES}
+    # Every committed statement file, found by globbing tests/ and examples/, has a baseline.
+    root = Path(__file__).parents[1]
+    committed = sorted(p.relative_to(root).as_posix() for d in ("tests", "examples") for p in (root / d).rglob("*.csv"))
+    assert committed == ["examples/cafe_stretched.csv"]
+    assert [e["path"] for e in g["examples"]] == committed
+    # 48 statements the pre-change suite wrote, loaded, categorised or computed on; a
+    # rebuild that finds fewer has lost one (tests/test_p7_history.py rebuilds it).
+    assert len(g["fixtures"]) == 48 and len(g["lines"]) == 13
+    # verify-12: the Monzo balance-column conversion writes a statement no test loads; the
+    # capture finds it in the suite's temporary files.
+    assert [["tx_1", "2026-03-01", "FPS CREDIT CLIENT A", 100.0, 600.0],
+            ["tx_2", "2026-03-02", "CARD SHOP", -50.0, 550.0]] in [[line[:5] for line in f["lines"]] for f in g["fixtures"]]
+    # The same lines under another VAT stagger are another case (M13 differs); the
+    # stagger-3 run of the on-time stagger-1 VAT year is the regression case for that.
+    by_lines: dict[str, set] = {}
+    for f in g["fixtures"]:
+        by_lines.setdefault(json.dumps([line[:5] for line in f["lines"]]), set()).add(f["vat_stagger"])
+    assert any({1, 3} <= staggers for staggers in by_lines.values())
+    # A whole statement the pre-change tests categorised without computing metrics still
+    # gets an M1-M16 baseline (verify-10: the two-credit Monzo invoice fixture in
+    # tests/test_import_monzo.py was captured only as single lines).
+    descriptions = [{line[2] for line in f["lines"]} for f in g["fixtures"]]
+    assert {"FPS CREDIT OAKFIELD PROPERTIES INV1042", "BACS CREDIT ACME LTD INVOICE2210"} in descriptions
+    # Statements the pre-change tests only loaded, never categorised or computed on, are
+    # in too (verify-11: the newest-first and byte-order-mark fixtures in tests/test_ingest.py).
+    rows = [[line[:5] for line in f["lines"]] for f in g["fixtures"]]
+    assert [["T1", "2026-01-01", "A", 100.0, 100.0], ["T2", "2026-01-02", "B", 100.0, 200.0],
+            ["T3", "2026-01-03", "C", -50.0, 150.0]] in rows
+    assert [["T1", "2026-01-01", "A", 100.0, 100.0]] in rows
+    assert [["T1", "2026-01-01", "CARD ACQUIRER SETTLEMENT", 100.0, 100.0]] in rows
+
+
+@pytest.mark.dual_run
+@pytest.mark.invariants
+@pytest.mark.parametrize("case", _golden()["synthetic"], ids=lambda c: f"{c['archetype']}-{c['profile']}-s{c['seed']}-m{c['months']}")
+def test_p7_v1_synthetic_cases_match_the_baseline(case, v1, tmp_path):
+    rows, truth = synth.generate(case["archetype"], case["profile"], seed=case["seed"], months=case["months"],
+                                 end=date.fromisoformat(case["end"]))
+    csv_path, _ = synth.write(rows, truth, tmp_path, stem="s")
+    assert hashlib.sha256(csv_path.read_bytes()).hexdigest() == case["csv_sha256"], "generator drifted"
+    s = categorise.categorise(ingest.load_csv(csv_path))
+    assert _categories_sha(s) == case["categories_sha256"]
+    for key, expected in case["metrics"].items():
+        assert _metric_rows(s, _stagger(key)) == expected
+
+
+@pytest.mark.dual_run
+@pytest.mark.invariants
+@pytest.mark.parametrize("case", _golden()["examples"], ids=lambda c: c["path"])
+def test_p7_v1_committed_examples_match_the_baseline(case, v1):
+    path = Path(__file__).parents[1] / case["path"]
+    assert hashlib.sha256(path.read_bytes()).hexdigest() == case["file_sha256"]
+    s = categorise.categorise(ingest.load_csv(path))
+    assert _categories_sha(s) == case["categories_sha256"]
+    for key, expected in case["metrics"].items():
+        assert _metric_rows(s, _stagger(key)) == expected
+
+
+@pytest.mark.dual_run
+@pytest.mark.invariants
+@pytest.mark.parametrize("case", _golden()["fixtures"], ids=lambda c: f"fixture-{len(c['lines'])}-lines-{c['lines'][0][2][:24]}")
+def test_p7_v1_test_fixtures_match_the_baseline(case, v1):
+    s = Statement(account_name=case["account_name"], transactions=[
+        Transaction(id=i, date=date.fromisoformat(d), description=desc, amount=a, balance=b)
+        for i, d, desc, a, b, _, _ in case["lines"]
+    ])
+    s = categorise.categorise(s)
+    assert [[t.category.value, t.reverses] for t in s.transactions] == [[c, r] for *_, c, r in case["lines"]]
+    assert _metric_rows(s, case["vat_stagger"]) == case["metrics"]
+
+
+@pytest.mark.dual_run
+@pytest.mark.invariants
+def test_p7_v1_single_lines_match_the_baseline(v1):
+    got = [
+        [d, a, categorise.categorise_one(Transaction(id="T", date=date(2026, 1, 1), description=d, amount=a, balance=0.0)).value]
+        for d, a, _ in _golden()["lines"]
+    ]
+    assert got == _golden()["lines"]
+
+
+# --- Dual run: the table as code before the move vs v1.yaml ----------------------------
+# Copied verbatim from src/cma/categorise.py at fd7b64c (the last commit before T01) as an
+# independent oracle. Never edit it: it is the "before" side of P7.
+
+_OLD_NON_TRADING_IN = re.compile(
+    r"\bDIRECTOR\b|\bOWNER\b|\bCAPITAL\b|\bSHAREHOLDER\b|\bHMRC\b|\bREFUND\b|\bREVERSAL\b"
+    r"|\bSAVINGS\b|\bPOT TRANSFER\b|\bINTEREST\b|\bGRANT\b|\bINSURANCE CLAIM\b"
+)
+_OLD_RULES = [
+    (re.compile(r"^UNPAID DD\b"), "any", Category.RETURNED_DD),
+    (re.compile(r"UNPAID ITEM FEE|ACCOUNT FEES|BANK CHARGES"), "out", Category.BANK_FEES),
+    (re.compile(r"HMRC VAT"), "out", Category.HMRC_VAT),
+    (re.compile(r"HMRC PAYE"), "out", Category.HMRC_PAYE),
+    (re.compile(r"PAYROLL|SALARIES"), "out", Category.PAYROLL),
+    (re.compile(r"\bRENT\b"), "out", Category.RENT),
+    (re.compile(r"\bLOAN\b|FINANCE\b"), "out", Category.LOAN_REPAYMENT),
+    (re.compile(r"\bLOAN\b|FINANCE\b"), "in", Category.LOAN_DRAWDOWN),
+    (re.compile(r"OWNER DRAWINGS|DIRECTOR DRAWINGS|DIVIDEND"), "out", Category.OWNER_DRAWINGS),
+    (_OLD_NON_TRADING_IN, "in", Category.OTHER),
+    (re.compile(r"ACQUIRER SETTLEMENT|PAYGATE PAYOUT|CARD SETTLEMENT"), "in", Category.REVENUE_CARD),
+    (re.compile(r"\bINV(?:OICE)?\s*[-#:]?\s*\d+"), "in", Category.REVENUE_TRANSFER),
+]
+
+
+def _old_categorise_one(description: str, amount: float) -> Category:
+    desc = description.upper()
+    for pattern, direction, cat in _OLD_RULES:
+        ok = True if direction == "any" else (amount > 0 if direction == "in" else amount < 0)
+        if pattern.search(desc) and ok:
+            return cat
+    return Category.SUPPLIER if amount < 0 else Category.OTHER
+
+
+@pytest.mark.dual_run
+def test_dual_run_v1_yaml_is_the_old_rule_list():
+    v1 = load_ruleset("v1")
+    assert [(r.pattern.pattern, r.direction, r.category) for r in v1.rules] == \
+        [(p.pattern, d, c) for p, d, c in _OLD_RULES]
+
+
+def _descriptions() -> list[str]:
+    g = _golden()
+    out = {d for d, _, _ in g["lines"]}
+    out |= {line[2] for f in g["fixtures"] for line in f["lines"]}
+    examples = Path(__file__).parents[1] / "examples" / "cafe_stretched.csv"
+    out |= {t.description for t in ingest.load_csv(examples).transactions}
+    return sorted(out)
+
+
+@pytest.mark.dual_run
+def test_dual_run_every_known_and_fuzzed_description_categorises_the_same(v1):
+    """Every description in the baseline and the example, plus random descriptions built
+    from every word the rules mention (and near misses), in both directions and at zero."""
+    words = sorted({w for p, _, _ in _OLD_RULES for w in re.findall(r"[A-Z]{2,}", p.pattern)})
+    words += ["INV1234", "INVOICE 99", "INV-7", "INV#12", "UNPAID", "DD", "CO", "LTD", "PAYMENT",
+              "TFR", "FROM", "TO", "XFINANCE", "LOANS", "RENTAL", "INVOICES", "INV", "#", "-", ":"]
+    rng = random.Random(7)
+    samples = [(d, a) for d in _descriptions() for a in (-12.5, 0.0, 12.5)]
+    for _ in range(20_000):
+        d = " ".join(rng.choice(words) for _ in range(rng.randint(1, 5)))
+        samples.append((d.lower() if rng.random() < 0.1 else d, rng.choice((-1.0, 0.0, 1.0)) * rng.randint(1, 9999) / 100))
+    ruleset = load_ruleset("v1")
+    differ = [
+        (d, a) for d, a in samples
+        if categorise.categorise_one(Transaction(id="T", date=date(2026, 1, 1), description=d, amount=a, balance=0.0), ruleset)
+        != _old_categorise_one(d, a)
+    ]
+    assert not differ, differ[:5]
+    assert len(samples) > 20_000
+
+
+# --- a review drafted before T01, resumed with a damaged table -------------------------
+
+
+@pytest.fixture
+def legacy_pending(tmp_path, monkeypatch):
+    """A review waiting for a decision whose state has no ruleset, as a checkpoint written
+    before T01 has. `cma resume` is driven through one shared in-memory saver, standing in
+    for the --checkpoint-db file (the sqlite extra is optional)."""
+    from contextlib import contextmanager
+
+    from cma import cli
+    from cma.graph import build, default_checkpointer
+    from cma.llm import FakeLLM
+
+    saver = default_checkpointer()
+
+    @contextmanager
+    def shared(path):
+        yield saver
+    monkeypatch.setattr(cli, "_checkpointer", shared)
+    rows, truth = synth.generate("cafe", "stretched", end=date(2026, 9, 30))
+    csv_path, _ = synth.write(rows, truth, tmp_path)
+    graph = build(FakeLLM(), checkpointer=saver)
+    cfg = {"configurable": {"thread_id": "legacy"}}
+    graph.invoke({"statement_path": str(csv_path)}, cfg)
+    graph.update_state(cfg, {"ruleset": None})
+    graph.invoke(None, cfg)  # back to the review interrupt, as the stored review would be
+    snap = graph.get_state(cfg)
+    assert snap.interrupts and not snap.values.get("ruleset")
+    db = tmp_path / "reviews.db"
+    db.touch()
+    return graph, cfg, db
+
+
+@pytest.mark.contracts
+def test_a_legacy_resume_with_a_damaged_table_is_refused_before_anything_is_recorded(
+        tmp_path, legacy_pending, packaged_table):
+    from typer.testing import CliRunner
+
+    from cma.cli import app
+
+    graph, cfg, db = legacy_pending
+    packaged_table(_v1_text().replace("category: returned_dd", "category: [returned_dd]", 1))
+    out = tmp_path / "memo.md"
+    r = CliRunner().invoke(app, ["resume", "legacy", "--checkpoint-db", str(db), "--reviewer", "C", "--out", str(out)],
+                           input="y\n\n")
+    assert r.exit_code == 2, r.output
+    assert "Refused, nothing recorded." in r.output and "rule 1" in r.output
+    assert not out.exists() and not (tmp_path / "memo.evidence.json").exists()
+    snap = graph.get_state(cfg)
+    assert snap.interrupts and snap.values.get("review") is None, "the review must still be pending"
+
+    # With the table repaired the same review resumes and its evidence names v1, inferred.
+    packaged_table(_v1_text())
+    r = CliRunner().invoke(app, ["resume", "legacy", "--checkpoint-db", str(db), "--reviewer", "C", "--out", str(out)],
+                           input="y\n\n")
+    assert r.exit_code == 0, r.output
+    record = json.loads((tmp_path / "memo.evidence.json").read_text())
+    assert record["ruleset"] == {"id": "v1", "sha256": load_ruleset("v1").sha256, "inferred": "pre-ruleset checkpoint"}
+    assert "APPROVED by C" in out.read_text()

