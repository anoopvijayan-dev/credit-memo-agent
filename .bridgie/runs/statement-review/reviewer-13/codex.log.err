   160	def _table_bytes(ruleset_id: str) -> bytes:
   161	    return resources.files("cma.rules").joinpath(f"{ruleset_id}.yaml").read_bytes()
   162	
   163	
   164	@lru_cache
   165	def load_ruleset(ruleset_id: str) -> Ruleset:
   166	    """A packaged table by id. Only ids in RULESETS load, so an id never names a path."""
   167	    if ruleset_id not in RULESETS:
   168	        raise RulesetError(f"unknown ruleset {ruleset_id!r}; known: {', '.join(RULESETS)}")
   169	    source = f"cma/rules/{ruleset_id}.yaml"
   170	    try:
   171	        raw = _table_bytes(ruleset_id)
   172	    except (OSError, ImportError) as e:  # ImportError: the cma.rules package itself is gone
   173	        raise RulesetError(f"{source}: cannot be read from the installed package ({e.__class__.__name__})") from e
   174	    try:
   175	        data = yaml.load(raw.decode("utf-8"), Loader=_UniqueKeyLoader)
   176	    except UnicodeDecodeError as e:
   177	        raise RulesetError(f"{source}: not UTF-8 text") from e
   178	    except yaml.YAMLError as e:
   179	        problem = getattr(e, "problem", None) or e.__class__.__name__
   180	        raise RulesetError(f"{source}: not valid YAML ({problem})") from e
   181	    except RecursionError as e:
   182	        raise RulesetError(f"{source}: not valid YAML (nested too deeply)") from e
   183	    except (ValueError, TypeError, OverflowError) as e:  # a scalar the loader cannot build, e.g. 2026-02-30
   184	        raise RulesetError(f"{source}: not valid YAML ({e.__class__.__name__} building a value)") from e
   185	    # The hash is of the file's bytes as installed, so it matches sha256sum on that file.
   186	    digest = hashlib.sha256(raw).hexdigest()
   187	    ruleset = ruleset_from_data(data, ruleset_id, source, digest)
   188	    pinned = FROZEN_SHA256.get(ruleset_id)
   189	    if pinned is not None and digest != pinned:
   190	        raise RulesetError(f"{source}: frozen table {ruleset_id} has been changed "
   191	                           f"(sha256 {digest}, pinned {pinned}); reinstall the package")
   192	    if data["frozen"] and pinned is None:
   193	        raise RulesetError(f"{source}: marked frozen but no hash is pinned for {ruleset_id}")
   194	    return ruleset
   195	
   196	
   197	def active_ruleset() -> Ruleset:
   198	    """The table CMA_RULESET names, or the default when it is unset."""
   199	    chosen = os.environ.get(RULESET_ENV) or DEFAULT_RULESET
   200	    try:
   201	        return load_ruleset(chosen)
   202	    except RulesetError as e:
   203	        raise RulesetError(f"{RULESET_ENV}={chosen!r}: {e}") from e
   204	
   205	
   206	def _direction_ok(direction: Direction, amount: float) -> bool:
   207	    if direction == "any":
   208	        return True
   209	    return amount > 0 if direction == "in" else amount < 0
   210	
   211	
   212	def categorise_one(t: Transaction, ruleset: Ruleset | None = None) -> Category:
   213	    desc = t.description.upper()
   214	    for rule in (ruleset or active_ruleset()).rules:
   215	        if rule.pattern.search(desc) and _direction_ok(rule.direction, t.amount):
   216	            return rule.category
   217	    if t.amount < 0:
   218	        return Category.SUPPLIER
