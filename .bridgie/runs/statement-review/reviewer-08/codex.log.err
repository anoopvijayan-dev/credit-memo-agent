   174	class CaseLog:
   175	    def __init__(self, path: Path | str):
   176	        self.path = Path(path)
   177	        self.lock_path = self.path.with_name(self.path.name + ".lock")
   178	        self._state = threading.Lock()  # guards the three fields below, never held long
   179	        self._lock_fd: int | None = None
   180	        self._owner: int | None = None  # thread ident of the holder
   181	        self._lock_depth = 0
   182	
   183	    # --- reading -----------------------------------------------------------------------
   184	
   185	    def verify(self) -> LogCheck:
   186	        """Walk the chain from the start and stop at the first entry that does not hold."""
   187	        raw = self.path.read_bytes() if self.path.exists() else b""
   188	        pieces = raw.split(b"\n")
   189	        complete, tail = pieces[:-1], pieces[-1]  # tail is non-empty only if torn
   190	        entries: list[Entry] = []
   191	        prev, offset = GENESIS, 0
   192	        for n, line in enumerate(complete, start=1):
   193	            entry, reason = _parse(line, n, prev)
   194	            if entry is None:
   195	                return LogCheck(Head(n - 1, prev), entries, n, reason, False, offset)
   196	            entries.append(entry)
   197	            prev, offset = entry.hash, offset + len(line) + 1
   198	        if tail:
   199	            n = len(complete) + 1
   200	            reason = ("is incomplete: the write did not finish (the process or power stopped); "
   201	                      "confirm dropping it before anything else is recorded or signed off")
   202	            return LogCheck(Head(n - 1, prev), entries, n, reason, True, offset)
   203	        return LogCheck(Head(len(entries), prev), entries, intact_bytes=offset)
   204	
   205	    def require_intact(self) -> Head:
   206	        """The head of an intact log, or CaseLogBroken naming the first bad entry. Every
   207	        append goes through it; sign-off (T27) must call it and refuse on the exception (R43)."""
   208	        check = self.verify()
   209	        if not check.ok:
   210	            raise CaseLogBroken(self.path, check.first_bad, check.reason, check.torn)
   211	        return check.head
   212	
   213	    def entries(self) -> list[Entry]:
   214	        """Every entry of an intact log; CaseLogBroken otherwise."""
   215	        check = self.verify()
   216	        if not check.ok:
   217	            raise CaseLogBroken(self.path, check.first_bad, check.reason, check.torn)
   218	        return check.entries
   219	
   220	    # --- writing -----------------------------------------------------------------------
   221	
   222	    @contextmanager
   223	    def writer(self) -> Iterator[CaseLog]:
   224	        """Hold the case's single-writer lock; refuses at once if another writer has it.
   225	
   226	        The thread that holds it may nest (a sign-off holds the lock across its checks and
   227	        its append). Any other writer is refused, whether it is another process, another
   228	        CaseLog on the same file, or another thread using this same instance: the lock
   229	        belongs to a thread, not to the object."""
   230	        me = threading.get_ident()
   231	        with self._state:
   232	            if self._owner == me:
   233	                self._lock_depth += 1
   234	            elif self._owner is not None:
   235	                raise CaseLocked(f"{self.path}: another window or command is writing to this case")
   236	            else:
