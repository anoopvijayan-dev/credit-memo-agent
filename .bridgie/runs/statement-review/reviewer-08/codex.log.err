   139	
   140	def _decode(line: bytes) -> Any:
   141	    """The entry a line holds, read strictly: no duplicate members, no NaN or Infinity,
   142	    and the line must be exactly the canonical bytes the writer produces. Anything a
   143	    lenient decoder would quietly reinterpret (a repeated member, 1e999 read as
   144	    infinity, other spacing or key order) is therefore not the entry that was hashed."""
   145	    obj = json.loads(line.decode("utf-8"), object_pairs_hook=_unique_members,
   146	                     parse_constant=_no_constant)
   147	    if _canonical(obj) != line:
   148	        raise ValueError("not in canonical form")
   149	    return obj
