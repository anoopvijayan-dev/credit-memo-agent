   128	
   129	def _unique_members(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
   130	    obj = dict(pairs)
   131	    if len(obj) != len(pairs):
   132	        raise ValueError("duplicate member")
   133	    return obj
