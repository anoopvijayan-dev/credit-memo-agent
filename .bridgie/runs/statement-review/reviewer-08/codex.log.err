   278	    def drop_torn_entry(self, *, expected: int, by: str) -> Entry:
   279	        """Cut an incomplete last entry off and record who confirmed it. `expected` is the
   280	        intact position the person was shown. Refused if the last entry is not torn, or
   281	        if the chain is broken before it (that is tampering, not a torn write)."""
