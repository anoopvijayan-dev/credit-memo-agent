   151	
   152	def _parse(line: bytes, n: int, prev: str) -> tuple[Entry | None, str]:
   153	    """Check one complete line as entry number `n` following hash `prev`."""
   154	    try:
   155	        obj = _decode(line)
   156	    except (UnicodeDecodeError, ValueError, TypeError, RecursionError):
   157	        return None, "is not a readable entry: it is not exactly what the log writes"
   158	    if not isinstance(obj, dict) or set(obj) != ENTRY_FIELDS:
   159	        return None, "has missing or extra fields"
   160	    seq, hsh = obj["seq"], obj["hash"]
   161	    if not isinstance(seq, int) or isinstance(seq, bool) or not isinstance(hsh, str) \
   162	            or not isinstance(obj["prev"], str) or not isinstance(obj["at"], str) \
   163	            or not isinstance(obj["event"], str) or not isinstance(obj["data"], dict):
   164	        return None, "has a field of the wrong type"
   165	    if entry_hash(obj) != hsh:
   166	        return None, "was changed: its hash does not match its content"
   167	    if seq != n:
   168	        return None, f"is out of place: it says it is entry {seq}; an entry is missing, added or reordered"
   169	    if obj["prev"] != prev:
   170	        return None, f"does not follow entry {n - 1}: the hash it carries for it does not match"
   171	    return Entry(**obj), ""
