   338	def _fsync_dir(path: Path) -> None:
   339	    if os.name == "nt":  # pragma: no cover - Windows cannot open a directory for fsync
   340	        return
   341	    fd = os.open(path, os.O_RDONLY)
   342	    try:
   343	        os.fsync(fd)
   344	    finally:
   345	        os.close(fd)
