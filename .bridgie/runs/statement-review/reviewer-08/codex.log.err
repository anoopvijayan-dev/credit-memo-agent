   112	def _canonical(obj: Any) -> bytes:
   113	    # allow_nan=False: NaN and Infinity are not JSON, and another reader of the log
   114	    # (verify, a future hosted version) must be able to recompute every hash.
   115	    return json.dumps(
   116	        obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
   117	    ).encode("utf-8")
