   120	def entry_hash(entry: dict[str, Any]) -> str:
   121	    """sha256 over the canonical JSON of the hashed fields (everything but `hash`)."""
   122	    return hashlib.sha256(_canonical({k: entry.get(k) for k in HASHED_FIELDS})).hexdigest()
