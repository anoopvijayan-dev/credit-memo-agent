+                    trading(d, desc, round(base * frng.uniform(0.8, 1.2), 2), Category.REVENUE_CARD)
+        trading(mid + timedelta(days=12), ACQUIRER_PAYOUTS[0][0], round(base * 4, 2), Category.REVENUE_CARD)
