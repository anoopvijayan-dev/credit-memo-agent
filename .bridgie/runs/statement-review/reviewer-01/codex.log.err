    98	@app.command()
    99	def resume(
   100	    thread: str = typer.Argument(..., help="The review id printed by `cma run --checkpoint-db`."),
   101	    checkpoint_db: Path = typer.Option(..., help="The SQLite file the review was kept in."),
   102	    reviewer: str | None = typer.Option(None, help="Your name, recorded on the memo."),
   103	    out: Path | None = typer.Option(None, help="As for `cma run`."),
   104	):
   105	    """Pick up a memo that is waiting for review, after a restart."""
   106	    if not checkpoint_db.exists():
   107	        console.print(f"[red]{checkpoint_db} does not exist.[/red]")
   108	        raise typer.Exit(code=2)
   109	    _refuse_to_overwrite(out)
   110	    with _checkpointer(checkpoint_db) as saver:
   111	        graph = build(get_llm("fake"), checkpointer=saver)  # the draft is already made; no model call
   112	        cfg = {"configurable": {"thread_id": thread}}
   113	        snap = graph.get_state(cfg)
   114	        if not snap.interrupts:
   115	            console.print(f"[red]Nothing is waiting for review under {thread}.[/red]")
   116	            raise typer.Exit(code=1)
   117	        problem = _stored_state_problem(snap.values)
   118	        if problem:
   119	            console.print(f"[red]Not resuming {thread}:[/red] {problem}")
   120	            raise typer.Exit(code=2)
   121	        state = {**snap.values, "__interrupt__": snap.interrupts}
   122	        _review(graph, cfg, state, reviewer, False, out)
   123	
   124	
   125	def _stored_state_problem(values: dict) -> str | None:
   126	    """A stored review is only resumed if it still says what it said: the statement file
   127	    is unchanged and the stored memo still passes (or fails) the guard the same way."""
   128	    path = Path(values["statement_path"])
   129	    if not path.is_file():
   130	        return f"the statement {path} is no longer there"
   131	    if hashlib.sha256(path.read_bytes()).hexdigest() != values.get("statement_sha256"):
   132	        return f"the statement {path} has changed since the memo was drafted"
   133	    again = grd.check(values["memo"], values["metrics"], values["policy"], required_headings=grd.REQUIRED_HEADINGS)
   134	    if again.grounded != values["guard"].grounded:
   135	        return "the stored grounding result does not match the stored memo"
   136	    return None
   137	
   138	
   139	def _refuse_to_overwrite(out: Path | None) -> None:
   140	    """Never replace an earlier memo or its evidence: the pair is the audit record."""
   141	    if out is None:
   142	        return
   143	    taken = [p for p in _outputs(out) if p.exists()]
   144	    if taken:
   145	        console.print(f"[red]Refusing to overwrite {', '.join(map(str, taken))}. Choose another --out.[/red]")
   146	        raise typer.Exit(code=2)
   147	
   148	
   149	def _outputs(out: Path) -> list[Path]:
   150	    rejected = out.with_name(out.stem + ".rejected.md")
   151	    return [out, _evidence_path(out), rejected, _evidence_path(rejected)]
   152	
   153	
   154	def _evidence_path(memo: Path) -> Path:
   155	    return memo.with_name(memo.stem + ".evidence.json")
   156	
   157	
   158	@contextmanager
   159	def _checkpointer(path: Path | None):
   160	    if path is None:
   161	        yield None
   162	        return
   163	    try:
   164	        with sqlite_checkpointer(path) as saver:
   165	            yield saver
   166	    except RuntimeError as e:
   167	        console.print(f"[red]{e}[/red]")
   168	        raise typer.Exit(code=2) from e
   169	
   170	
   171	def _review(graph, cfg, state, reviewer, yes, out):
   172	    interrupts = state.get("__interrupt__") or []
   173	    if not interrupts:
   174	        raise typer.Exit(code=1)
   175	    payload = interrupts[0].value
   176	
   177	    _print_metrics(state["metrics"])
   178	    _print_policy(state["policy"])
   179	    console.rule("Draft memo")
   180	    console.print(Markdown(payload["memo"]))
   181	    console.rule("Grounding check")
   182	    grounded = payload["guard_grounded"]
   183	    if grounded:
   184	        console.print("[green]All figures trace to the metrics table or the policy.[/green]")
   185	    else:
   186	        console.print(f"[red]Unmatched numbers:[/red] {payload['guard_unmatched']}")
   187	        if payload["guard_missing_citations"]:
   188	            console.print(f"[red]Figures quoted without their tag:[/red] {payload['guard_missing_citations']}")
   189	
   190	    if yes:
   191	        if not grounded:
   192	            console.print("[red]--yes will not approve a memo that failed the grounding check. Review it interactively.[/red]")
   193	            raise typer.Exit(code=3)
   194	        decision = {"approved": True, "reviewer": reviewer, "mode": "automated",
   195	                    "notes": "Approved by script (--yes); the draft was not reviewed interactively."}
   196	    else:
   197	        decision = _ask(payload, grounded, reviewer)
   198	
   199	    final = _decide(graph, cfg, decision)
   200	    while "__interrupt__" in final:
   201	        payload = final["__interrupt__"][0].value
   202	        console.print(f"[red]Not accepted:[/red] {payload['error']}")
   203	        if yes:
   204	            raise typer.Exit(code=3)
   205	        decision = _ask(payload, grounded, reviewer)
   206	        final = _decide(graph, cfg, decision)
   207	
   208	    approved = final["review"].approved
   209	    if out:
   210	        target = out if approved else out.with_name(out.stem + ".rejected.md")
   211	        evidence = _evidence_path(target)
   212	        target.write_text(final["final_memo"])
   213	        evidence.write_text(json.dumps(evidence_record(final), indent=2, default=str))
   214	        console.print(f"wrote {target} and {evidence}")
   215	    if not approved:
   216	        console.rule("Not approved")
   217	        console.print(Markdown(final["final_memo"]))
   218	        raise typer.Exit(code=1)
   219	    if not out:
   220	        console.rule("Final")
    65	@dataclass(frozen=True)
    66	class Ruleset:
    67	    id: str
    68	    sha256: str
    69	    rules: tuple[Rule, ...]
    70	
    71	
    72	def validate_ruleset(data: object, expected_id: str, source: str = "rules") -> None:
    73	    if not isinstance(data, dict):
    74	        raise RulesetError(f"{source}: not a mapping")
    75	    problems: list[str] = []
    76	    if "id" not in data:
    77	        problems.append("missing id")
    78	    elif data["id"] != expected_id:
    79	        problems.append(f"id {data['id']!r} does not match the file ({expected_id!r})")
    80	    if not isinstance(data.get("frozen"), bool):
    81	        problems.append("frozen must be true or false")
    82	    for key in sorted(set(data) - TABLE_KEYS):
    83	        problems.append(f"unknown key {key!r}")
    84	    rules = data.get("rules")
    85	    if not isinstance(rules, list) or not rules:
    86	        raise RulesetError(f"{source}: " + "; ".join([*problems, "no rules"]))
    87	    categories = {c.value for c in Category}
    88	    seen: set[object] = set()
    89	    for i, r in enumerate(rules, start=1):
    90	        where = f"rule {i} ({r.get('id', '?') if isinstance(r, dict) else '?'})"
    91	        if not isinstance(r, dict):
    92	            problems.append(f"{where}: not a mapping")
    93	            continue
    94	        for key in sorted(RULE_KEYS - set(r)):
    95	            problems.append(f"{where}: missing {key}")
    96	        for key in sorted(set(r) - RULE_KEYS):
    97	            problems.append(f"{where}: unknown key {key!r}")
    98	        if "id" in r:
    99	            if r["id"] in seen:
   100	                problems.append(f"{where}: duplicate id")
   101	            seen.add(r["id"])
   102	        if "direction" in r and r["direction"] not in DIRECTIONS:
   103	            problems.append(f"{where}: direction {r['direction']!r} is not one of {list(DIRECTIONS)}")
   104	        if "category" in r and r["category"] not in categories:
   105	            problems.append(f"{where}: category {r['category']!r} is not a category")
   106	        if "pattern" in r:
   107	            try:
   108	                if not isinstance(r["pattern"], str) or not r["pattern"]:
   109	                    raise re.error("not a non-empty string")
   110	                re.compile(r["pattern"])
   111	            except re.error as e:
   112	                problems.append(f"{where}: pattern does not compile ({e})")
   113	    if problems:
   114	        raise RulesetError(f"{source}: " + "; ".join(problems))
   115	
   116	
   117	def ruleset_from_data(data: object, expected_id: str, source: str, sha256: str) -> Ruleset:
   118	    validate_ruleset(data, expected_id, source)
   119	    assert isinstance(data, dict)
   120	    return Ruleset(
   121	        id=data["id"],
   122	        sha256=sha256,
   123	        rules=tuple(
   124	            Rule(r["id"], re.compile(r["pattern"]), r["direction"], Category(r["category"]))
   125	            for r in data["rules"]
   126	        ),
   127	    )
   128	
   129	
   130	@lru_cache
   131	def load_ruleset(ruleset_id: str) -> Ruleset:
   132	    """A packaged table by id. Only ids in RULESETS load, so an id never names a path."""
   133	    if ruleset_id not in RULESETS:
   134	        raise RulesetError(f"unknown ruleset {ruleset_id!r}; known: {', '.join(RULESETS)}")
   135	    source = f"cma/rules/{ruleset_id}.yaml"
   136	    text = resources.files("cma.rules").joinpath(f"{ruleset_id}.yaml").read_text()
   137	    try:
   138	        data = yaml.safe_load(text)
   139	    except yaml.YAMLError as e:
   140	        raise RulesetError(f"{source}: not valid YAML ({e.__class__.__name__})") from e
   141	    return ruleset_from_data(data, ruleset_id, source, hashlib.sha256(text.encode()).hexdigest())
   142	
   143	
   144	def active_ruleset() -> Ruleset:
   145	    """The table CMA_RULESET names, or the default when it is unset."""
   146	    chosen = os.environ.get(RULESET_ENV) or DEFAULT_RULESET
   147	    try:
   148	        return load_ruleset(chosen)
   149	    except RulesetError as e:
   150	        raise RulesetError(f"{RULESET_ENV}={chosen!r}: {e}") from e
   151	
   152	
   153	def _direction_ok(direction: Direction, amount: float) -> bool:
   154	    if direction == "any":
   155	        return True
   165	
   166	
   167	def evidence_record(s: MemoState) -> dict:
   168	    """Everything needed to audit the memo later, as plain JSON."""
   169	    return {
   170	        "statement": {"path": s["statement_path"], "sha256": s.get("statement_sha256"),
   171	                      "start": str(s["statement"].start), "end": str(s["statement"].end),
   172	                      "transactions": len(s["statement"].transactions)},
   173	        "model": s.get("model"),
   174	        "vat_stagger": s.get("vat_stagger"),
   175	        "ruleset": s.get("ruleset"),
   176	        "metrics": [m.model_dump() for m in s["metrics"]],
   177	        "policy": s["policy"].model_dump(mode="json"),
   178	        "guard": {**s["guard"].model_dump(), "grounded": s["guard"].grounded},
   179	        "redrafts": s.get("redrafts", 0),
   180	        "review": s["review"].model_dump(mode="json") if s.get("review") else None,
   181	        "memo": s.get("memo"),
   182	    }
   183	
   184	
   185	def build(llm: LLM | None = None, checkpointer=None):
   186	    llm = llm or get_llm()
   187	
   188	    def load(s: MemoState) -> MemoState:
   189	        path = Path(s["statement_path"])
   190	        statement = ingest.load_csv(path)
   191	        return {
   192	            "statement": statement,
   193	            "statement_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
   194	            "model": f"{llm.name}:{getattr(llm, 'model', '-')}",
   195	            # A run starts clean, even on a thread that has run before.
   196	            "redrafts": 0,
   197	            "guard_feedback": "",
   198	            "review": None,
   199	            "final_memo": None,
   200	        }
   201	
   202	    def categorise(s: MemoState) -> MemoState:
   203	        rules = cat.active_ruleset()
   204	        return {"statement": cat.categorise(s["statement"], rules),
   205	                "ruleset": {"id": rules.id, "sha256": rules.sha256}}
   206	
   207	    def metrics(s: MemoState) -> MemoState:
   208	        return {"metrics": met.compute(s["statement"], vat_stagger=s.get("vat_stagger"))}
   209	
   210	    def policy(s: MemoState) -> MemoState:
   211	        p = pol.load_policy(Path(s["policy_path"])) if s.get("policy_path") else None
   212	        return {"policy": pol.evaluate(s["metrics"], p)}
   213	
   214	    def draft(s: MemoState) -> MemoState:
   215	        table = met.as_table(s["metrics"])
