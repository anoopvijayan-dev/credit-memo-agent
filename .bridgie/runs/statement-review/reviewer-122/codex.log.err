    71	
    72	class LockedASGIApp:
    73	    """The MCP server's ASGI app, checking the offline lock each time it is used.
    74	
    75	    An app made while the lock was off can be handed to an ASGI server later. So the app
    76	    reads firm.yaml again when the ASGI server starts it: under the lock its start-up fails
    77	    (lifespan.startup.failed), and an ASGI server such as uvicorn runs that start-up before it
    78	    opens its listening socket, so it never listens. It also reads firm.yaml on every
    79	    connection, and refuses one under the lock before the MCP app sees it (HTTP 503, or a
    80	    WebSocket closed), for an ASGI server that skips the start-up event."""
    81	
    82	    def __init__(self, app):
    83	        self.app = app
    84	
    85	    def __getattr__(self, name):  # routes, state, ... of the wrapped Starlette app
    86	        return getattr(self.app, name)
    87	
    88	    async def __call__(self, scope, receive, send):
    89	        if scope["type"] == "lifespan":
    90	            return await self._lifespan(scope, receive, send)
    91	        problem = _lock_problem("A connection to the MCP server")
    92	        if problem is None:
    93	            return await self.app(scope, receive, send)
    94	        if scope["type"] == "http":
    95	            body = problem.encode()
    96	            await send({"type": "http.response.start", "status": 503,
    97	                        "headers": [(b"content-type", b"text/plain; charset=utf-8"),
    98	                                    (b"content-length", str(len(body)).encode())]})
    99	            await send({"type": "http.response.body", "body": body})
   100	        elif scope["type"] == "websocket":
   101	            await send({"type": "websocket.close", "code": 1013, "reason": problem[:120]})
   102	
   103	    async def _lifespan(self, scope, receive, send):
   104	        message = await receive()
   105	        if message["type"] == "lifespan.startup":
   106	            problem = _lock_problem("Starting the MCP server")
   107	            if problem is not None:
   108	                await send({"type": "lifespan.startup.failed", "message": problem})
   109	                return
   110	        first = [message]
   111	
   112	        async def replay():
   113	            return first.pop() if first else await receive()
   114	
   115	        return await self.app(scope, replay, send)
   116	
   117	
   118	server = LockedMCPServer("credit-memo-agent")
