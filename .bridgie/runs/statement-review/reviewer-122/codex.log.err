   121	    _refuse_to_overwrite(out)
   122	    with _checkpointer(checkpoint_db) as saver:
   123	        graph = build(get_llm("fake"), checkpointer=saver)  # the draft is already made; no model call
   124	        cfg = {"configurable": {"thread_id": thread}}
   125	        snap = graph.get_state(cfg)
    42	    work = out_dir / "statements"
    43	    graph = build(get_llm(args.llm))
    44	
    45	    results = []
    46	    for archetype in synth.ARCHETYPES:
    47	        for profile in synth.PROFILES:
    48	            rows, truth = synth.generate(archetype, profile, end=date(2026, 9, 30))
    49	            csv_path, _ = synth.write(rows, truth, work, stem=f"{archetype}_{profile}")
    50	            cfg = {"configurable": {"thread_id": f"{archetype}-{profile}"}}
    51	            t0 = time.perf_counter()
    52	            state = graph.invoke({"statement_path": str(csv_path), "vat_stagger": truth.vat_stagger}, cfg)
    53	            graph.invoke(Command(resume={"approved": False, "reviewer": "eval", "notes": "evaluation run"}), cfg)
    54	            m = {x.id: x.value for x in state["metrics"]}
    55	            mismatches = [mid for mid, expected in truth_metrics(truth).items() if not same(m[mid], expected)]
    56	            results.append(
    57	                {
    58	                    "case": f"{archetype}/{profile}",
    59	                    "policy": state["policy"].overall.value,
    60	                    "grounded": state["guard"].grounded,
    61	                    "grounding_rate": round(state["guard"].grounding_rate, 3),
    62	                    "numbers_checked": state["guard"].numbers_checked,
    63	                    "unmatched": [f"{f.number_text}: {f.reason}" for f in state["guard"].unmatched],
    64	                    "redrafts": state.get("redrafts", 0),
    65	                    "truth_mismatches": mismatches,
    66	                    "seconds": round(time.perf_counter() - t0, 2),
    67	                }
    68	            )
    69	
    70	    (out_dir / f"{args.llm}.json").write_text(json.dumps(results, indent=2))
    71	    print(f"{'case':22} {'policy':7} {'grounded':9} {'rate':6} {'redrafts':8} {'truth':14} {'s':>5}")
    72	    for r in results:
    73	        truth_col = "ok" if not r["truth_mismatches"] else ",".join(r["truth_mismatches"])
    74	        print(
    75	            f"{r['case']:22} {r['policy']:7} {r['grounded']!s:9} {r['grounding_rate']:<6} "
    76	            f"{r['redrafts']:<8} {truth_col:14} {r['seconds']:>5}"
    77	        )
    78	    grounded = sum(r["grounded"] for r in results)
    79	    print(f"\n{grounded}/{len(results)} memos fully grounded; model = {args.llm}")
    80	    truth_ok = all(not r["truth_mismatches"] for r in results)
    81	    fake_ok = args.llm != "fake" or grounded == len(results)
    82	    return 0 if truth_ok and fake_ok else 1
