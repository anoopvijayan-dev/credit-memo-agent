   178	def redraft_ids(g: GuardResult, metrics: list[Metric], policy: PolicyResult) -> list[str]:
   179	    """The metric and rule ids the guard flagged, and only ids that are in the tables, so
   180	    nothing the model wrote (a made-up tag included) goes back into a prompt."""
   181	    known = {m.id for m in metrics} | {r.rule_id for r in policy.rules}
   182	    found = set(g.missing_citations)
   183	    for f in g.unmatched:
   184	        found.update(re.findall(r"\b[MR]\d+\b", f.reason))
   185	    return sorted(found & known, key=lambda i: (i[0], int(i[1:])))
   186	
   187	
   188	def draft_prompt(statement: Statement, metrics: list[Metric], policy: PolicyResult,
   189	                 redraft: list[str] | None = None) -> str:
   190	    """The user prompt: the tables (the overall outcome as a rule-table row), the period and
   191	    the placeholder name. A redraft adds one line of metric and rule ids, nothing else."""
