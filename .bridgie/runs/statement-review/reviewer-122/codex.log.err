    83	def evaluate(metrics: list[Metric], policy: dict | None = None) -> PolicyResult:
    84	    policy = policy or load_policy()
    85	    by_id = {m.id: m for m in metrics}
    86	    validate(policy, metric_ids=set(by_id))
    87	    results: list[RuleResult] = []
    88	    for rule in policy["rules"]:
    89	        m = by_id[rule["metric"]]
    90	        req = f"rule requires {rule['op']} {rule['threshold']}"
    91	        if m.value is None:
    92	            outcome = RuleOutcome(rule.get("when_missing", "refer"))
    93	            detail = f"{m.name} cannot be computed ({m.method}); policy says {outcome.value} when missing."
    94	        else:
    95	            passed = OPS[rule["op"]](m.value, rule["threshold"])
    96	            if passed:
    97	                outcome = RuleOutcome.PASS
    98	                # Soft bands: close to the threshold still gets a human look.
    99	                if "refer_below" in rule and m.value < rule["refer_below"]:
   100	                    outcome = RuleOutcome.REFER
   101	                    req += f", referred below {rule['refer_below']}"
   102	                if "refer_above" in rule and m.value > rule["refer_above"]:
   103	                    outcome = RuleOutcome.REFER
   104	                    req += f", referred above {rule['refer_above']}"
   105	            else:
   106	                outcome = RuleOutcome(rule["on_fail"])
   107	            detail = f"{m.name} is {m.display()}; {req}."
   108	        results.append(
   109	            RuleResult(
   110	                rule_id=rule["id"], description=rule["description"], metric_id=m.id,
   111	                outcome=outcome, detail=detail, op=rule["op"], threshold=float(rule["threshold"]),
   112	                refer_below=rule.get("refer_below"), refer_above=rule.get("refer_above"), unit=m.unit,
   113	            )
   114	        )
   115	    if any(r.outcome == RuleOutcome.FAIL for r in results):
   116	        overall = RuleOutcome.FAIL
   117	    elif any(r.outcome == RuleOutcome.REFER for r in results):
   118	        overall = RuleOutcome.REFER
   119	    else:
   120	        overall = RuleOutcome.PASS
   121	    return PolicyResult(
   122	        policy_name=policy["name"], overall=overall, rules=results, policy_sha256=policy.get("_sha256", "")
   123	    )
