   121	def data_dir() -> Path:
   122	    raw = os.environ.get("CMA_DATA_DIR")
   123	    if not raw:
   124	        raise ValueError("CMA_DATA_DIR is not set; set it to the folder of statements this server may read")
   125	    return Path(raw).resolve()
   126	
   127	
   128	def safe_path(raw: str, suffixes: tuple[str, ...]) -> Path:
   129	    """Resolve `raw` inside the data directory, or refuse."""
   130	    root = data_dir()
   131	    p = Path(raw)
   132	    p = (p if p.is_absolute() else root / p).resolve()
   133	    if not p.is_relative_to(root):
   134	        raise ValueError(f"{raw}: outside the data directory {root} (set CMA_DATA_DIR)")
   135	    if p.suffix.lower() not in suffixes:
   136	        raise ValueError(f"{raw}: only {', '.join(suffixes)} files can be read")
   137	    if not p.is_file():
   138	        raise ValueError(f"{raw}: no such file")
   139	    return p
   140	
   141	
   142	def _statement(path: str):
   143	    # Every tool starts here, so none reads a file while the lock is on.
   144	    firm.require_unlocked("An MCP tool call")
   145	    p = safe_path(path, (".csv",))
   146	    try:
   147	        return ingest.load_csv(p)
   148	    except ingest.StatementError as e:
   149	        lines = sorted({x.split(":", 1)[0] for x in e.problems})
   150	        raise ValueError(f"{path}: statement refused, {len(e.problems)} problem(s) on {', '.join(lines[:10])}; "
   151	                         "run `cma run` locally to see them") from None
