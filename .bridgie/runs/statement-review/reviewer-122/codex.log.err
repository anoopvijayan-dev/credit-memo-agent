   110	@app.command()
   111	def resume(
   112	    thread: str = typer.Argument(..., help="The review id printed by `cma run --checkpoint-db`."),
   113	    checkpoint_db: Path = typer.Option(..., help="The SQLite file the review was kept in."),
   114	    reviewer: str | None = typer.Option(None, help="Your name, recorded on the memo."),
   115	    out: Path | None = typer.Option(None, help="As for `cma run`."),
   116	):
   117	    """Pick up a memo that is waiting for review, after a restart."""
   118	    if not checkpoint_db.exists():
