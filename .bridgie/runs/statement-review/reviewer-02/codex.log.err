    81	@server.tool()
    82	def check_policy(path: str, policy_path: str | None = None, vat_stagger: int | None = None) -> dict:
    83	    """Run the lending policy against a statement and return pass/refer/fail per rule."""
    84	    s = categorise.categorise(_statement(path))
    85	    p = policy.load_policy(safe_path(policy_path, (".yaml", ".yml"))) if policy_path else None
    86	    return policy.evaluate(metrics.compute(s, vat_stagger=vat_stagger), p).model_dump()
