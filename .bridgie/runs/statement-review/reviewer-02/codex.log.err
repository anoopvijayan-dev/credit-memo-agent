    30	def data_dir() -> Path:
    31	    raw = os.environ.get("CMA_DATA_DIR")
    32	    if not raw:
    33	        raise ValueError("CMA_DATA_DIR is not set; set it to the folder of statements this server may read")
    34	    return Path(raw).resolve()
