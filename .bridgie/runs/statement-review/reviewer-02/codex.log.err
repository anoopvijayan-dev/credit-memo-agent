   222	
   223	def _decide(graph, cfg, decision: dict) -> dict:
   224	    """Resume with this decision, and make sure it is the one that was recorded.
   225	
   226	    Two people can open the same pending review from a shared --checkpoint-db. If
   227	    someone else decided first, resuming is a no-op that returns *their* decision; say
   228	    so instead of reporting it as ours.
   229	    """
   230	    if not graph.get_state(cfg).interrupts:
   231	        _decided_elsewhere(graph.get_state(cfg).values)
   232	    final = graph.invoke(Command(resume=decision), cfg)
   233	    review = final.get("review")
   234	    if "__interrupt__" not in final and (
   235	        review is None or review.reviewer != (decision.get("reviewer") or "").strip()
   236	        or review.approved != decision.get("approved")
   237	    ):
   238	        _decided_elsewhere(final)
   239	    return final
   240	
