    73	@server.tool()
    74	def compute_metrics(path: str, vat_stagger: int | None = None) -> list[dict]:
    75	    """Categorise a statement and compute the cited metrics table (M1..M16).
    76	    vat_stagger is the HMRC stagger group (1, 2 or 3); without it M13 is n/a."""
    77	    s = categorise.categorise(_statement(path))
    78	    return [m.model_dump() for m in metrics.compute(s, vat_stagger=vat_stagger)]
