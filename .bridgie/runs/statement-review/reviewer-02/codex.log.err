    36	
    37	def safe_path(raw: str, suffixes: tuple[str, ...]) -> Path:
    38	    """Resolve `raw` inside the data directory, or refuse."""
    39	    root = data_dir()
    40	    p = Path(raw)
    41	    p = (p if p.is_absolute() else root / p).resolve()
    42	    if not p.is_relative_to(root):
    43	        raise ValueError(f"{raw}: outside the data directory {root} (set CMA_DATA_DIR)")
    44	    if p.suffix.lower() not in suffixes:
    45	        raise ValueError(f"{raw}: only {', '.join(suffixes)} files can be read")
    46	    if not p.is_file():
    47	        raise ValueError(f"{raw}: no such file")
    48	    return p
    49	
