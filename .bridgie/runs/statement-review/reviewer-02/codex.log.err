    89	@server.tool()
    90	def transactions_for(path: str, ids: list[str], include_descriptions: bool = False) -> list[dict]:
    91	    """Return the statement lines behind a metric's evidence ids, so a reviewer can check a
    92	    figure. Descriptions are payer-written text; they are only included when asked for,
    93	    and then under `untrusted_description`."""
    94	    by_id = _statement(path).by_id()
    95	    out = []
    96	    for i in ids:
    97	        if i not in by_id:
    98	            continue
    99	        t = by_id[i]
   100	        row = {"id": t.id, "date": t.date.isoformat(), "amount": t.amount, "balance": t.balance,
   101	               "category": t.category.value if t.category else None}
   102	        if include_descriptions:
   103	            row["untrusted_description"] = t.description
   104	        out.append(row)
   105	    return out
