   133	def _table_text(ruleset_id: str) -> str:
   134	    return resources.files("cma.rules").joinpath(f"{ruleset_id}.yaml").read_text()
   135	
   136	
   137	@lru_cache
   138	def load_ruleset(ruleset_id: str) -> Ruleset:
   139	    """A packaged table by id. Only ids in RULESETS load, so an id never names a path."""
   140	    if ruleset_id not in RULESETS:
   141	        raise RulesetError(f"unknown ruleset {ruleset_id!r}; known: {', '.join(RULESETS)}")
   142	    source = f"cma/rules/{ruleset_id}.yaml"
   143	    text = _table_text(ruleset_id)
   144	    try:
   145	        data = yaml.safe_load(text)
   146	    except yaml.YAMLError as e:
   147	        raise RulesetError(f"{source}: not valid YAML ({e.__class__.__name__})") from e
   148	    return ruleset_from_data(data, ruleset_id, source, hashlib.sha256(text.encode()).hexdigest())
   149	
   150	
   151	def active_ruleset() -> Ruleset:
   152	    """The table CMA_RULESET names, or the default when it is unset."""
   153	    chosen = os.environ.get(RULESET_ENV) or DEFAULT_RULESET
   154	    try:
   155	        return load_ruleset(chosen)
   156	    except RulesetError as e:
   157	        raise RulesetError(f"{RULESET_ENV}={chosen!r}: {e}") from e
