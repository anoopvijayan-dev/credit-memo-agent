    62	def sqlite_checkpointer(path: Path):
    63	    """A checkpointer that survives restarts, so a memo waiting for review is not lost."""
    64	    try:
    65	        import sqlite3
    66	
    67	        from langgraph.checkpoint.sqlite import SqliteSaver
    68	    except ImportError as e:  # pragma: no cover - depends on the optional extra
    69	        raise RuntimeError("durable checkpoints need: pip install 'credit-memo-agent[durable]'") from e
    70	    conn = sqlite3.connect(str(path), check_same_thread=False)
    71	    try:
    72	        yield SqliteSaver(conn, serde=_serde())
    73	    finally:
    74	        conn.close()
