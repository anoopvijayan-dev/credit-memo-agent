   224	def _decide(graph, cfg, decision: dict) -> dict:
   225	    """Resume with this decision, and make sure it is the one that was recorded.
   226	
   227	    Two people can open the same pending review from a shared --checkpoint-db. If
   228	    someone else decided first, resuming is a no-op that returns *their* decision; say
   229	    so instead of reporting it as ours.
   230	    """
   231	    if not graph.get_state(cfg).interrupts:
   232	        _decided_elsewhere(graph.get_state(cfg).values)
   233	    final = graph.invoke(Command(resume=decision), cfg)
   234	    review = final.get("review")
   235	    if "__interrupt__" not in final and (
   236	        review is None or review.reviewer != (decision.get("reviewer") or "").strip()
   237	        or review.approved != decision.get("approved")
   238	    ):
   239	        _decided_elsewhere(final)
   240	    return final
   241	
   242	
   243	def _decided_elsewhere(values: dict) -> None:
   244	    r = values.get("review")
   245	    who = f"{r.reviewer} at {r.decided_at:%Y-%m-%d %H:%M UTC}" if r else "someone else"
   246	    console.print(f"[red]This review was already decided by {who}. Your decision was not recorded.[/red]")
   247	    raise typer.Exit(code=5)
   248	
