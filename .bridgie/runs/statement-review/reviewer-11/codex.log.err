   155	def _table_bytes(ruleset_id: str) -> bytes:
   156	    return resources.files("cma.rules").joinpath(f"{ruleset_id}.yaml").read_bytes()
   157	
   158	
   159	@lru_cache
   160	def load_ruleset(ruleset_id: str) -> Ruleset:
   161	    """A packaged table by id. Only ids in RULESETS load, so an id never names a path."""
   162	    if ruleset_id not in RULESETS:
   163	        raise RulesetError(f"unknown ruleset {ruleset_id!r}; known: {', '.join(RULESETS)}")
   164	    source = f"cma/rules/{ruleset_id}.yaml"
   165	    try:
   166	        raw = _table_bytes(ruleset_id)
   167	    except (OSError, ImportError) as e:  # ImportError: the cma.rules package itself is gone
   168	        raise RulesetError(f"{source}: cannot be read from the installed package ({e.__class__.__name__})") from e
   169	    try:
   170	        data = yaml.load(raw.decode("utf-8"), Loader=_UniqueKeyLoader)
   171	    except UnicodeDecodeError as e:
   172	        raise RulesetError(f"{source}: not UTF-8 text") from e
   173	    except yaml.YAMLError as e:
   174	        problem = getattr(e, "problem", None) or e.__class__.__name__
   175	        raise RulesetError(f"{source}: not valid YAML ({problem})") from e
   176	    except RecursionError as e:
   177	        raise RulesetError(f"{source}: not valid YAML (nested too deeply)") from e
   178	    # The hash is of the file's bytes as installed, so it matches sha256sum on that file.
   179	    return ruleset_from_data(data, ruleset_id, source, hashlib.sha256(raw).hexdigest())
   180	
   181	
   182	def active_ruleset() -> Ruleset:
   183	    """The table CMA_RULESET names, or the default when it is unset."""
   184	    chosen = os.environ.get(RULESET_ENV) or DEFAULT_RULESET
   185	    try:
   186	        return load_ruleset(chosen)
   187	    except RulesetError as e:
   188	        raise RulesetError(f"{RULESET_ENV}={chosen!r}: {e}") from e
