def _rule_pattern(r: dict) -> re.Pattern[str]:
    parts = [p for p in (r.get("pattern"), names_pattern(r["names"]) if "names" in r else None) if p]
    return re.compile(parts[0] if len(parts) == 1 else "|".join(f"(?:{p})" for p in parts))


