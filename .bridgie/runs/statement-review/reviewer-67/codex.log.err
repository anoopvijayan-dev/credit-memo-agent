+        if cat[0] == "M":
+            if start is None:
+                start = cp
+            prev = cp
+            continue
+        if start is not None:
+            marks.append((start, prev))
+            start = None
+        if cat in ("Pd", "Cf"):
+            gaps.append(re.escape(chr(cp)))
+    if start is not None:
+        marks.append((start, prev))
+    ranges = "".join(f"\\U{a:08x}" if a == b else f"\\U{a:08x}-\\U{b:08x}" for a, b in marks)
+    return ranges, "".join(gaps)
