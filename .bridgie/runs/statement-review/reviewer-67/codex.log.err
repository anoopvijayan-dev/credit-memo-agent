+_BOUNDARY = rf"(?:{WORD_START}(?={_WORD_CHAR})|(?<=[^\W_])(?![^\W_])(?![{_MARKS}])|(?<=[{_MARKS}])(?![^\W_])(?![{_MARKS}]))"
