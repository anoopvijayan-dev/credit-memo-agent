+def test_the_entry_append_returns_is_the_entry_read_back(tmp_path):
+    log = case.CaseLog(tmp_path / "log.jsonl")
+    written = log.append("override", {"a": [1, 2.5, None, True], "m": {"k": "v"}, "s": "é"}, expected=0)
+    assert log.entries() == [written]
