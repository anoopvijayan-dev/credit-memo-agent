+@pytest.mark.invariants
+@pytest.mark.parametrize("first", ["gate", "lock"])
+def test_p15_a_lock_file_replaced_just_after_its_path_was_checked_is_still_caught(tmp_path, monkeypatch, first):
+    """T12 review 38: whichever file is looked at first, a replacement made right after its
+    path was checked leaves the held file with no name, which the last test sees."""
+    log = _log(tmp_path, 2)
+    real_stat, armed, done = case.os.stat, [], []
+    monkeypatch.setattr(case, "_utc_now", lambda real=case._utc_now: (armed.append(1), real())[1])
+    other = log.lock_path if first == "gate" else log.gate_path
+    target = log.gate_path if first == "gate" else log.lock_path
+
+    def stat(p, *a, **k):
+        got = real_stat(p, *a, **k)
+        if armed and not done and str(p) == str(other):
+            done.append(1)
+            _replace_file(target)  # the one already checked
+        return got
+
+    monkeypatch.setattr(case.os, "stat", stat)
+    with pytest.raises(case.CaseLocked, match="removed or replaced"):
+        log.append("override", {"n": 3}, expected=2)
+    monkeypatch.undo()
+    assert len(_lines(log)) == 2
+
+
+@pytest.mark.invariants
+@pytest.mark.parametrize("move_aside", [True, False])
+def test_p15_a_gate_moved_aside_and_replaced_after_its_first_look_is_caught(tmp_path, monkeypatch, move_aside):
+    """T12 review 39: the gate is moved to another name (so its link count stays one) and
+    replaced while the case lock is being looked at; the gate is looked at again after it."""
+    log = _log(tmp_path, 2)
+    real_stat, armed, done = case.os.stat, [], []
+    monkeypatch.setattr(case, "_utc_now", lambda real=case._utc_now: (armed.append(1), real())[1])
+
+    def stat(p, *a, **k):
+        got = real_stat(p, *a, **k)
+        if armed and not done and str(p) == str(log.lock_path):
+            done.append(1)
+            if move_aside:
+                os.rename(log.gate_path, log.gate_path.with_name("aside"))
+            _replace_file(log.gate_path)
+        return got
+
+    monkeypatch.setattr(case.os, "stat", stat)
+    with pytest.raises(case.CaseLocked, match="removed or replaced"):
+        log.append("override", {"n": 3}, expected=2)
+    monkeypatch.undo()
+    assert len(_lines(log)) == 2
+
+
+
+@pytest.mark.invariants
+@pytest.mark.parametrize("exc", ["conflict", "broken"])
+def test_another_operations_conflict_after_the_line_is_still_this_saves_report(tmp_path, monkeypatch, exc):
+    """T12 review 41: a callback's LogConflict or CaseLogBroken, raised once this save's line
+    is in the log, never becomes this save's report: it says not recorded, in its own words."""
+    log = _log(tmp_path, 2)
+
+    def callback(self, recorded, entry):
+        if exc == "conflict":
+            raise case.LogConflict(9, 10)
+        raise case.CaseLogBroken(self.path, 7, "is not a readable entry", False)
+
+    monkeypatch.setattr(case.CaseLog, "_publish", callback)
+    with pytest.raises(case.SaveNotRecorded, match="entry was written") as e:
+        log.append("override", {"n": 3}, expected=2)
+    assert not isinstance(e.value, (case.LogConflict, case.CaseLogBroken))
+    monkeypatch.undo()
+    check = case.CaseLog(log.path).verify()
+    assert check.torn and check.first_bad == 3
+
+
+@pytest.mark.invariants
+@pytest.mark.parametrize("op", ["append", "drop"])
+def test_a_save_whose_check_judged_nothing_is_refused_as_unchecked_not_broken(tmp_path, monkeypatch, op):
+    """T12 review 41 / P15: retries exhausted give no verdict on any entry: the save is
+    refused as unchecked, never as a broken log at no entry."""
+    log = _log(tmp_path, 2)
+    monkeypatch.setattr(case.CaseLog, "verify", lambda self: case._unchecked(
+        "being saved: writers kept taking the case during every read", in_progress=True))
+    with pytest.raises(case.CaseLocked, match="could not be checked") as e:
+        if op == "append":
+            log.append("override", {"n": 3}, expected=2)
+        else:
+            log.drop_torn_entry(expected=2, by="A. Person")
+    assert not isinstance(e.value, case.CaseLogBroken)
+
+
+@pytest.mark.invariants
+def test_an_unrelated_refusal_mid_write_never_speaks_for_the_save(tmp_path, monkeypatch):
+    """T12 review 42: a refusal raised during a short write by something else (a handler)
+    is not chained and not called a replaced lock; the save says it was not recorded."""
+    log = _log(tmp_path, 2)
+    real_write, calls = os.write, []
+
+    def short_then_unrelated(fd, data):
+        calls.append(None)
+        if len(calls) == 1 and len(data) > 10:
+            n = real_write(fd, bytes(data[:10]))
+            return n
+        raise case.CaseLocked("another window: nothing was written")
+
+    monkeypatch.setattr(case.os, "write", short_then_unrelated)
+    with pytest.raises(case.SaveNotRecorded, match="write was interrupted") as e:
+        log.append("override", {"n": 3}, expected=2)
+    assert "nothing was written" not in _chain(e.value) and "removed or replaced" not in str(e.value)
+
+
+@pytest.mark.invariants
+def test_an_interruption_entering_the_save_guard_leaves_no_stale_save(tmp_path, monkeypatch):
+    """T12 review 42: interrupted just after the guard registers, the thread can save again."""
+    log = _log(tmp_path, 2)
+
+    class Interrupting(dict):
+        def setdefault(self, key, value):
+            super().setdefault(key, value)
+            raise KeyboardInterrupt  # just after registering
+
+    saving = Interrupting()
+    log._saving = saving
+    with pytest.raises(KeyboardInterrupt):
+        log.append("override", {"n": 3}, expected=2)
+    assert not saving  # the guard took its own registration back
+    log._saving = {}
+    log.append("override", {"n": 3}, expected=2)
+
+
+
+@pytest.mark.invariants
+def test_p15_a_holder_whose_gate_alone_was_replaced_still_names_its_torn_entry(tmp_path, monkeypatch):
+    """T12 review 43: the holder's own case lock still excludes every writer, so a replaced
+    gate makes it read again, never take itself for another writer and report being saved."""
+    log = _log(tmp_path, 2)
+    _crash_mid_append(log, monkeypatch, 10)
+    with log.writer():
+        _replace_file(log.gate_path)
+        check = log.verify()
+    assert check.torn and check.first_bad == 3 and not check.in_progress
+
+
+@pytest.mark.invariants
+def test_p15_with_the_head_unreadable_a_reader_names_no_entry_while_another_holds(tmp_path, monkeypatch):
+    """T12 review 43: no recorded count, so no entry can be placed among the recorded ones."""
+    log = _log(tmp_path, 2)
+    holding, done = threading.Event(), threading.Event()
+
+    def hold():
+        with case.CaseLog(log.path).writer():
+            holding.set()
+            done.wait(10)
+
+    t = threading.Thread(target=hold)
+    t.start()
+    assert holding.wait(5)
+    log.head_path.write_bytes(b"not a head record\n")
+    monkeypatch.setattr(case, "READ_PAUSE", 0)
+    try:
+        check = case.CaseLog(log.path).verify()
+    finally:
+        done.set()
+        t.join(10)
+    assert check.first_bad is None and not check.ok
+
+
+@pytest.mark.invariants
+@pytest.mark.skipif(os.name == "nt" or not hasattr(signal, "SIGUSR1"), reason="sends a signal to itself")
+def test_a_held_handlers_os_error_after_a_confirmed_save_is_its_own(tmp_path, monkeypatch):
+    """T12 review 43: the save is confirmed and the log settled; the handler's own OSError
+    is delivered as it is, never turned into 'not recorded'."""
+    log = _log(tmp_path, 2)
+    real = case._check
+
+    def check(raw, recorded):
+        if isinstance(recorded, list) and len(recorded) == 3:
+            os.kill(os.getpid(), signal.SIGUSR1)
+        return real(raw, recorded)
+
+    def handler(n, frame):
+        raise OSError(5, "handler failed")
+
+    old = signal.signal(signal.SIGUSR1, handler)
+    try:
+        monkeypatch.setattr(case, "_check", check)
+        with pytest.raises(OSError, match="handler failed") as e:
+            log.append("override", {"n": 3}, expected=2)
+        assert not isinstance(e.value, case.CaseLogError)
+    finally:
+        signal.signal(signal.SIGUSR1, old)
+    monkeypatch.undo()
+    got = case.CaseLog(log.path).verify()
+    assert got.ok and got.head.position == 3
+
+
+@pytest.mark.invariants
+def test_p15_a_holders_retry_after_a_gate_change_goes_through_the_gate(tmp_path, monkeypatch):
+    """T12 review 44: the holder's second read is a reader's, through the gate as it now is,
+    and its own case lock found held there is no other writer: the torn entry is named."""
+    log = _log(tmp_path, 2)
+    _crash_mid_append(log, monkeypatch, 10)
+    real_shared, gates = case.CaseLog._shared, []
+
+    def shared(self, path):
+        gates.append(path)
+        return real_shared(self, path)
+
+    with log.writer():
+        _replace_file(log.gate_path)
+        monkeypatch.setattr(case.CaseLog, "_shared", shared)
+        check = log.verify()
+        monkeypatch.undo()
+    assert gates == [log.gate_path] and check.torn and check.first_bad == 3 and not check.in_progress

