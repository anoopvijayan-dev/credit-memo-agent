+
+    monkeypatch.setattr(case.CaseLog, "_write_head", then_lock_and_log_are_replaced)
+    with pytest.raises(case.SaveNotConfirmed, match="not confirmed"):
+        log.append("override", {"n": 3}, expected=2)
