    97	@server.tool()
    98	def statement_summary(path: str) -> dict:
    99	    """Load a statement CSV and return account name, period and transaction count."""
   100	    s = _statement(path)
   101	    return {
   102	        "account_name": s.account_name,
   103	        "start": s.start.isoformat(),
