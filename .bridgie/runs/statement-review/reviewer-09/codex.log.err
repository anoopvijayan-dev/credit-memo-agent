+      - name: Turn off the offline lock for synthetic data
+        run: |
+          mkdir -p private/cma
+          printf 'offline_lock: false\n' > private/cma/firm.yaml
       - name: Run evals against Claude
         run: python evals/run_evals.py --llm anthropic | tee evals-output.txt
       - name: Summary
