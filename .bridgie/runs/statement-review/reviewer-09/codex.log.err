   145	def _threshold(value: float | None, unit: str) -> str:
   146	    return "" if value is None else format_value(value, unit)
   147	
   148	
   149	def rules_table(p: PolicyResult) -> str:
   150	    lines = ["| id | rule | metric | requirement | outcome | detail |", "|---|---|---|---|---|---|"]
   151	    for r in p.rules:
   152	        req = f"{r.op} {_threshold(r.threshold, r.unit)}"
   153	        if r.refer_below is not None:
   154	            req += f"; referred below {_threshold(r.refer_below, r.unit)}"
   155	        if r.refer_above is not None:
   156	            req += f"; referred above {_threshold(r.refer_above, r.unit)}"
   157	        lines.append(f"| {r.rule_id} | {r.description} | {r.metric_id} | {req} | {r.outcome.value} | {r.detail} |")
   158	    return "\n".join(lines)
