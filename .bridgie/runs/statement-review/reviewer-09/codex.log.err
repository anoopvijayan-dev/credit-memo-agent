   109	@server.tool()
   110	def compute_metrics(path: str, vat_stagger: int | None = None) -> list[dict]:
   111	    """Categorise a statement and compute the cited metrics table (M1..M16).
   112	    vat_stagger is the HMRC stagger group (1, 2 or 3); without it M13 is n/a."""
   113	    s = categorise.categorise(_statement(path))
   114	    return [m.model_dump() for m in metrics.compute(s, vat_stagger=vat_stagger)]
   115	
   116	
   117	@server.tool()
   118	def check_policy(path: str, policy_path: str | None = None, vat_stagger: int | None = None) -> dict:
   119	    """Run the lending policy against a statement and return pass/refer/fail per rule."""
   120	    s = categorise.categorise(_statement(path))
   121	    p = policy.load_policy(safe_path(policy_path, (".yaml", ".yml"))) if policy_path else None
   122	    return policy.evaluate(metrics.compute(s, vat_stagger=vat_stagger), p).model_dump()
