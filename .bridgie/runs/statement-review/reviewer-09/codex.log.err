   195	def _egress(s: MemoState) -> dict:
   196	    """Where the draft's data went. A review drafted by the version before the offline lock
   197	    resumes with no lock fields in its checkpoint; that version had no lock, and its model
   198	    name says whether the draft left the machine."""
   199	    if s.get("egress") is not None and s.get("offline_lock") is not None:
   200	        return {"offline_lock": s["offline_lock"], "destination": s["egress"], "recorded": "at draft"}
   201	    model = s.get("model") or "-"
   202	    return {"offline_lock": False, "destination": "offline" if model.startswith("fake:") else model,
   203	            "recorded": "at resume; the draft predates the offline lock"}
