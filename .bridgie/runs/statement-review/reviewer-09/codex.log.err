    77	def case_root() -> Path:
    78	    raw = os.environ.get("CMA_HOME")
    79	    return Path(raw).resolve() if raw else (Path.cwd() / "private" / "cma").resolve()
    80	
    81	
    82	def load(root: Path | None = None) -> FirmConfig:
    83	    root = root or case_root()
    84	    path = root / FILE_NAME
    85	    if not path.is_file():
    86	        return FirmConfig(root=root)
    87	    try:
    88	        data = yaml.safe_load(path.read_text())
    89	    except yaml.YAMLError as e:
    90	        raise FirmConfigError(f"{path}: not valid YAML ({e.__class__.__name__})") from e
    91	    if data is None:
    92	        return FirmConfig(root=root)
    93	    if not isinstance(data, dict):
    94	        raise FirmConfigError(f"{path}: not a mapping")
    95	
    96	    problems: list[str] = []
    97	    problems += [f"unknown key {k!r}" for k in data if k not in (*FLAGS, "paths")]
    98	    flags = {}
    99	    for key in FLAGS:
   100	        if key in data:
   101	            if isinstance(data[key], bool):
   102	                flags[key] = data[key]
   103	            else:
   104	                problems.append(f"{key} must be true or false")
   105	    paths = dict(DEFAULT_PATHS)
   106	    raw_paths = data.get("paths")
   107	    if raw_paths is None:  # absent, or `paths:` with nothing under it
   108	        raw_paths = {}
   109	    if not isinstance(raw_paths, dict):
   110	        problems.append("paths must be a mapping")
   111	        raw_paths = {}
   112	    for key, value in raw_paths.items():
   113	        if key not in DEFAULT_PATHS:
   114	            problems.append(f"unknown path {key!r}")
   115	        elif not isinstance(value, str) or not value.strip():
   116	            problems.append(f"paths.{key} must be a file path")
   117	        else:
   118	            paths[key] = value
   119	    if problems:
   120	        raise FirmConfigError(f"{path}: " + "; ".join(problems))
   121	    return FirmConfig(root=root, paths=tuple(paths.items()), **flags)
