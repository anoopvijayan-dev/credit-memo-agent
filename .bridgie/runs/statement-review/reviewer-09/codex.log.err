    82	    def __init__(self, model: str | None = None):
    83	        firm.require_unlocked("A hosted model (anthropic)")
    84	        import anthropic
    85	
    86	        self.client = anthropic.Anthropic(timeout=120.0, max_retries=2)
    87	        self.model = model or os.getenv("CMA_ANTHROPIC_MODEL", "claude-sonnet-5-5")
    88	
    89	    def complete(self, system: str, user: str) -> str:
    90	        firm.require_unlocked("A request to a hosted model (anthropic)")
    91	        msg = self.client.messages.create(
    92	            model=self.model,
    93	            max_tokens=2000,
    94	            system=system,
    95	            messages=[{"role": "user", "content": user}],
    96	        )
    97	        if msg.stop_reason == "max_tokens":
    98	            raise LLMError("the model's reply was cut off at the token limit")
    99	        return "".join(block.text for block in msg.content if getattr(block, "type", "") == "text")
