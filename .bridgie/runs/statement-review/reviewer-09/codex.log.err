    33	class LockedMCPServer(MCPServer):
    34	    """An MCPServer whose every way of starting checks the offline lock first."""
    35	
    36	    def run(self, *args, **kwargs):
    37	        firm.require_unlocked("Starting the MCP server")
    38	        return super().run(*args, **kwargs)
    39	
    40	    async def run_stdio_async(self, *args, **kwargs):
    41	        firm.require_unlocked("Starting the MCP server")
    42	        return await super().run_stdio_async(*args, **kwargs)
    43	
    44	    async def run_sse_async(self, *args, **kwargs):
    45	        firm.require_unlocked("Starting the MCP server")
    46	        return await super().run_sse_async(*args, **kwargs)
    47	
    48	    async def run_streamable_http_async(self, *args, **kwargs):
    49	        firm.require_unlocked("Starting the MCP server")
    50	        return await super().run_streamable_http_async(*args, **kwargs)
    51	
    52	    def sse_app(self, *args, **kwargs):
    53	        firm.require_unlocked("Starting the MCP server")
    54	        return super().sse_app(*args, **kwargs)
    55	
    56	    def streamable_http_app(self, *args, **kwargs):
    57	        firm.require_unlocked("Starting the MCP server")
    58	        return super().streamable_http_app(*args, **kwargs)
    59	
    60	
    61	server = LockedMCPServer("credit-memo-agent")
    62	
    63	
    64	def data_dir() -> Path:
    65	    raw = os.environ.get("CMA_DATA_DIR")
    66	    if not raw:
    67	        raise ValueError("CMA_DATA_DIR is not set; set it to the folder of statements this server may read")
    68	    return Path(raw).resolve()
    69	
    70	
    71	def safe_path(raw: str, suffixes: tuple[str, ...]) -> Path:
    72	    """Resolve `raw` inside the data directory, or refuse."""
    73	    root = data_dir()
    74	    p = Path(raw)
    75	    p = (p if p.is_absolute() else root / p).resolve()
    76	    if not p.is_relative_to(root):
    77	        raise ValueError(f"{raw}: outside the data directory {root} (set CMA_DATA_DIR)")
    78	    if p.suffix.lower() not in suffixes:
    79	        raise ValueError(f"{raw}: only {', '.join(suffixes)} files can be read")
    80	    if not p.is_file():
    81	        raise ValueError(f"{raw}: no such file")
    82	    return p
    83	
    84	
    85	def _statement(path: str):
    86	    # Every tool starts here, so none reads a file while the lock is on.
    87	    firm.require_unlocked("An MCP tool call")
    88	    p = safe_path(path, (".csv",))
    89	    try:
    90	        return ingest.load_csv(p)
    91	    except ingest.StatementError as e:
    92	        lines = sorted({x.split(":", 1)[0] for x in e.problems})
    93	        raise ValueError(f"{path}: statement refused, {len(e.problems)} problem(s) on {', '.join(lines[:10])}; "
    94	                         "run `cma run` locally to see them") from None
