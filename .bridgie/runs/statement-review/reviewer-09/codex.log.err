   105	@app.command()
   106	def resume(
   107	    thread: str = typer.Argument(..., help="The review id printed by `cma run --checkpoint-db`."),
   108	    checkpoint_db: Path = typer.Option(..., help="The SQLite file the review was kept in."),
   109	    reviewer: str | None = typer.Option(None, help="Your name, recorded on the memo."),
   110	    out: Path | None = typer.Option(None, help="As for `cma run`."),
   111	):
   112	    """Pick up a memo that is waiting for review, after a restart."""
   113	    if not checkpoint_db.exists():
   114	        console.print(f"[red]{checkpoint_db} does not exist.[/red]")
   115	        raise typer.Exit(code=2)
   116	    _refuse_to_overwrite(out)
   117	    with _checkpointer(checkpoint_db) as saver:
   118	        graph = build(get_llm("fake"), checkpointer=saver)  # the draft is already made; no model call
   119	        cfg = {"configurable": {"thread_id": thread}}
   120	        snap = graph.get_state(cfg)
   121	        if not snap.interrupts:
   122	            console.print(f"[red]Nothing is waiting for review under {thread}.[/red]")
   123	            raise typer.Exit(code=1)
   124	        problem = _stored_state_problem(snap.values)
   125	        if problem:
   126	            console.print(f"[red]Not resuming {thread}:[/red] {problem}")
   127	            raise typer.Exit(code=2)
   128	        state = {**snap.values, "__interrupt__": snap.interrupts}
   129	        _review(graph, cfg, state, reviewer, False, out)
   130	
   131	
   132	def _stored_state_problem(values: dict) -> str | None:
   133	    """A stored review is only resumed if it still says what it said: the statement file
   134	    is unchanged and the stored memo still passes (or fails) the guard the same way."""
   135	    path = Path(values["statement_path"])
   136	    if not path.is_file():
   137	        return f"the statement {path} is no longer there"
   138	    if hashlib.sha256(path.read_bytes()).hexdigest() != values.get("statement_sha256"):
   139	        return f"the statement {path} has changed since the memo was drafted"
   140	    again = grd.check(values["memo"], values["metrics"], values["policy"], required_headings=grd.REQUIRED_HEADINGS)
   141	    if again.grounded != values["guard"].grounded:
   142	        return "the stored grounding result does not match the stored memo"
   143	    return None
   144	
   145	
   146	def _refuse_to_overwrite(out: Path | None) -> None:
   147	    """Never replace an earlier memo or its evidence: the pair is the audit record."""
   148	    if out is None:
   149	        return
   150	    taken = [p for p in _outputs(out) if p.exists()]
   151	    if taken:
   152	        console.print(f"[red]Refusing to overwrite {', '.join(map(str, taken))}. Choose another --out.[/red]")
   153	        raise typer.Exit(code=2)
   154	
   155	
   156	def _outputs(out: Path) -> list[Path]:
   157	    rejected = out.with_name(out.stem + ".rejected.md")
   158	    return [out, _evidence_path(out), rejected, _evidence_path(rejected)]
   159	
   160	
   161	def _evidence_path(memo: Path) -> Path:
   162	    return memo.with_name(memo.stem + ".evidence.json")
   163	
   164	
   165	@contextmanager
   166	def _checkpointer(path: Path | None):
   167	    if path is None:
   168	        yield None
   169	        return
   170	    try:
   171	        with sqlite_checkpointer(path) as saver:
   172	            yield saver
   173	    except RuntimeError as e:
   174	        console.print(f"[red]{e}[/red]")
   175	        raise typer.Exit(code=2) from e
   176	
   177	
   178	def _review(graph, cfg, state, reviewer, yes, out):
   179	    interrupts = state.get("__interrupt__") or []
   180	    if not interrupts:
   181	        raise typer.Exit(code=1)
   182	    payload = interrupts[0].value
   183	
   184	    _print_metrics(state["metrics"])
   185	    _print_policy(state["policy"])
   186	    console.rule("Draft memo")
   187	    console.print(Markdown(payload["memo"]))
   188	    console.rule("Grounding check")
   189	    grounded = payload["guard_grounded"]
   190	    if grounded:
   191	        console.print("[green]All figures trace to the metrics table or the policy.[/green]")
   192	    else:
   193	        console.print(f"[red]Unmatched numbers:[/red] {payload['guard_unmatched']}")
   194	        if payload["guard_missing_citations"]:
   195	            console.print(f"[red]Figures quoted without their tag:[/red] {payload['guard_missing_citations']}")
   196	
   197	    if yes:
   198	        if not grounded:
   199	            console.print("[red]--yes will not approve a memo that failed the grounding check. Review it interactively.[/red]")
   200	            raise typer.Exit(code=3)
   201	        decision = {"approved": True, "reviewer": reviewer, "mode": "automated",
   202	                    "notes": "Approved by script (--yes); the draft was not reviewed interactively."}
   203	    else:
   204	        decision = _ask(payload, grounded, reviewer)
   205	
   206	    final = _decide(graph, cfg, decision)
   207	    while "__interrupt__" in final:
   208	        payload = final["__interrupt__"][0].value
   209	        console.print(f"[red]Not accepted:[/red] {payload['error']}")
   210	        if yes:
   211	            raise typer.Exit(code=3)
   212	        decision = _ask(payload, grounded, reviewer)
   213	        final = _decide(graph, cfg, decision)
   214	
   215	    approved = final["review"].approved
   216	    if out:
   217	        target = out if approved else out.with_name(out.stem + ".rejected.md")
   218	        evidence = _evidence_path(target)
   219	        target.write_text(final["final_memo"])
   220	        evidence.write_text(json.dumps(evidence_record(final), indent=2, default=str))
   221	        console.print(f"wrote {target} and {evidence}")
   222	    if not approved:
   223	        console.rule("Not approved")
   224	        console.print(Markdown(final["final_memo"]))
   225	        raise typer.Exit(code=1)
