diff --git a/.github/workflows/evals.yml b/.github/workflows/evals.yml
index 4b9d5ff..60814c0 100644
--- a/.github/workflows/evals.yml
+++ b/.github/workflows/evals.yml
@@ -60,6 +60,12 @@ jobs:
           curl -sS -H "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" \
             "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=https://api.anthropic.com" \
             | jq -r .value > "$ANTHROPIC_IDENTITY_TOKEN_FILE"
+      # The offline lock is on by default. Synthetic statements only, so turn it off on purpose here;
