    92	FORMULA_START = ("=", "+", "-", "@", "\t", "\r")
    93	
    94	
    95	def neutralise_formula(text: str) -> str:
    96	    """A text cell a spreadsheet would read as a formula gets a leading apostrophe (R34).
    97	    Monzo's Type is provider-written; an unknown one becomes the description's prefix."""
    98	    return "'" + text if text.startswith(FORMULA_START) else text
    99	
   100	
   101	def describe(kind: str, name: str, amount: float, extra: str = "") -> str:
   102	    """A bank-statement style description from Monzo's Type, Name and direction."""
   103	    k = kind.strip().lower()
   104	    who = " ".join(f"{name} {extra}".split()).upper() or "UNKNOWN"
   105	    incoming = amount > 0
   106	    if "flex" in k or "MONZO FLEX" in who:
   107	        # Monzo Flex is credit: money in is a drawdown, money out is a repayment.
   108	        prefix = "LOAN DRAWDOWN" if incoming else "LOAN REPAYMENT"
   109	        if "FLEX" not in who:
   110	            who = f"MONZO FLEX {who}"
   111	    elif ("faster payment" in k or "monzo-to-monzo" in k or k == "p2p_payment"
   112	          or "bank transfer" in k):
   113	        prefix = "FPS CREDIT" if incoming else "FPS DEBIT"
   114	    elif "bacs" in k:
   115	        prefix = "BACS CREDIT" if incoming else "BACS DEBIT"
   116	    elif "direct debit" in k:
   117	        prefix = "DD REFUND" if incoming else "DD"
   118	    elif "standing order" in k:
   119	        prefix = "SO"
   120	    elif "card" in k:
   121	        prefix = "CARD REFUND" if incoming else "CARD"
   122	    elif "pot" in k:
   123	        prefix = "POT TRANSFER IN" if incoming else "POT TRANSFER OUT"
   124	    elif "interest" in k:
   125	        prefix = "INTEREST"
   126	    else:
   127	        prefix = k.upper() or "OTHER"
   128	    return f"{prefix} {who}".strip()
   129	
   130	
   131	def convert(src: Path, dst: Path, opening_balance: float | None = None) -> ImportResult:
   132	    with Path(src).open(newline="", encoding="utf-8-sig") as f:
   133	        reader = csv.DictReader(f)
   134	        header = [h.strip() for h in (reader.fieldnames or [])]
   135	        reader.fieldnames = header
   136	        missing = [c for c in REQUIRED if c not in header]
   137	        if missing:
   138	            raise MonzoImportError(
   139	                f"{src}: not a Monzo export; missing column(s): {', '.join(missing)}"
   140	            )
   141	        raw_rows = list(reader)
   142	    if not raw_rows:
   143	        raise MonzoImportError(f"{src}: no transactions")
   144	
   145	    has_balance = "Balance" in header
   146	    if opening_balance is None and not has_balance:
   147	        raise MonzoImportError(
   148	            "this export has no Balance column; pass --opening-balance (the balance just "
   149	            "before the first transaction, from your Monzo statement)"
   150	        )
   151	
   152	    parsed = []
   153	    skipped = 0
   154	    seen: set[str] = set()
   155	    for i, r in enumerate(raw_rows, start=2):
   156	        tid = (r.get("Transaction ID") or "").strip()
   157	        if not tid:
   158	            raise MonzoImportError(f"line {i}: empty Transaction ID")
   159	        if not SAFE_ID.match(tid):
   160	            raise MonzoImportError(f"line {i}: unexpected characters in Transaction ID {tid!r}")
   161	        if tid in seen:
   162	            raise MonzoImportError(f"line {i}: duplicate Transaction ID {tid}")
   163	        seen.add(tid)
   164	        currency = (r.get("Currency") or "GBP").strip().upper()
   165	        if currency and currency != "GBP":
   166	            skipped += 1
   167	            continue
   168	        d = _parse_date(r["Date"])
   169	        t = (r.get("Time") or "00:00:00").strip()
   170	        amount = _money(r["Amount"], "Amount", i)
   171	        bal = _money(r["Balance"], "Balance", i) if has_balance and (r.get("Balance") or "").strip() else None
   172	        refs = references(r.get("Notes and #tags"), r.get("Description"))
   173	        desc = describe(r.get("Type", ""), r.get("Name", ""), amount, refs)
   174	        parsed.append((d, t, tid, desc, amount, bal))
   175	
   176	    parsed.sort(key=lambda x: (x[0], x[1], x[2]))
   177	    first = parsed[0]
   178	    implied = round(first[5] - first[4], 2) if first[5] is not None else None
   179	    if opening_balance is None:
   180	        if implied is None:
   181	            raise MonzoImportError("first row has no Balance; pass --opening-balance")
   182	        opening_balance = implied
   183	        source = "Monzo Balance column"
   184	    else:
   185	        if implied is not None and abs(implied - opening_balance) > 0.005:
   186	            raise MonzoImportError(
   187	                f"--opening-balance {opening_balance:.2f} disagrees with Monzo's Balance column, "
   188	                f"which implies {implied:.2f}; leave --opening-balance out to use Monzo's"
   189	            )
   190	        source = "opening balance supplied"
   191	
   192	    out_rows = []
   193	    bal = opening_balance
   194	    for d, _t, tid, desc, amount, monzo_bal in parsed:
   195	        bal = round(bal + amount, 2)
   196	        if monzo_bal is not None and abs(monzo_bal - bal) > 0.005:
   197	            raise MonzoImportError(
   198	                f"{tid}: walked balance {bal:.2f} disagrees with Monzo's {monzo_bal:.2f}; "
   199	                "the export may be missing transactions"
   200	            )
   201	        out_rows.append({"id": tid, "date": d.isoformat(), "description": neutralise_formula(desc),
   202	                         "amount": f"{amount:.2f}", "balance": f"{bal:.2f}"})
   203	
   204	    Path(dst).parent.mkdir(parents=True, exist_ok=True)
   205	    with Path(dst).open("w", newline="") as f:
   206	        w = csv.DictWriter(f, fieldnames=["id", "date", "description", "amount", "balance"])
   207	        w.writeheader()
   208	        w.writerows(out_rows)
   209	    return ImportResult(
   210	        rows=len(out_rows), start=parsed[0][0], end=parsed[-1][0],
   211	        opening_balance=opening_balance, closing_balance=bal,
   212	        balance_source=source, skipped_non_gbp=skipped,
   213	    )
