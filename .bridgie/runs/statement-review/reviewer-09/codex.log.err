   125	@server.tool()
   126	def transactions_for(path: str, ids: list[str], include_descriptions: bool = False) -> list[dict]:
   127	    """Return the statement lines behind a metric's evidence ids, so a reviewer can check a
   128	    figure. Descriptions are payer-written text and are never returned, even when
