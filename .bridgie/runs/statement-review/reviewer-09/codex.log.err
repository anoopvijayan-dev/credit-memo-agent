   161	def draft_prompt(statement: Statement, metrics: list[Metric], policy: PolicyResult, redraft: bool = False) -> str:
   162	    """The user prompt: the tables, the period and the placeholder name, nothing else."""
   163	    user = (
   164	        f"Account: {PROMPT_ACCOUNT_NAME}\n"
   165	        f"Period: {statement.start} to {statement.end}\n\n"
   166	        f"Metrics table:\n{met.as_table(metrics)}\n\n"
   167	        f"Policy: {policy.policy_name}\nOverall policy outcome: {policy.overall.value}\n"
   168	        f"Policy table:\n{rules_table(policy)}\n"
   169	    )
   170	    if redraft:
   171	        user += REDRAFT_NOTE
   172	    return user
