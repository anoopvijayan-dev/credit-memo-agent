new file mode 100644
index 0000000..032cad2
--- /dev/null
+++ b/src/cma/rules/v1.yaml
@@ -0,0 +1,60 @@
+# Built-in categorisation table v1: the table as it was in src/cma/categorise.py before
+# it moved to data. Frozen: CMA_RULESET=v1 must reproduce today's categories and M1-M16
+# exactly (tests/test_rules.py, P7). Change a newer table, never this one.
+#
+# Rules are ordered; the first whose pattern matches the upper-cased description and
+# whose direction matches the sign of the amount wins. No match: a debit is supplier,
+# a credit is other. Patterns are Python regular expressions; direction is in, out or
+# any; category is a cma.models.Category value.
+id: v1
+frozen: true
+rules:
+  - id: returned_dd
+    pattern: '^UNPAID DD\b'
+    direction: any
+    category: returned_dd
+  - id: bank_fees
+    pattern: 'UNPAID ITEM FEE|ACCOUNT FEES|BANK CHARGES'
+    direction: out
+    category: bank_fees
+  - id: hmrc_vat
+    pattern: 'HMRC VAT'
+    direction: out
+    category: hmrc_vat
+  - id: hmrc_paye
+    pattern: 'HMRC PAYE'
+    direction: out
+    category: hmrc_paye
+  - id: payroll
+    pattern: 'PAYROLL|SALARIES'
+    direction: out
+    category: payroll
+  - id: rent
+    pattern: '\bRENT\b'
+    direction: out
+    category: rent
+  - id: loan_repayment
+    pattern: '\bLOAN\b|FINANCE\b'
+    direction: out
+    category: loan_repayment
+  - id: loan_drawdown
+    pattern: '\bLOAN\b|FINANCE\b'
+    direction: in
+    category: loan_drawdown
+  - id: owner_drawings
+    pattern: 'OWNER DRAWINGS|DIRECTOR DRAWINGS|DIVIDEND'
+    direction: out
+    category: owner_drawings
+  # Money in that is never trading income, whatever reference it carries.
+  - id: non_trading_in
+    pattern: '\bDIRECTOR\b|\bOWNER\b|\bCAPITAL\b|\bSHAREHOLDER\b|\bHMRC\b|\bREFUND\b|\bREVERSAL\b|\bSAVINGS\b|\bPOT TRANSFER\b|\bINTEREST\b|\bGRANT\b|\bINSURANCE CLAIM\b'
+    direction: in
+    category: other
+  - id: card_settlement
+    pattern: 'ACQUIRER SETTLEMENT|PAYGATE PAYOUT|CARD SETTLEMENT'
+    direction: in
+    category: revenue_card_settlement
+  - id: invoice_transfer
+    pattern: '\bINV(?:OICE)?\s*[-#:]?\s*\d+'
+    direction: in
+    category: revenue_transfer
diff --git a/tests/golden/p7_tools/capture_plugin.py b/tests/golden/p7_tools/capture_plugin.py
new file mode 100644
index 0000000..c8a3241
--- /dev/null
+++ b/tests/golden/p7_tools/capture_plugin.py
@@ -0,0 +1,72 @@
+"""pytest plugin: record every statement the test suite computes metrics on or categorises
+as a whole, and every (description, amount) the categoriser sees, using the code as it is
+*before* T01. A statement categorised but never passed to metrics.compute is recorded
+too, with no VAT stagger, so make_p7_baseline.py gives it an M1-M16 baseline (verify-10:
+the two-credit Monzo invoice fixture was otherwise captured only as single lines). So is
+every statement ingest.load_csv returns, before any category is set, marked "loaded" so
+the baseline categorises it with the rule table (verify-11: the newest-first and
+byte-order-mark fixtures in tests/test_ingest.py are only loaded).
+Output: $CAPTURE_OUT (JSON)."""
+
+import atexit
+import json
+import os
+
+from cma import categorise, ingest, metrics
+
+STATEMENTS: dict[str, dict] = {}
+LINES: dict[tuple[str, float], str] = {}
+
+_orig_compute = metrics.compute
+_orig_one = categorise.categorise_one
+_orig_categorise = categorise.categorise
+_orig_load_csv = ingest.load_csv
+
+
+def _record(statement, vat_stagger, loaded=False):
+    s = statement.model_dump(mode="json")
+    key = json.dumps([s, vat_stagger, loaded], sort_keys=True)
+    STATEMENTS[key] = {"statement": s, "vat_stagger": vat_stagger, "loaded": loaded}
+
+
+def _one(t):
+    c = _orig_one(t)
+    LINES[(t.description, t.amount)] = c.value
+    return c
+
+
+def _compute(statement, vat_stagger=None):
+    out = _orig_compute(statement, vat_stagger=vat_stagger)
+    _record(statement, vat_stagger)
+    return out
+
+
+def _categorise(statement):
+    out = _orig_categorise(statement)
+    _record(out, None)
+    return out
+
+
+def _load_csv(*args, **kwargs):
+    out = _orig_load_csv(*args, **kwargs)
+    _record(out, None, loaded=True)
+    return out
+
+
+ingest.load_csv = _load_csv
+categorise.categorise_one = _one
+categorise.categorise = _categorise
+metrics.compute = _compute
+
+
+@atexit.register
+def _dump():
+    path = os.environ["CAPTURE_OUT"]
+    with open(path, "w") as f:
+        json.dump(
+            {
+                "statements": list(STATEMENTS.values()),
+                "lines": [{"description": d, "amount": a, "category": c} for (d, a), c in LINES.items()],
+            },
+            f,
+        )
diff --git a/tests/golden/p7_tools/make_p7_baseline.py b/tests/golden/p7_tools/make_p7_baseline.py
new file mode 100644
index 0000000..dd0c378
--- /dev/null
+++ b/tests/golden/p7_tools/make_p7_baseline.py
@@ -0,0 +1,139 @@
+"""Build tests/golden/p7_v1_baseline.json from the code as it was BEFORE T01.
+
+Run from a checkout of the pre-change commit (fd7b64c), with the capture produced by
+capture_plugin.py (every statement the test suite loads, computes metrics on or
+categorises as a whole, and every line the categoriser sees). Install the durable extra so no capturing test is skipped.
+From the worktree root, with S a scratch directory:
+
+    git archive fd7b64c | tar -x -C $S/old
+    cd $S/old && PYTHONDONTWRITEBYTECODE=1 CAPTURE_OUT=$S/capture.json \
+        PYTHONPATH=$S/old/src:<worktree>/tests/golden/p7_tools python -m pytest -q -p capture_plugin
+    MADE_AT=fd7b64c PYTHONPATH=$S/old/src python <worktree>/tests/golden/p7_tools/make_p7_baseline.py \
+        $S/capture.json $S/p7.json
+    # then compare $S/p7.json with gunzip < tests/golden/p7_v1_baseline.json.gz: every key equal
+
+tests/test_p7_history.py runs exactly these steps and the comparison.
+
+The committed golden's "_about" text predates this folder and says the tools were in
+the T01 run directory; they are these files, unchanged apart from this docstring.
+"""
+
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+from datetime import date
+from pathlib import Path
+
+from cma import categorise, ingest, metrics, synth
+from cma.models import Statement
+
+SYNTH_CASES = [
+    *[(a, p, 7, 12, "2026-09-30") for a in synth.ARCHETYPES for p in synth.PROFILES],
+    ("cafe", "stretched", 3, 12, "2026-09-30"),
+    ("cafe", "good", 7, 3, "2026-09-30"),
+    ("cafe", "poor", 7, 4, "2026-09-30"),
+    ("cafe", "poor", 7, 2, "2026-09-30"),
+]
+EXAMPLES = ["examples/cafe_stretched.csv"]
+
+
+def sha(text: str) -> str:
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def categories_sha(s: Statement) -> str:
+    return sha("\n".join(f"{t.id}|{t.category.value}|{t.reverses or ''}" for t in s.transactions))
+
+
+def metric_rows(s: Statement, vat_stagger):
+    return [
+        {"id": m.id, "unit": m.unit, "value": m.value, "evidence_n": len(m.evidence),
+         "evidence_sha256": sha("\n".join(m.evidence))}
+        for m in metrics.compute(s, vat_stagger=vat_stagger)
+    ]
+
+
+def rows_key(s: dict, vat_stagger) -> str:
+    """A statement's lines AND the VAT stagger its figures were computed with: the same
+    lines under another stagger give another M13, so they are another case (verify-01
+    found the stagger-3 run of a fixture dropped because only its lines were compared)."""
+    return json.dumps([[[t["id"], t["date"], t["description"], t["amount"], t["balance"]]
+                        for t in s["transactions"]], vat_stagger])
+
+
+def main(capture_path: str, out_path: str) -> None:
+    cap = json.loads(Path(capture_path).read_text())
+    out: dict = {
+        "_about": (
+            "P7 baseline: M1-M16 (id, unit, value, evidence) and categories, computed by the "
+            "categoriser as it was before the rule table moved to src/cma/rules/ (T01). "
+            "Under CMA_RULESET=v1 every entry must be reproduced exactly. Built by "
+            "make_p7_baseline.py in the T01 run directory; do not regenerate from newer code."
+        ),
+        "made_at_commit": os.environ.get("MADE_AT") or subprocess.check_output(["git", "rev-parse", "--short", "HEAD"], text=True).strip(),
+        "synthetic": [], "examples": [], "fixtures": [], "lines": [],
+    }
+    seen_rows: set[str] = set()
+    for archetype, profile, seed, months, end in SYNTH_CASES:
+        rows, truth = synth.generate(archetype, profile, seed=seed, months=months, end=date.fromisoformat(end))
+        with tempfile.TemporaryDirectory() as d:
+            csv_path, _ = synth.write(rows, truth, Path(d), stem="s")
+            raw = csv_path.read_bytes()
+            s = categorise.categorise(ingest.load_csv(csv_path))
+        for v in (None, truth.vat_stagger):
+            seen_rows.add(rows_key(s.model_dump(mode="json"), v))
+        out["synthetic"].append({
+            "archetype": archetype, "profile": profile, "seed": seed, "months": months, "end": end,
+            "csv_sha256": hashlib.sha256(raw).hexdigest(),
+            "categories_sha256": categories_sha(s),
+            "metrics": {str(v): metric_rows(s, v) for v in (None, truth.vat_stagger)},
+        })
+    for p in EXAMPLES:
+        s = categorise.categorise(ingest.load_csv(Path(p)))
+        for v in (None, 3):
+            seen_rows.add(rows_key(s.model_dump(mode="json"), v))
+        out["examples"].append({
+            "path": p, "file_sha256": hashlib.sha256(Path(p).read_bytes()).hexdigest(),
+            "categories_sha256": categories_sha(s),
+            "metrics": {"None": metric_rows(s, None), "3": metric_rows(s, 3)},
+        })
+    skipped = 0
+    for rec in cap["statements"]:
+        sd = rec["statement"]
+        if rows_key(sd, rec["vat_stagger"]) in seen_rows:
+            continue
+        given = Statement(**sd)
+        fresh = categorise.categorise(Statement(**sd))
+        # A loaded statement has no categories yet; the rule table sets all of them.
+        if not rec.get("loaded") and categories_sha(given) != categories_sha(fresh):
+            skipped += 1  # categories set by hand in the test; not the rule table's output
+            continue
+        seen_rows.add(rows_key(sd, rec["vat_stagger"]))
+        out["fixtures"].append({
+            "account_name": sd["account_name"],
+            "vat_stagger": rec["vat_stagger"],
+            "lines": [[t.id, str(t.date), t.description, t.amount, t.balance, t.category.value, t.reverses]
+                      for t in fresh.transactions],
+            "metrics": metric_rows(fresh, rec["vat_stagger"]),
+        })
+    # Lines the tests categorise one at a time, outside any statement above.
+    in_statements = {(t["description"], t["amount"]) for r in cap["statements"] for t in r["statement"]["transactions"]}
+    out["lines"] = sorted({(x["description"], x["amount"], x["category"]) for x in cap["lines"]
+                           if (x["description"], x["amount"]) not in in_statements})
+    Path(out_path).parent.mkdir(parents=True, exist_ok=True)
+    # One fixture line, metric or synthetic case per text line: diffable, not bloated.
+    text = json.dumps(out, separators=(",", ":"))
+    text = re.sub(r'(\[\[|\},\{|\],\[|"(?:synthetic|examples|fixtures|lines)":)', lambda m: m.group(0)[:-1] + "\n" + m.group(0)[-1] if m.group(0)[-1] in "[{" else m.group(0) + "\n", text)
+    Path(out_path).write_text(text + "\n")
+    import cma
+    print(f"cma from {cma.__file__}")
+    print(f"synthetic={len(out['synthetic'])} examples={len(out['examples'])} "
+          f"fixtures={len(out['fixtures'])} hand_categorised_skipped={skipped} lines={len(out['lines'])}")
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], sys.argv[2])
