+                        "display": f"{row.start.isoformat()} to {row.end.isoformat()}"}],
+            "closes": _closes_out(daily_closes(statement, row.start, row.end))}
+
+
+def _closes_out(closes) -> list[dict] | None:
+    if closes is None:
+        return None
