+        with pytest.raises(RulesetError) as e:
+            categorise.load_ruleset("v2")
+    finally:
+        monkeypatch.undo()
+        categorise.load_ruleset.cache_clear()
+    assert "(odd): names holds a repeated key" in str(e.value) and "(other): direction" in str(e.value)
