+def load_hints(folder: Path, account: str) -> dict[str, str]:
+    """The provider's own categories for an account's lines, by line id (R37): untrusted hints
+    that no figure reads. A file that is missing or cannot be read gives none, since a hint
+    is never needed for anything."""
+    path = Path(folder) / STATEMENTS / f"{account}{HINTS_SUFFIX}"
+    try:
