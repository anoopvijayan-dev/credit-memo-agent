   124	def _parse(line: bytes, n: int, prev: str) -> tuple[Entry | None, str]:
   125	    """Check one complete line as entry number `n` following hash `prev`."""
   126	    try:
   127	        obj = json.loads(line.decode("utf-8"))
   128	    except (UnicodeDecodeError, ValueError):
