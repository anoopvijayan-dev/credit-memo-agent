   190	    # --- writing -----------------------------------------------------------------------
   191	
   192	    @contextmanager
   193	    def writer(self) -> Iterator[CaseLog]:
   194	        """Hold the case's single-writer lock; refuses at once if another writer has it."""
   195	        if self._lock_depth == 0:
