     1	"""The case log: an append-only, hash-chained record of everything done to a case (R42, R43).
     2	
     3	One JSON object per line, written in a single write that ends with its newline:
     4	
     5	    {"seq": 3, "prev": "<hash of entry 2>", "at": "2026-11-16T10:04:01.123456Z",
     6	     "event": "override", "data": {...}, "hash": "<sha256 of the other five fields>"}
     7	
     8	The first entry's `prev` is GENESIS. Each entry carries the hash of the entry before it
     9	and its own hash, so a changed, removed, inserted or reordered entry anywhere before the
    10	head breaks the chain on the next load, and `verify` names the first entry that does not
    11	hold. A last line without its newline is a torn entry (the process or the power stopped
    12	mid-write); it is reported as incomplete, not as tampering, and stays in the way of
    13	appends and sign-off until someone confirms dropping it (`drop_torn_entry`), which is
    14	itself logged. Removing the head itself cannot be seen from the file alone: whoever
    15	needs to pin the head (a sign-off, a pack) records its position and hash.
    16	
    17	One writer at a time: every append takes an exclusive, non-blocking lock on a sibling
    18	lock file and re-reads the log under it, and the caller states the position it last
    19	saw. A second tab or terminal that read an older position gets LogConflict and reloads;
    20	one that tries while another holds the lock gets CaseLocked. The operating system drops
    21	the lock when its holder dies, so a crash never leaves the case locked.
    22	
    23	Messages name entries by number only and never quote their content: data holds case
    24	details, and errors end up in terminals and logs.
    25	"""
    26	
    27	from __future__ import annotations
    28	
    29	import hashlib
    30	import json
    31	import os
    32	from collections.abc import Iterator
    33	from contextlib import contextmanager
    34	from dataclasses import dataclass, field
    35	from datetime import UTC, datetime
    36	from pathlib import Path
    37	from typing import Any
    38	
    39	GENESIS = "0" * 64
    40	HASHED_FIELDS = ("seq", "prev", "at", "event", "data")
    41	ENTRY_FIELDS = frozenset((*HASHED_FIELDS, "hash"))
    42	TORN_DROPPED = "torn_entry_dropped"
    43	
    44	
    45	class CaseLogError(Exception):
    46	    """Base for case-log refusals."""
    47	
    48	
    49	class CaseLogBroken(CaseLogError):
    50	    """The chain does not hold, or the last entry is incomplete. Nothing may be appended
    51	    and no sign-off accepted until it is resolved."""
