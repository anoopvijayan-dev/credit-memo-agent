   107	def _canonical(obj: Any) -> bytes:
   108	    # allow_nan=False: NaN and Infinity are not JSON, and another reader of the log
   109	    # (verify, a future hosted version) must be able to recompute every hash.
   110	    return json.dumps(
   111	        obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
   112	    ).encode("utf-8")
   113	
   114	
   115	def entry_hash(entry: dict[str, Any]) -> str:
   116	    """sha256 over the canonical JSON of the hashed fields (everything but `hash`)."""
   117	    return hashlib.sha256(_canonical({k: entry.get(k) for k in HASHED_FIELDS})).hexdigest()
   118	
