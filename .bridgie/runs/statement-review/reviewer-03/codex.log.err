   153	    # --- reading -----------------------------------------------------------------------
   154	
   155	    def verify(self) -> LogCheck:
   156	        """Walk the chain from the start and stop at the first entry that does not hold."""
   157	        raw = self.path.read_bytes() if self.path.exists() else b""
   158	        pieces = raw.split(b"\n")
