    93	@dataclass(frozen=True)
    94	class LogCheck:
    95	    head: Head  # the end of the intact prefix
    96	    entries: list[Entry] = field(repr=False)
    97	    first_bad: int | None = None  # 1-based entry number; None when the log is intact
