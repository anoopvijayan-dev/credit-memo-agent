   134	            or not isinstance(obj["prev"], str) or not isinstance(obj["at"], str) \
   135	            or not isinstance(obj["event"], str) or not isinstance(obj["data"], dict):
   136	        return None, "has a field of the wrong type"
   137	    if entry_hash(obj) != hsh:
   138	        return None, "was changed: its hash does not match its content"
   139	    if seq != n:
