   230	    def drop_torn_entry(self, *, expected: int, by: str) -> Entry:
   231	        """Cut an incomplete last entry off and record who confirmed it. `expected` is the
   232	        intact position the person was shown. Refused if the last entry is not torn, or
   233	        if the chain is broken before it (that is tampering, not a torn write)."""
   234	        if not isinstance(by, str) or not by.strip():
   235	            raise ValueError("a name is required to drop a torn entry")
   236	        with self.writer():
   237	            check = self.verify()
   238	            if not check.torn:
   239	                if check.ok:
   240	                    raise CaseLogBroken(self.path, check.head.position + 1, "does not exist: nothing is torn", False)
   241	                raise CaseLogBroken(self.path, check.first_bad, check.reason, False)
   242	            if check.head.position != expected:
   243	                raise LogConflict(expected, check.head.position)
   244	            # Write the intact prefix plus the drop entry to a temporary file and rename it
   245	            # over the log, so a crash leaves either the torn log or the repaired one, never
   246	            # a truncated log with no record of who dropped the entry.
   247	            intact = self.path.read_bytes()[: check.intact_bytes]
   248	            entry, line = self._encode(TORN_DROPPED, {"seq": check.first_bad, "by": by.strip()}, check.head)
   249	            tmp = self.path.with_name(self.path.name + ".tmp")
   250	            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
   251	            try:
   252	                _write_all(fd, intact + line)
   253	                os.fsync(fd)
   254	            finally:
   255	                os.close(fd)
   256	            try:
   257	                os.replace(tmp, self.path)
   258	            except OSError:
   259	                tmp.unlink(missing_ok=True)
   260	                raise
   261	            _fsync_dir(self.path.parent)
   262	            return entry
   263	
   264	    @staticmethod
   265	    def _encode(event: str, data: dict[str, Any], head: Head) -> tuple[Entry, bytes]:
   266	        body = {"seq": head.position + 1, "prev": head.hash, "at": _utc_now(), "event": event, "data": data}
   267	        entry = Entry(**body, hash=entry_hash(body))
   268	        return entry, _canonical({**body, "hash": entry.hash}) + b"\n"
   269	
   270	    def _write(self, event: str, data: dict[str, Any], head: Head) -> Entry:
   271	        entry, line = self._encode(event, data, head)
   272	        created = not self.path.exists()
   273	        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
   274	        try:
   275	            _write_all(fd, line)
   276	            os.fsync(fd)
   277	        finally:
   278	            os.close(fd)
   279	        if created:
   280	            _fsync_dir(self.path.parent)  # make the new file's name durable too
   281	        return entry
   282	
   283	
   284	def _write_all(fd: int, data: bytes) -> None:
   285	    view = memoryview(data)
   286	    while view:  # one call in practice; loop on a short write
   287	        view = view[os.write(fd, view):]
   288	
   289	
   290	def _fsync_dir(path: Path) -> None:
   291	    if os.name == "nt":  # pragma: no cover - Windows cannot open a directory for fsync
   292	        return
   293	    fd = os.open(path, os.O_RDONLY)
   294	    try:
   295	        os.fsync(fd)
   296	    finally:
   297	        os.close(fd)
   298	
   299	
   300	if os.name == "nt":  # pragma: no cover - exercised on Windows only
   301	    import msvcrt
   302	
   303	    def _lock(fd: int) -> None:
   304	        msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
   305	
   306	    def _unlock(fd: int) -> None:
   307	        os.lseek(fd, 0, os.SEEK_SET)
   308	        msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
   309	
   310	else:
   311	    import fcntl
   312	
   313	    def _lock(fd: int) -> None:
   314	        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
   315	
   316	    def _unlock(fd: int) -> None:
   317	        fcntl.flock(fd, fcntl.LOCK_UN)
