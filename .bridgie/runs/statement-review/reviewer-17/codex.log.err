def _refuse_to_overwrite(out: Path | None) -> None:
    """Never replace an earlier memo or its evidence: the pair is the audit record."""
    if out is None:
        return
    taken = [p for p in _outputs(out) if p.exists()]
    if taken:
        console.print(f"[red]Refusing to overwrite {', '.join(map(str, taken))}. Choose another --out.[/red]")
        raise typer.Exit(code=2)


def _outputs(out: Path) -> list[Path]:
    rejected = out.with_name(out.stem + ".rejected.md")
    return [out, _evidence_path(out), rejected, _evidence_path(rejected)]


def _evidence_path(memo: Path) -> Path:
    return memo.with_name(memo.stem + ".evidence.json")


@contextmanager
def _checkpointer(path: Path | None):
    if path is None:
        yield None
        return
    try:
        with sqlite_checkpointer(path) as saver:
            yield saver
    except RuntimeError as e:
        console.print(f"[red]{e}[/red]")
        raise typer.Exit(code=2) from e


def _review(graph, cfg, state, reviewer, yes, out):
    interrupts = state.get("__interrupt__") or []
    if not interrupts:
        raise typer.Exit(code=1)
    payload = interrupts[0].value

    _print_metrics(state["metrics"])
    _print_policy(state["policy"])
    console.rule("Draft memo")
    console.print(Markdown(payload["memo"]))
    console.rule("Grounding check")
    grounded = payload["guard_grounded"]
    if grounded:
        console.print("[green]All figures trace to the metrics table or the policy.[/green]")
    else:
        console.print(f"[red]Unmatched numbers:[/red] {payload['guard_unmatched']}")
        if payload["guard_missing_citations"]:
            console.print(f"[red]Figures quoted without their tag:[/red] {payload['guard_missing_citations']}")

    if yes:
        if not grounded:
            console.print("[red]--yes will not approve a memo that failed the grounding check. Review it interactively.[/red]")
            raise typer.Exit(code=3)
        decision = {"approved": True, "reviewer": reviewer, "mode": "automated",
                    "notes": "Approved by script (--yes); the draft was not reviewed interactively."}
    else:
        decision = _ask(payload, grounded, reviewer)

    final = _decide(graph, cfg, decision)
    while "__interrupt__" in final:
        payload = final["__interrupt__"][0].value
        console.print(f"[red]Not accepted:[/red] {payload['error']}")
        if yes:
            raise typer.Exit(code=3)
        decision = _ask(payload, grounded, reviewer)
        final = _decide(graph, cfg, decision)

    approved = final["review"].approved
    if out:
        target = out if approved else out.with_name(out.stem + ".rejected.md")
        evidence = _evidence_path(target)
        target.write_text(final["final_memo"])
        evidence.write_text(json.dumps(evidence_record(final), indent=2, default=str))
        console.print(f"wrote {target} and {evidence}")
    if not approved:
        console.rule("Not approved")
        console.print(Markdown(final["final_memo"]))
        raise typer.Exit(code=1)
    if not out:
        console.rule("Final")
        console.print(Markdown(final["final_memo"]))


def _decide(graph, cfg, decision: dict) -> dict:
    """Resume with this decision, and make sure it is the one that was recorded.

    Two people can open the same pending review from a shared --checkpoint-db. If
    someone else decided first, resuming is a no-op that returns *their* decision; say
    so instead of reporting it as ours.
    """
    if not graph.get_state(cfg).interrupts:
        _decided_elsewhere(graph.get_state(cfg).values)
    final = graph.invoke(Command(resume=decision), cfg)
    review = final.get("review")
    if "__interrupt__" not in final and (
        review is None or review.reviewer != (decision.get("reviewer") or "").strip()
        or review.approved != decision.get("approved")
    ):
        _decided_elsewhere(final)
    return final


def _decided_elsewhere(values: dict) -> None:
    r = values.get("review")
    who = f"{r.reviewer} at {r.decided_at:%Y-%m-%d %H:%M UTC}" if r else "someone else"
    console.print(f"[red]This review was already decided by {who}. Your decision was not recorded.[/red]")
def safe_path(raw: str, suffixes: tuple[str, ...]) -> Path:
    """Resolve `raw` inside the data directory, or refuse."""
    root = data_dir()
    p = Path(raw)
    p = (p if p.is_absolute() else root / p).resolve()
    if not p.is_relative_to(root):
        raise ValueError(f"{raw}: outside the data directory {root} (set CMA_DATA_DIR)")
    if p.suffix.lower() not in suffixes:
        raise ValueError(f"{raw}: only {', '.join(suffixes)} files can be read")
    if not p.is_file():
        raise ValueError(f"{raw}: no such file")
    return p


def _statement(path: str):
    p = safe_path(path, (".csv",))
    try:
        return ingest.load_csv(p)
    except ingest.StatementError as e:
        lines = sorted({x.split(":", 1)[0] for x in e.problems})
        raise ValueError(f"{path}: statement refused, {len(e.problems)} problem(s) on {', '.join(lines[:10])}; "
                         "run `cma run` locally to see them") from None


@server.tool()
def statement_summary(path: str) -> dict:
    """Load a statement CSV and return account name, period and transaction count."""
    s = _statement(path)
    return {
        "account_name": s.account_name,
        "start": s.start.isoformat(),
        "end": s.end.isoformat(),
        "transactions": len(s.transactions),
    }


@server.tool()
def compute_metrics(path: str, vat_stagger: int | None = None) -> list[dict]:
    """Categorise a statement and compute the cited metrics table (M1..M16).
    vat_stagger is the HMRC stagger group (1, 2 or 3); without it M13 is n/a."""
    s = categorise.categorise(_statement(path))
    return [m.model_dump() for m in metrics.compute(s, vat_stagger=vat_stagger)]


@server.tool()
def check_policy(path: str, policy_path: str | None = None, vat_stagger: int | None = None) -> dict:
    """Run the lending policy against a statement and return pass/refer/fail per rule."""
    s = categorise.categorise(_statement(path))
    p = policy.load_policy(safe_path(policy_path, (".yaml", ".yml"))) if policy_path else None
    return policy.evaluate(metrics.compute(s, vat_stagger=vat_stagger), p).model_dump()


@server.tool()
def transactions_for(path: str, ids: list[str], include_descriptions: bool = False) -> list[dict]:
    """Return the statement lines behind a metric's evidence ids, so a reviewer can check a
    figure. Descriptions are payer-written text; they are only included when asked for,
    and then under `untrusted_description`."""
    by_id = _statement(path).by_id()
    out = []
    for i in ids:
        if i not in by_id:
            continue
        t = by_id[i]
        row = {"id": t.id, "date": t.date.isoformat(), "amount": t.amount, "balance": t.balance,
               "category": t.category.value if t.category else None}
        if include_descriptions:
            row["untrusted_description"] = t.description
        out.append(row)
    return out


def evidence_record(s: MemoState) -> dict:
    """Everything needed to audit the memo later, as plain JSON."""
    return {
        "schema_version": EVIDENCE_SCHEMA_VERSION,
        "statement": {"path": s["statement_path"], "sha256": s.get("statement_sha256"),
                      "start": str(s["statement"].start), "end": str(s["statement"].end),
                      "transactions": len(s["statement"].transactions)},
        "model": s.get("model"),
        "vat_stagger": s.get("vat_stagger"),
        "metrics": [m.model_dump() for m in s["metrics"]],
        "policy": s["policy"].model_dump(mode="json"),
        "guard": {**s["guard"].model_dump(), "grounded": s["guard"].grounded},
        "redrafts": s.get("redrafts", 0),
        "review": s["review"].model_dump(mode="json") if s.get("review") else None,
        "memo": s.get("memo"),
    }


