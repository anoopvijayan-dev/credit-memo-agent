+    monkeypatch.setattr(case, "_write_all", then_replace_the_lock)
+    with pytest.raises(case.CaseLocked, match="replaced"):
+        log.drop_torn_entry(expected=2, by="A. Underwriter")
+    monkeypatch.undo()
