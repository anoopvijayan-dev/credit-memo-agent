   102	    out: Path | None = typer.Option(None, help="As for `cma run`."),
   103	):
   104	    """Pick up a memo that is waiting for review, after a restart."""
   105	    if not checkpoint_db.exists():
   106	        console.print(f"[red]{checkpoint_db} does not exist.[/red]")
   107	        raise typer.Exit(code=2)
   108	    _refuse_to_overwrite(out)
