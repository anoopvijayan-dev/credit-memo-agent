   123	
   124	def _stored_state_problem(values: dict) -> str | None:
   125	    """A stored review is only resumed if it still says what it said: the statement file
   126	    is unchanged and the stored memo still passes (or fails) the guard the same way."""
   127	    path = Path(values["statement_path"])
   128	    if not path.is_file():
   129	        return f"the statement {path} is no longer there"
   130	    if hashlib.sha256(path.read_bytes()).hexdigest() != values.get("statement_sha256"):
   131	        return f"the statement {path} has changed since the memo was drafted"
   132	    again = grd.check(values["memo"], values["metrics"], values["policy"], required_headings=grd.REQUIRED_HEADINGS)
   133	    if again.grounded != values["guard"].grounded:
   134	        return "the stored grounding result does not match the stored memo"
   135	    return None
   136	
   137	
   138	def _refuse_to_overwrite(out: Path | None) -> None:
   139	    """Never replace an earlier memo or its evidence: the pair is the audit record."""
   140	    if out is None:
   141	        return
   142	    taken = [p for p in _outputs(out) if p.exists()]
   143	    if taken:
   144	        console.print(f"[red]Refusing to overwrite {', '.join(map(str, taken))}. Choose another --out.[/red]")
   145	        raise typer.Exit(code=2)
   146	
   147	
   148	def _outputs(out: Path) -> list[Path]:
   149	    rejected = out.with_name(out.stem + ".rejected.md")
   150	    return [out, _evidence_path(out), rejected, _evidence_path(rejected)]
   151	
   152	
   153	def _evidence_path(memo: Path) -> Path:
   154	    return memo.with_name(memo.stem + ".evidence.json")
   155	
   156	
   157	@contextmanager
   158	def _checkpointer(path: Path | None):
   159	    if path is None:
   160	        yield None
   161	        return
   162	    try:
   163	        with sqlite_checkpointer(path) as saver:
   164	            yield saver
   165	    except RuntimeError as e:
   166	        console.print(f"[red]{e}[/red]")
   167	        raise typer.Exit(code=2) from e
   168	
   169	
   170	def _review(graph, cfg, state, reviewer, yes, out):
   171	    interrupts = state.get("__interrupt__") or []
   172	    if not interrupts:
   173	        raise typer.Exit(code=1)
   174	    payload = interrupts[0].value
   175	
   176	    _print_metrics(state["metrics"])
   177	    _print_policy(state["policy"])
   178	    console.rule("Draft memo")
   179	    console.print(Markdown(payload["memo"]))
   180	    console.rule("Grounding check")
   181	    grounded = payload["guard_grounded"]
   182	    if grounded:
   183	        console.print("[green]All figures trace to the metrics table or the policy.[/green]")
   184	    else:
   185	        console.print(f"[red]Unmatched numbers:[/red] {payload['guard_unmatched']}")
   186	        if payload["guard_missing_citations"]:
   187	            console.print(f"[red]Figures quoted without their tag:[/red] {payload['guard_missing_citations']}")
   188	
   189	    if yes:
   190	        if not grounded:
   191	            console.print("[red]--yes will not approve a memo that failed the grounding check. Review it interactively.[/red]")
   192	            raise typer.Exit(code=3)
   193	        decision = {"approved": True, "reviewer": reviewer, "mode": "automated",
   194	                    "notes": "Approved by script (--yes); the draft was not reviewed interactively."}
   195	    else:
   196	        decision = _ask(payload, grounded, reviewer)
   197	
   198	    final = _decide(graph, cfg, decision)
   199	    while "__interrupt__" in final:
   200	        payload = final["__interrupt__"][0].value
   201	        console.print(f"[red]Not accepted:[/red] {payload['error']}")
   202	        if yes:
   203	            raise typer.Exit(code=3)
   204	        decision = _ask(payload, grounded, reviewer)
   205	        final = _decide(graph, cfg, decision)
   206	
   207	    approved = final["review"].approved
   208	    if out:
   209	        target = out if approved else out.with_name(out.stem + ".rejected.md")
   210	        evidence = _evidence_path(target)
   211	        target.write_text(final["final_memo"])
   212	        evidence.write_text(json.dumps(evidence_record(final), indent=2, default=str))
   213	        console.print(f"wrote {target} and {evidence}")
   214	    if not approved:
   215	        console.rule("Not approved")
   216	        console.print(Markdown(final["final_memo"]))
   217	        raise typer.Exit(code=1)
   218	    if not out:
   219	        console.rule("Final")
   220	        console.print(Markdown(final["final_memo"]))
