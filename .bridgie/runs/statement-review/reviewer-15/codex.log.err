    55	    except ingest.StatementError as e:
    56	        lines = sorted({x.split(":", 1)[0] for x in e.problems})
    57	        raise ValueError(f"{path}: statement refused, {len(e.problems)} problem(s) on {', '.join(lines[:10])}; "
    58	                         "run `cma run` locally to see them") from None
