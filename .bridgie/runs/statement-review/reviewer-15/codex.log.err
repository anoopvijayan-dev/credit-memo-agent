   112	        snap = graph.get_state(cfg)
   113	        if not snap.interrupts:
   114	            console.print(f"[red]Nothing is waiting for review under {thread}.[/red]")
   115	            raise typer.Exit(code=1)
   116	        problem = _stored_state_problem(snap.values)
   117	        if problem:
   118	            console.print(f"[red]Not resuming {thread}:[/red] {problem}")
   119	            raise typer.Exit(code=2)
   120	        state = {**snap.values, "__interrupt__": snap.interrupts}
   121	        _review(graph, cfg, state, reviewer, False, out)
