   282	@import_app.command("monzo")
   283	def import_monzo(
   284	    export: Path = typer.Argument(..., help="The CSV exported from the Monzo app."),
   285	    out: Path = typer.Option(..., "-o", "--out", help="Where to write the statement CSV. Keep it out of git."),
   286	    opening_balance: float | None = typer.Option(
   287	        None, help="Balance just before the first transaction. Needed when the export has no Balance column."
   288	    ),
   289	):
   290	    """Convert a Monzo export locally. Nothing is uploaded; the file stays on this machine."""
   291	    from .importers import monzo
   292	
   293	    try:
   294	        r = monzo.convert(export, out, opening_balance)
   295	    except monzo.MonzoImportError as e:
   296	        console.print(f"[red]Import refused.[/red] {e}")
   297	        raise typer.Exit(code=2) from e
   298	    console.print(
   299	        f"wrote {out}: {r.rows} transactions, {r.start} to {r.end}; "
   300	        f"opening £{r.opening_balance:,.2f}, closing £{r.closing_balance:,.2f} ({r.balance_source})"
   301	        + (f"; skipped {r.skipped_non_gbp} non-GBP rows" if r.skipped_non_gbp else "")
   302	    )
   303	    console.print("Check the closing balance against your Monzo app before trusting any metric.")
