   124	
   125	def _stored_state_problem(values: dict) -> str | None:
   126	    """A stored review is only resumed if it still says what it said: the statement file
   127	    is unchanged and the stored memo still passes (or fails) the guard the same way."""
   128	    path = Path(values["statement_path"])
   129	    if not path.is_file():
   130	        return f"the statement {path} is no longer there"
   131	    if hashlib.sha256(path.read_bytes()).hexdigest() != values.get("statement_sha256"):
   132	        return f"the statement {path} has changed since the memo was drafted"
   133	    again = grd.check(values["memo"], values["metrics"], values["policy"], required_headings=grd.REQUIRED_HEADINGS)
   134	    if again.grounded != values["guard"].grounded:
   135	        return "the stored grounding result does not match the stored memo"
   136	    return None
   137	
   138	
   139	def _refuse_to_overwrite(out: Path | None) -> None:
   140	    """Never replace an earlier memo or its evidence: the pair is the audit record."""
   141	    if out is None:
   142	        return
   143	    taken = [p for p in _outputs(out) if p.exists()]
   144	    if taken:
   145	        console.print(f"[red]Refusing to overwrite {', '.join(map(str, taken))}. Choose another --out.[/red]")
   146	        raise typer.Exit(code=2)
   147	
   148	
   149	def _outputs(out: Path) -> list[Path]:
   150	    rejected = out.with_name(out.stem + ".rejected.md")
   151	    return [out, _evidence_path(out), rejected, _evidence_path(rejected)]
   152	
   153	
   154	def _evidence_path(memo: Path) -> Path:
   155	    return memo.with_name(memo.stem + ".evidence.json")
   156	
   157	
   158	@contextmanager
   159	def _checkpointer(path: Path | None):
   160	    if path is None:
   161	        yield None
   162	        return
   163	    try:
   164	        with sqlite_checkpointer(path) as saver:
   165	            yield saver
   166	    except RuntimeError as e:
   167	        console.print(f"[red]{e}[/red]")
   168	        raise typer.Exit(code=2) from e
   169	
   170	
   171	def _review(graph, cfg, state, reviewer, yes, out):
   172	    interrupts = state.get("__interrupt__") or []
   173	    if not interrupts:
   174	        raise typer.Exit(code=1)
   175	    payload = interrupts[0].value
   176	    # Settle which rule table the evidence will name while the review is still pending. A
   177	    # review drafted by an older version has none stored, and naming it reads the packaged
   178	    # v1 table; if that fails after the decision is recorded, the memo has no evidence and
   179	    # the review can no longer be resumed. Refuse here instead, with nothing decided.
   180	    try:
   181	        ruleset = ruleset_used(state)
   182	    except RulesetError as e:
   183	        console.print(f"[red]Refused, nothing recorded.[/red] {e}")
   184	        raise typer.Exit(code=2) from e
   185	
   186	    _print_metrics(state["metrics"])
   187	    _print_policy(state["policy"])
   188	    console.rule("Draft memo")
   189	    console.print(Markdown(payload["memo"]))
   190	    console.rule("Grounding check")
   191	    grounded = payload["guard_grounded"]
   192	    if grounded:
   193	        console.print("[green]All figures trace to the metrics table or the policy.[/green]")
   194	    else:
   195	        console.print(f"[red]Unmatched numbers:[/red] {payload['guard_unmatched']}")
   196	        if payload["guard_missing_citations"]:
   197	            console.print(f"[red]Figures quoted without their tag:[/red] {payload['guard_missing_citations']}")
   198	
   199	    if yes:
   200	        if not grounded:
   201	            console.print("[red]--yes will not approve a memo that failed the grounding check. Review it interactively.[/red]")
   202	            raise typer.Exit(code=3)
   203	        decision = {"approved": True, "reviewer": reviewer, "mode": "automated",
   204	                    "notes": "Approved by script (--yes); the draft was not reviewed interactively."}
   205	    else:
   206	        decision = _ask(payload, grounded, reviewer)
   207	
   208	    final = _decide(graph, cfg, decision)
   209	    while "__interrupt__" in final:
   210	        payload = final["__interrupt__"][0].value
   211	        console.print(f"[red]Not accepted:[/red] {payload['error']}")
   212	        if yes:
   213	            raise typer.Exit(code=3)
   214	        decision = _ask(payload, grounded, reviewer)
   215	        final = _decide(graph, cfg, decision)
   216	
   217	    approved = final["review"].approved
   218	    if out:
   219	        target = out if approved else out.with_name(out.stem + ".rejected.md")
   220	        evidence = _evidence_path(target)
   221	        target.write_text(final["final_memo"])
   222	        evidence.write_text(json.dumps(evidence_record({**final, "ruleset": ruleset}), indent=2, default=str))
   223	        console.print(f"wrote {target} and {evidence}")
   224	    if not approved:
   225	        console.rule("Not approved")
