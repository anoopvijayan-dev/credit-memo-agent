   167	def ruleset_used(s: MemoState) -> dict:
   168	    """The categorisation table the memo's figures came from. A review drafted before the
   169	    table moved to data (a pending checkpoint from an older version) has none in its state;
   170	    its lines were categorised by the table now packaged as v1, frozen and compared with
   171	    the old code (tests/test_rules.py, P7), so it is named as v1 and marked as inferred,
   172	    never null. That lookup reads the packaged table and can raise RulesetError, so the
   173	    CLI calls this before a decision is recorded, not after."""
   174	    if s.get("ruleset"):
   175	        return s["ruleset"]
   176	    v1 = cat.load_ruleset("v1")
   177	    return {"id": v1.id, "sha256": v1.sha256, "inferred": "pre-ruleset checkpoint"}
