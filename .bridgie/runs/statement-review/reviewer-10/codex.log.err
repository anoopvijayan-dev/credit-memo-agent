    72	def validate_ruleset(data: object, expected_id: str, source: str = "rules") -> None:
    73	    if not isinstance(data, dict):
    74	        raise RulesetError(f"{source}: not a mapping")
    75	    problems: list[str] = []
    76	    if "id" not in data:
    77	        problems.append("missing id")
    78	    elif data["id"] != expected_id:
    79	        problems.append(f"id {data['id']!r} does not match the file ({expected_id!r})")
    80	    if not isinstance(data.get("frozen"), bool):
    81	        problems.append("frozen must be true or false")
    82	    for key in sorted(set(data) - TABLE_KEYS, key=repr):
    83	        problems.append(f"unknown key {key!r}")
    84	    rules = data.get("rules")
    85	    if not isinstance(rules, list) or not rules:
    86	        raise RulesetError(f"{source}: " + "; ".join([*problems, "no rules"]))
    87	    categories = {c.value for c in Category}
    88	    seen: set[str] = set()
    89	    for i, r in enumerate(rules, start=1):
    90	        where = f"rule {i} ({r.get('id', '?') if isinstance(r, dict) else '?'})"
    91	        if not isinstance(r, dict):
    92	            problems.append(f"{where}: not a mapping")
    93	            continue
    94	        for key in sorted(RULE_KEYS - set(r)):
    95	            problems.append(f"{where}: missing {key}")
    96	        for key in sorted(set(r) - RULE_KEYS, key=repr):
    97	            problems.append(f"{where}: unknown key {key!r}")
    98	        # Every field is a string. Checking the type first means a list, a mapping, a
    99	        # number or null is reported here, not raised later as a TypeError.
   100	        for key in sorted(RULE_KEYS & set(r)):
   101	            if not isinstance(r[key], str) or not r[key]:
   102	                problems.append(f"{where}: {key} {r[key]!r} is not a non-empty string")
   103	        if isinstance(r.get("id"), str):
   104	            if r["id"] in seen:
   105	                problems.append(f"{where}: duplicate id")
   106	            seen.add(r["id"])
   107	        if isinstance(r.get("direction"), str) and r["direction"] not in DIRECTIONS:
   108	            problems.append(f"{where}: direction {r['direction']!r} is not one of {list(DIRECTIONS)}")
   109	        if isinstance(r.get("category"), str) and r["category"] not in categories:
   110	            problems.append(f"{where}: category {r['category']!r} is not a category")
   111	        if isinstance(r.get("pattern"), str) and r["pattern"]:
   112	            # re.error is not the only way a pattern fails to compile: a repeat count past
   113	            # the engine's limit raises OverflowError, deep nesting RecursionError.
   114	            try:
   115	                re.compile(r["pattern"])
   116	            except (re.error, OverflowError, RecursionError, MemoryError) as e:
   117	                problems.append(f"{where}: pattern does not compile ({e.__class__.__name__}: {e})")
   118	    if problems:
   119	        raise RulesetError(f"{source}: " + "; ".join(problems))
   120	
   121	
   122	def ruleset_from_data(data: object, expected_id: str, source: str, sha256: str) -> Ruleset:
   123	    validate_ruleset(data, expected_id, source)
   124	    assert isinstance(data, dict)
   125	    return Ruleset(
   126	        id=data["id"],
   127	        sha256=sha256,
   128	        rules=tuple(
   129	            Rule(r["id"], re.compile(r["pattern"]), r["direction"], Category(r["category"]))
   130	            for r in data["rules"]
   131	        ),
   132	    )
   133	
   134	
   135	class _UniqueKeyLoader(yaml.SafeLoader):
   136	    """safe_load keeps the last of two equal keys, so a second `category:` inside a rule
   137	    would silently change it with nothing left for the validator to see. Refuse instead."""
   138	
   139	    def construct_mapping(self, node, deep=False):
   140	        seen: set = set()
   141	        for key_node, _ in node.value:
   142	            key = self.construct_object(key_node, deep=deep)
   143	            try:
   144	                duplicate = key in seen
   145	            except TypeError:  # an unhashable key; the base class reports it
   146	                continue
   147	            if duplicate:
   148	                raise yaml.constructor.ConstructorError(
   149	                    "while constructing a mapping", node.start_mark,
   150	                    f"found duplicate key {key!r}", key_node.start_mark)
   151	            seen.add(key)
   152	        return super().construct_mapping(node, deep=deep)
   153	
   154	
   155	def _table_bytes(ruleset_id: str) -> bytes:
   156	    return resources.files("cma.rules").joinpath(f"{ruleset_id}.yaml").read_bytes()
   157	
   158	
   159	@lru_cache
   160	def load_ruleset(ruleset_id: str) -> Ruleset:
   161	    """A packaged table by id. Only ids in RULESETS load, so an id never names a path."""
   162	    if ruleset_id not in RULESETS:
   163	        raise RulesetError(f"unknown ruleset {ruleset_id!r}; known: {', '.join(RULESETS)}")
   164	    source = f"cma/rules/{ruleset_id}.yaml"
   165	    try:
   166	        raw = _table_bytes(ruleset_id)
   167	    except (OSError, ImportError) as e:  # ImportError: the cma.rules package itself is gone
   168	        raise RulesetError(f"{source}: cannot be read from the installed package ({e.__class__.__name__})") from e
   169	    try:
   170	        data = yaml.load(raw.decode("utf-8"), Loader=_UniqueKeyLoader)
   171	    except UnicodeDecodeError as e:
   172	        raise RulesetError(f"{source}: not UTF-8 text") from e
   173	    except yaml.YAMLError as e:
   174	        problem = getattr(e, "problem", None) or e.__class__.__name__
   175	        raise RulesetError(f"{source}: not valid YAML ({problem})") from e
   176	    except RecursionError as e:
   177	        raise RulesetError(f"{source}: not valid YAML (nested too deeply)") from e
   178	    # The hash is of the file's bytes as installed, so it matches sha256sum on that file.
   179	    return ruleset_from_data(data, ruleset_id, source, hashlib.sha256(raw).hexdigest())
   180	
   181	
   182	def active_ruleset() -> Ruleset:
   183	    """The table CMA_RULESET names, or the default when it is unset."""
   184	    chosen = os.environ.get(RULESET_ENV) or DEFAULT_RULESET
   185	    try:
   186	        return load_ruleset(chosen)
   187	    except RulesetError as e:
   188	        raise RulesetError(f"{RULESET_ENV}={chosen!r}: {e}") from e
   189	
   190	
