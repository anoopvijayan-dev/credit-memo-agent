+
 from .models import Category, Statement, Transaction
 
 Direction = Literal["in", "out", "any"]
 
 INVOICE_REF = re.compile(r"\bINV(?:OICE)?\s*[-#:]?\s*\d+")
-# Money in that is never trading income, whatever reference it carries.
