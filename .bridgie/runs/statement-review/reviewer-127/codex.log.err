  1410	
  1411	OUTGOING_TRANSFER = re.compile(r"^(?:FPS DEBIT|BACS DEBIT|TFR)\b")
  1412	
  1413	
  1414	def unmark_round_trips(statement: Statement, ruleset_id: str | None = None, *,
  1415	                       overridden: Collection[str] = ()) -> Statement:
  1416	    """A "customer" the applicant also sends transfers to is not counted as revenue.
  1417	
  1418	    Money sent out by transfer and received back with an invoice reference is the
  1419	    cheapest way to manufacture revenue. Such credits become OTHER (and so show in M16).
  1420	    This also catches a genuine customer who is paid a refund by transfer: the cost is
  1421	    understated revenue, which a person can add back; the alternative is gameable.
  1422	
  1423	    Only a category the built-in table set is undone: a person's override, a profile name
  1424	    or a firm rule ranks above the table and is left alone. Overridden lines are named by
  1425	    id (`overridden`), not inferred from their provenance text, which an override's own
  1426	    reference could imitate (T03 review 19).
  1427	    """
  1428	    overridden = set(overridden)
  1429	    paid_out = {counterparty(t.description) for t in statement.transactions
  1430	                if t.amount < 0 and OUTGOING_TRANSFER.search(t.description.upper())}
  1431	    for t in statement.transactions:
  1432	        set_by_table = t.id not in overridden and (
  1433	            ruleset_id is None or (t.rule_id or "").startswith(f"{ruleset_id}:"))
  1434	        if t.category == Category.REVENUE_TRANSFER and counterparty(t.description) in paid_out and set_by_table:
  1435	            t.category = Category.OTHER
  1436	            if ruleset_id is not None:
  1437	                t.rule_id = f"{ruleset_id}:round_trip"
  1438	    return statement
  1439	
  1440	
  1441	def categorise(
  1442	    statement: Statement,
  1443	    ruleset: Ruleset | None = None,
  1444	    *,
  1445	    overrides: Mapping[str, LineOverride] | None = None,
  1446	    profile: ProfileNames | None = None,
  1447	    firm_rules: Sequence[Rule] = (),
  1448	) -> Statement:
  1449	    ruleset = ruleset or active_ruleset()
  1450	    overrides = overrides or {}
  1451	    for t in statement.transactions:
  1452	        t.category, t.rule_id = classify(t, ruleset, override=overrides.get(t.id), profile=profile,
  1453	                                         firm_rules=firm_rules)
  1454	        t.reverses = None
  1455	    return link_reversals(unmark_round_trips(statement, ruleset.id, overridden=overrides.keys()))
