      "proof_cmd": "git diff --stat 576e43d..HEAD -- . ':!tests/test_case_log.py' ':!src/cma/case.py' | tail -1; python -m pytest -q; python evals/run_evals.py",
      "proof_output": "(no other files changed); 373 passed in 10.61s; 9/9 memos fully grounded; model = fake"
    },
    {
      "text": "Data / PII: entry data can hold case details. The log, lock and head files are created mode 0600. Error messages name entries by number only and never quote their content.",
      "proof_cmd": "python -m pytest -q tests/test_case_log.py -k 'private or holds_no_entry_content'",
