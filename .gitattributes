# The packaged rule tables are pinned by the SHA-256 of their bytes (FROZEN_SHA256 in
# src/cma/categorise.py). Keep them LF on every checkout, including Windows with
# core.autocrlf=true, or the pin refuses an unmodified table.
src/cma/rules/*.yaml text eol=lf

# The Monzo golden files are compared byte for byte, CRLF line ends included (T28).
tests/golden/monzo/* -text
# So are the Open Banking golden files (T29).
tests/golden/openbanking/* -text
# So are the TrueLayer golden files (T30).
tests/golden/truelayer/* -text
# So are the bank CSV golden files (T31).
tests/golden/bank_csv/* -text
